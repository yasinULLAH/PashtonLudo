<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport"/>
<title>Bannu Royale Ludo — Pashtun Cultural &amp; Classic Yalla Rules</title>
<meta content="Bannu Royale Ludo — authentic Pashtun 2-dice cultural rules and classic Yalla Ludo, with offline PWA support, LAN/QR multiplayer and AI opponents." name="description"/>
<meta content="Yasin Ullah" name="author"/>
<meta content="Yasin Ullah (Bannu Software Solutions)" name="developer"/>
<meta content="Dedicated to Muhib Ullah, the author's little brother" name="dedication"/>
<meta content="© 2026 Yasin Ullah — Bannu Software Solutions. All Rights Reserved." name="copyright"/>
<meta content="Proprietary — All Rights Reserved. Copying, modification, reuse, redistribution and derivative works are strictly prohibited without the prior written permission of the author, Yasin Ullah. See LICENSE." name="license"/>
<meta content="noarchive, nosnippet" name="robots"/>
<meta content="noai, noimageai" name="ai-content-declaration"/>
<script src="https://cdn.tailwindcss.com/3.4.17"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/jsqr@1.4.0/dist/jsQR.js"></script>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&amp;family=Noto+Nastaliq+Urdu:wght@400;600;700&amp;display=swap" rel="stylesheet"/>
<style>
    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }
    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100dvh;
      overflow: hidden;
      font-family: 'UrduCalibri', 'Inter', system-ui, -apple-system, sans-serif;
      background: radial-gradient(circle at 50% 0%, #fffbeb 0%, #fef3c7 52%, #fde68a 100%);
      color: #1e293b;
    }
    @font-face {
      font-family: 'UrduCalibri';
      src: local('Calibri'), local('Calibri Regular'), local('Calibri Bold');
      unicode-range: U+0600-06FF, U+0750-077F, U+08A0-08FF, U+FB50-FDFF, U+FE70-FEFF;
    }
    .font-calibri {
      font-family: 'Calibri', sans-serif !important;
    }
    button, select {
      white-space: nowrap;
      touch-action: manipulation;
    }
    @media (min-width: 820px) {
      label {
        white-space: nowrap;
      }
    }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: rgba(251, 191, 36, 0.1); }
    ::-webkit-scrollbar-thumb { background: rgba(217, 119, 6, 0.35); border-radius: 9999px; }

    @keyframes diceBounceSlot3D {
      0% { transform: translateY(0px) scale(1); }
      30% { transform: translateY(-7px) scale(1.14); }
      60% { transform: translateY(-3px) scale(1.08); }
      85% { transform: translateY(-5px) scale(1.11); }
      100% { transform: translateY(0px) scale(1); }
    }
    .dice-rolling {
      animation: diceBounceSlot3D 0.42s cubic-bezier(0.34, 1.56, 0.64, 1) infinite;
    }
    /* ==================== TRUE 6-FACE 3D CSS DICE CUBE (FULL CLEAR FRONT FACE) ==================== */
    .die-3d-scene {
      width: 30px;
      height: 30px;
      perspective: 520px;
      display: flex;
      align-items: center;
      justify-content: center;
      --cube-size: 28px;
      --cube-half: 14px;
    }
    .die-3d-cube {
      width: var(--cube-size);
      height: var(--cube-size);
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.48s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }
    .die-3d-cube.is-tumbling-3d {
      transition: transform 0.40s cubic-bezier(0.36, 0.07, 0.19, 0.97);
    }
    .die-3d-face {
      position: absolute;
      top: 0;
      left: 0;
      width: var(--cube-size);
      height: var(--cube-size);
      border-radius: 6px;
      background: linear-gradient(145deg, #ffffff 0%, #f8fafc 72%, #e2e8f0 100%);
      border: 1.8px solid #cbd5e1;
      box-shadow: inset 0 0 3px rgba(15, 23, 42, 0.18);
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: repeat(3, 1fr);
      padding: 3px;
      gap: 2px;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      box-sizing: border-box;
    }
    .die-3d-face.active-landed-face {
      border-color: #f59e0b;
      background: linear-gradient(145deg, #ffffff 0%, #fffbeb 80%, #fef3c7 100%);
      box-shadow: 0 2px 8px rgba(245, 158, 11, 0.45), inset 0 0 2px rgba(217, 119, 6, 0.35);
    }
    .die-3d-cube.die-used-dim .die-3d-face {
      background: linear-gradient(145deg, #f1f5f9 0%, #e2e8f0 100%);
      opacity: 0.42;
    }
    .die-3d-face-1 { transform: rotateY(0deg) translateZ(var(--cube-half)); }
    .die-3d-face-6 { transform: rotateY(180deg) translateZ(var(--cube-half)); }
    .die-3d-face-2 { transform: rotateY(90deg) translateZ(var(--cube-half)); }
    .die-3d-face-5 { transform: rotateY(-90deg) translateZ(var(--cube-half)); }
    .die-3d-face-3 { transform: rotateX(90deg) translateZ(var(--cube-half)); }
    .die-3d-face-4 { transform: rotateX(-90deg) translateZ(var(--cube-half)); }
    .die-3d-pip {
      width: 100%;
      height: 100%;
      border-radius: 9999px;
      box-shadow: inset 0 1px 1.5px rgba(0, 0, 0, 0.6);
    }
    .die-3d-pip.pip-red {
      background: radial-gradient(circle at 35% 35%, #fb7185 0%, #e11d48 65%, #9f1239 100%);
    }
    .die-3d-pip.pip-dark {
      background: radial-gradient(circle at 35% 35%, #334155 0%, #0f172a 75%, #020617 100%);
    }
    .die-3d-face-1 .die-3d-pip.pip-red {
      transform: scale(1.38);
    }
    #dieStatus0, #dieStatus1 {
      bottom: -5px !important;
      z-index: 25;
      pointer-events: none;
      font-size: 7.5px !important;
      line-height: 1.1;
      padding: 0 3px !important;
    }

    @keyframes pulseRing {
      0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.85), 0 0 18px rgba(245, 158, 11, 0.45); }
      70% { box-shadow: 0 0 0 10px rgba(245, 158, 11, 0), 0 0 24px rgba(245, 158, 11, 0.65); }
      100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0), 0 0 18px rgba(245, 158, 11, 0.45); }
    }
    .active-turn-glow {
      animation: pulseRing 1.35s infinite;
      border-color: #f59e0b !important;
      background: linear-gradient(135deg, #ffffff 0%, #fffbeb 100%) !important;
    }

    @keyframes radarSweep {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }
    .radar-sweep {
      background: conic-gradient(from 0deg, rgba(16, 185, 129, 0.35) 0deg, rgba(16, 185, 129, 0.0) 95deg, transparent 360deg);
      animation: radarSweep 3.8s linear infinite;
    }

    @keyframes floatBubble {
      0% { opacity: 0; transform: translateY(6px) scale(0.9); }
      15% { opacity: 1; transform: translateY(0px) scale(1); }
      85% { opacity: 1; transform: translateY(-3px) scale(1); }
      100% { opacity: 0; transform: translateY(-10px) scale(0.95); }
    }
    .emote-bubble {
      animation: floatBubble 2.5s ease-out forwards;
      pointer-events: none;
    }

    .royal-card {
      background: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(12px);
      border: 1px solid rgba(217, 119, 6, 0.25);
      box-shadow: 0 8px 20px -4px rgba(180, 83, 9, 0.08);
    }
    .gold-gradient-btn {
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
      color: #ffffff;
      box-shadow: 0 4px 12px rgba(217, 119, 6, 0.35), inset 0 1px 0 rgba(255,255,255,0.4);
    }
    .gold-gradient-btn:hover { filter: brightness(1.06); }
    .gold-gradient-btn:active { transform: translateY(1px); }

    .emerald-play-btn {
      background: linear-gradient(135deg, #10b981 0%, #059669 100%);
      color: #ffffff;
      box-shadow: 0 6px 20px rgba(5, 150, 105, 0.4), inset 0 1px 0 rgba(255,255,255,0.4);
    }
    .emerald-play-btn:hover { filter: brightness(1.06); }
    .emerald-play-btn:active { transform: translateY(1px); }

    /* Native Offline-Safe Layout & Zero-Scrollbar Rules */
    .hidden { display: none !important; }
    .fixed { position: fixed; }
    .inset-0 { top: 0; right: 0; bottom: 0; left: 0; }
    .z-50 { z-index: 50; }
    .flex { display: flex; }
    .flex-col { flex-direction: column; }
    .items-center { align-items: center; }
    .justify-center { justify-content: center; }
    .fixed { position: fixed; }
    .inset-0 { top: 0; right: 0; bottom: 0; left: 0; }
    .z-50 { z-index: 50; }
    .flex { display: flex; }
    .items-center { align-items: center; }
    .justify-center { justify-content: center; }
    #viewHome, #viewRules, #viewNetwork, #viewStats, #viewGuide {
      height: 100dvh;
      max-height: 100dvh;
      overflow-y: auto;
      box-sizing: border-box;
    }

    /* ADAPTIVE FULL-BLEED GAMEPLAY ARENA: Fills 100% of available height & width with zero wasted empty space */
    #viewPlay {
      width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      overflow: hidden !important;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      justify-content: space-between;
      padding: 3px 4px;
      gap: 4px;
      box-sizing: border-box;
    }
    #viewPlay.hidden {
      display: none !important;
    }
    #playTopRow {
      width: 100%;
      max-width: 100%;
      height: 46px;
      flex: 0 0 46px;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 6px;
      align-items: center;
    }
    #playBoardRow {
      flex: 1 1 0%;
      min-height: 0;
      min-width: 0;
      width: 100%;
      height: 100%;
      display: flex;
      align-items: stretch;
      justify-content: stretch;
      overflow: hidden;
      padding: 0;
    }
    /* Full-Bleed Board Sizing: Stretches to fill 100% of #playBoardRow width AND height with 0 empty space */
    #boardContainer {
      width: 100% !important;
      height: 100% !important;
      max-width: 100% !important;
      max-height: 100% !important;
      flex: 1 1 0%;
      padding: 4px;
      border-radius: 14px;
      background: linear-gradient(135deg, #f59e0b 0%, #d97706 50%, #b45309 100%);
      box-shadow: 0 10px 26px rgba(180, 83, 9, 0.25);
      border: 2px solid #fcd34d;
      display: flex;
      align-items: stretch;
      justify-content: stretch;
      box-sizing: border-box;
    }
    #ludoCanvas {
      width: 100% !important;
      height: 100% !important;
      max-width: 100%;
      max-height: 100%;
      display: block;
      border-radius: 10px;
      background: #ffffff;
      touch-action: none;
      cursor: grab;
    }
    #ludoCanvas:active {
      cursor: grabbing;
    }
    #playBottomRow {
      width: 100%;
      max-width: 100%;
      height: 54px;
      flex: 0 0 54px;
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 6px;
      align-items: center;
    }

    /* DESKTOP SIDE-BY-SIDE FULL-BLEED LAYOUT: Left Wing + Giant Full-Screen Center Board + Right Wing (Zero Empty Space!) */
    @media (min-width: 820px) {
      #viewPlay {
        display: grid !important;
        grid-template-columns: 196px minmax(0, 1fr) 196px !important;
        grid-template-rows: auto 1fr auto !important;
        grid-template-areas:
          "p0     board p1"
          "topbar board dice"
          "p3     board p2" !important;
        align-items: stretch !important;
        gap: 8px !important;
        padding: 6px 8px !important;
      }
      #playTopRow,
      #playBottomRow {
        display: contents !important;
      }
      #playTopRow > div,
      #playBottomRow > div {
        width: 100%;
        height: auto !important;
        padding: 9px !important;
      }
      #playerCard0 { grid-area: p0; align-self: start; }
      #playerCard1 { grid-area: p1; align-self: start; }
      #playActionToolbar { grid-area: topbar; align-self: center; }
      #playBoardRow {
        grid-area: board;
        width: 100% !important;
        height: 100% !important;
        padding: 0 !important;
      }
      #boardContainer {
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
      }
      #centerDiceDock {
        grid-area: dice;
        align-self: center;
        flex-direction: column !important;
        padding: 10px !important;
        gap: 8px !important;
      }
      #playerCard3 { grid-area: p3; align-self: end; }
      #playerCard2 { grid-area: p2; align-self: end; }
    }

    /* IMMERSIVE BOARD-ONLY MODE (100vw x 100dvh Full-Bleed Board, ZERO empty space on Mobile & Desktop!) */
    body.immersive-board-only #playTopRow,
    body.immersive-board-only #playBottomRow {
      display: none !important;
    }
    body.immersive-board-only #viewPlay {
      display: flex !important;
      flex-direction: column !important;
      padding: 2px !important;
      gap: 0 !important;
      width: 100vw !important;
      height: 100dvh !important;
      justify-content: stretch !important;
      align-items: stretch !important;
    }
    body.immersive-board-only #playBoardRow {
      width: 100% !important;
      height: 100% !important;
      flex: 1 1 100% !important;
      padding: 0 !important;
    }
    body.immersive-board-only #boardContainer {
      width: 100% !important;
      height: 100% !important;
      max-width: none !important;
      max-height: none !important;
      border-radius: 10px !important;
      padding: 3px !important;
    }
    body.immersive-board-only #immersiveFloatingHud {
      display: flex !important;
    }

    .col-span-3 { grid-column: span 3 / span 3; }
    .col-span-4 { grid-column: span 4 / span 4; }
    .col-span-6 { grid-column: span 6 / span 6; }
    #playTopRow > div, #playBottomRow > div {
      max-height: 100%;
      overflow: hidden;
      box-sizing: border-box;
    }
    #centerDiceDock {
      overflow: visible !important;
    }
    #dieSlot0, #dieSlot1 {
      width: 44px;
      height: 44px;
      padding: 3px;
      box-sizing: border-box;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      overflow: visible !important;
      background: radial-gradient(circle at 30% 25%, #1e293b 0%, #0f172a 100%) !important;
      box-shadow: 0 5px 12px rgba(15, 23, 42, 0.35), inset 0 1px 1px rgba(255, 255, 255, 0.25) !important;
    }
    #dieFace0, #dieFace1 {
      width: 30px;
      height: 30px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 3px;
    }
    .bg-rose-600 { background-color: #e11d48; }
    .bg-slate-900 { background-color: #0f172a; }

    /* ==================== REACT NATIVE ANDROID GAME MOBILE UI & LAYOUT (< 820px) ==================== */
    #mobileAndroidBottomNav {
      display: none;
    }

    @media (max-width: 819px) {
      html, body {
        overflow-x: hidden !important;
        max-width: 100vw;
        background: radial-gradient(circle at 50% 0%, #fffbeb 0%, #fef3c7 48%, #fde68a 100%);
      }

      /* Tactile React Native Android Ripple / Spring Press Feel */
      button:active, select:active {
        transform: scale(0.96);
      }

      /* Non-play screens get smooth native scrolling + bottom space for Android Bottom Navigation Bar */
      #viewHome, #viewRules, #viewNetwork, #viewStats, #viewGuide {
        overflow-x: hidden !important;
        overflow-y: auto !important;
        -webkit-overflow-scrolling: touch;
        padding: 10px 10px 78px 10px !important;
        justify-content: flex-start !important;
        gap: 10px;
      }

      #viewHome *, #viewRules *, #viewNetwork *, #viewStats *, #viewGuide *,
      .fixed .royal-card * {
        min-width: 0;
      }

      #viewHome .royal-card, #viewRules .royal-card, #viewNetwork .royal-card,
      #viewStats .royal-card, #viewGuide .royal-card {
        max-width: 100% !important;
        width: 100% !important;
        overflow-x: hidden;
      }

      #viewHome button, #viewRules button, #viewNetwork button,
      #viewStats button:not(.dash-subtab-btn), #viewGuide button:not(.guide-cat-btn),
      .fixed .royal-card button {
        white-space: normal !important;
        word-break: break-word;
        line-height: 1.25;
        text-align: center;
        max-width: 100%;
      }

      #dashboardSubTabs, #guideCategoryTabs {
        max-width: 100%;
        width: 100%;
      }

      #dashboardSubTabs > button, #guideCategoryTabs > button {
        flex-shrink: 0;
        white-space: nowrap !important;
      }

      #viewHome > .my-auto {
        margin-top: 2px !important;
        margin-bottom: 4px !important;
        width: 100%;
      }

      /* Hide the 2x2 desktop bottom nav inside #viewHome on mobile because we have the fixed Android Bottom Tab Bar */
      #homeDesktopBottomNav {
        display: none !important;
      }

      /* Compact Mobile Typography, Buttons, Inputs & Cards (< 820px) */
      #homeTopBar {
        padding: 6px 10px !important;
        border-radius: 14px !important;
      }
      #homeTopBar .w-9 {
        width: 30px !important;
        height: 30px !important;
        font-size: 14px !important;
        border-radius: 9px !important;
      }
      #homePlayerName {
        font-size: 11.5px !important;
      }
      #homeQuickStats {
        font-size: 9.5px !important;
      }
      #langSelect, #soundToggleBtn, #fullscreenToggleBtn {
        height: 28px !important;
        min-height: 28px !important;
        font-size: 10px !important;
        border-radius: 8px !important;
      }
      #soundToggleBtn, #fullscreenToggleBtn {
        width: 28px !important;
      }
      #appMainTitle {
        font-size: 1.25rem !important;
        line-height: 1.2 !important;
      }
      #appSubTitle {
        font-size: 10.5px !important;
        line-height: 1.35 !important;
        margin-bottom: 6px !important;
      }
      #headerPresetBadge {
        font-size: 10px !important;
      }
      #viewHome .royal-card {
        padding: 10px 12px !important;
        border-radius: 18px !important;
      }
      #presetBannuQuickBtn, #presetYallaQuickBtn {
        padding: 6px 8px !important;
        font-size: 11px !important;
        border-radius: 11px !important;
      }
      #viewHome select, #viewHome input[type="number"],
      #viewRules select, #viewRules input[type="text"], #viewRules input[type="number"] {
        padding-top: 5px !important;
        padding-bottom: 5px !important;
        font-size: 11px !important;
        border-radius: 9px !important;
        min-height: 30px !important;
      }
      #startMatchHeroBtn {
        padding: 9px 14px !important;
        font-size: 13px !important;
        border-radius: 13px !important;
      }
      #pauseMenuModal .royal-card,
      #victoryModal .royal-card,
      #scenarioDrawer .royal-card,
      #refereeLogModal .royal-card,
      #captureChoiceModal .royal-card {
        padding: 12px 14px !important;
        border-radius: 20px !important;
      }
      #pauseMenuModal button,
      #victoryModal button {
        padding-top: 7px !important;
        padding-bottom: 7px !important;
        font-size: 11px !important;
        border-radius: 10px !important;
      }
      #quickEmoteDrawer {
        bottom: 54px !important;
        padding: 6px 8px !important;
        border-radius: 14px !important;
      }
      #quickEmoteDrawer .emote-send-btn {
        padding: 4px 8px !important;
        font-size: 10px !important;
        border-radius: 8px !important;
      }
      #immersiveFloatingHud {
        padding: 3px 6px !important;
        gap: 4px !important;
      }
      #immersiveFloatingHud button {
        padding: 3px 8px !important;
        font-size: 10px !important;
      }

      /* Fixed React Native Android Bottom Tab Navigation Bar */
      body:not(.in-play-mode) #mobileAndroidBottomNav {
        display: grid !important;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        height: 50px;
        padding: 3px 4px calc(3px + env(safe-area-inset-bottom, 0px)) 4px;
        background: rgba(15, 23, 42, 0.96);
        backdrop-filter: blur(16px);
        border-top: 1.5px solid rgba(245, 158, 11, 0.45);
        box-shadow: 0 -6px 18px rgba(15, 23, 42, 0.32);
        z-index: 45;
        align-items: center;
        gap: 2px;
      }

      .android-tab-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1px;
        height: 100%;
        border-radius: 10px;
        color: #94a3b8;
        font-size: 9px;
        font-weight: 800;
        transition: all 0.18s ease;
        position: relative;
      }
      .android-tab-btn .tab-icon {
        font-size: 14px;
        line-height: 1;
        padding: 1px 8px;
        border-radius: 9999px;
        transition: all 0.18s ease;
      }
      .android-tab-btn.active {
        color: #fbbf24;
      }
      .android-tab-btn.active .tab-icon {
        background: rgba(245, 158, 11, 0.22);
        transform: translateY(-1px);
      }

      #viewPlay {
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        grid-template-rows: 32px 38px minmax(0, 1fr) 38px 46px;
        grid-template-areas:
          "topbar topbar"
          "p0     p1"
          "board  board"
          "p3     p2"
          "dice   dice";
        gap: 2.5px 4px;
        padding: 2px 4px calc(2px + env(safe-area-inset-bottom, 0px)) 4px !important;
        width: 100vw;
        height: 100dvh;
        max-height: 100dvh;
        overflow: hidden !important;
        align-items: stretch;
      }
      #viewPlay.hidden {
        display: none !important;
      }

      #playTopRow,
      #playBottomRow {
        display: contents !important;
      }

      #playActionToolbar {
        grid-area: topbar;
        width: 100%;
        height: 32px !important;
        max-height: 32px !important;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
        border: 1.5px solid rgba(245, 158, 11, 0.55);
        border-radius: 10px;
        padding: 2px 5px !important;
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: center;
        justify-content: flex-start;
        gap: 4px;
        box-shadow: 0 3px 10px rgba(15, 23, 42, 0.24);
      }
      #playActionToolbar button {
        height: 24px;
        min-width: 26px;
        padding: 0 6px !important;
        border-radius: 7px !important;
        font-size: 10px !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      #playActionToolbar #toggleImmersivePlayBtn {
        margin-left: auto;
      }

      #playerCard0, #playerCard1, #playerCard2, #playerCard3 {
        height: 38px !important;
        max-height: 38px !important;
        padding: 2px 6px !important;
        border-radius: 9px !important;
        box-shadow: 0 2px 5px rgba(180, 83, 9, 0.12);
      }
      #playerCard0 span, #playerCard1 span, #playerCard2 span, #playerCard3 span {
        font-size: 9.5px !important;
        line-height: 1.1 !important;
      }
      #pTeamBadge0, #pTeamBadge1, #pTeamBadge2, #pTeamBadge3,
      #pStatusTag0, #pStatusTag1, #pStatusTag2, #pStatusTag3 {
        font-size: 7.5px !important;
        padding: 1px 4px !important;
      }
      #playerCard0 { grid-area: p0; }
      #playerCard1 { grid-area: p1; }
      #playerCard3 { grid-area: p3; }
      #playerCard2 { grid-area: p2; }

      #playBoardRow {
        grid-area: board;
        width: 100% !important;
        height: 100% !important;
        min-height: 0;
        padding: 0 !important;
        display: flex;
        align-items: stretch;
        justify-content: stretch;
      }

      /* Full-bleed board on mobile portrait: fills 100% width AND 100% height of the middle row with ZERO empty space */
      #boardContainer {
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
        padding: 2.5px !important;
        border-radius: 10px !important;
        box-shadow: 0 5px 14px rgba(180, 83, 9, 0.22) !important;
      }

      /* Full-width Android 3D Dice Controller Dock at bottom of screen */
      #centerDiceDock {
        grid-area: dice;
        width: 100%;
        height: 46px !important;
        max-height: 46px !important;
        padding: 3px 6px !important;
        border-radius: 11px !important;
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%) !important;
        border: 1.5px solid #f59e0b !important;
        box-shadow: 0 4px 12px rgba(15, 23, 42, 0.3) !important;
        display: flex !important;
        align-items: center;
        justify-content: space-between;
        gap: 5px !important;
      }
      #centerDiceDock #turnBannerText {
        color: #fde68a !important;
        font-size: 9px !important;
      }
      #centerDiceDock #turnCountdownBadge {
        color: #38bdf8 !important;
        font-size: 9px !important;
        font-weight: 900 !important;
      }
      #centerDiceDock #dieSlot0,
      #centerDiceDock #dieSlot1 {
        width: 34px !important;
        height: 34px !important;
        padding: 2.5px !important;
        border-radius: 8px !important;
      }
      #centerDiceDock #dieFace0,
      #centerDiceDock #dieFace1 {
        width: 24px !important;
        height: 24px !important;
        margin-bottom: 2px !important;
      }
      #centerDiceDock .die-3d-scene {
        width: 24px !important;
        height: 24px !important;
        --cube-size: 22px;
        --cube-half: 11px;
      }
      #centerDiceDock .die-3d-face {
        padding: 2.2px;
        gap: 1.5px;
        border-radius: 4.5px;
      }
      #centerDiceDock #dieStatus0,
      #centerDiceDock #dieStatus1 {
        font-size: 7px !important;
        padding: 0 3px !important;
      }
      #centerDiceDock #dicePlusDivider {
        height: 30px;
        padding: 1px 4px !important;
        border-radius: 7px !important;
      }
      #centerDiceDock #rollDiceBtn {
        height: 24px;
        font-size: 10.5px !important;
        padding: 0 6px !important;
        border-radius: 8px !important;
      }
      #centerDiceDock #toggleEmoteTrayBtn {
        width: 30px !important;
        height: 32px !important;
        border-radius: 8px !important;
        font-size: 12px !important;
      }
    }

    /* MOBILE LANDSCAPE MODE (e.g. rotated Android phone < 920px wide & <= 540px tall) */
    @media (max-width: 920px) and (orientation: landscape) and (max-height: 540px) {
      #viewPlay {
        display: grid !important;
        grid-template-columns: 148px minmax(0, 1fr) 158px !important;
        grid-template-rows: 1fr auto 1fr !important;
        grid-template-areas:
          "p0     board p1"
          "topbar board dice"
          "p3     board p2" !important;
        gap: 4px 6px !important;
        padding: 3px 5px !important;
      }
      #playTopRow,
      #playBottomRow {
        display: contents !important;
      }
      #boardContainer {
        width: 100% !important;
        height: 100% !important;
        max-width: none !important;
        max-height: none !important;
      }
      #playerCard0, #playerCard1, #playerCard2, #playerCard3 {
        height: 100% !important;
        max-height: none !important;
      }
      #centerDiceDock {
        height: 100% !important;
        max-height: none !important;
        padding: 4px 6px !important;
      }
      #centerDiceDock #dieSlot0,
      #centerDiceDock #dieSlot1 {
        width: 36px !important;
        height: 36px !important;
      }
    }

    /* ==================== FULL-SCREEN MOBILE-FIRST GAME REPLAY STUDIO ==================== */
    #playActionToolbar {
      overflow-x: auto !important;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    #playActionToolbar::-webkit-scrollbar {
      display: none;
    }
    #replayStudioModal {
      width: 100vw;
      height: 100dvh;
      max-height: 100dvh;
      overflow: hidden;
      background: radial-gradient(circle at 50% 0%, #0f172a 0%, #090d16 65%, #020617 100%);
      color: #f8fafc;
    }
    #replayTimelineSlider {
      -webkit-appearance: none;
      appearance: none;
      height: 7px;
      border-radius: 9999px;
      background: rgba(245, 158, 11, 0.25);
      outline: none;
    }
    #replayTimelineSlider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 9999px;
      background: #f59e0b;
      border: 2.5px solid #ffffff;
      box-shadow: 0 2px 8px rgba(245, 158, 11, 0.65);
      cursor: pointer;
    }
    #replayTimelineSlider::-moz-range-thumb {
      width: 18px;
      height: 18px;
      border-radius: 9999px;
      background: #f59e0b;
      border: 2.5px solid #ffffff;
      box-shadow: 0 2px 8px rgba(245, 158, 11, 0.65);
      cursor: pointer;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
<link href="manifest.json" rel="manifest"/><link href="favicon.ico" rel="icon" type="image/x-icon"/></head>
<body class="w-full h-dvh overflow-hidden flex flex-col selection:bg-amber-500 selection:text-white">
<!-- FLOATING MINI HUD FOR IMMERSIVE BOARD-ONLY MODE (Only shown when Immersive Mode is active!) -->
<div class="hidden fixed top-2 right-2 z-50 items-center gap-1.5 bg-white/90 backdrop-blur-md px-2.5 py-1.5 rounded-full shadow-xl border border-amber-400" id="immersiveFloatingHud">
<button class="px-2.5 py-1 rounded-full gold-gradient-btn font-black text-xs flex items-center gap-1" id="immersiveRollBtn" type="button">
<span>🎲</span><span id="immersiveRollLabel">Roll</span>
</button>
<button class="px-2.5 py-1 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center gap-1" id="exitImmersiveBtn" type="button">
<span>👁️</span><span>Exit Immersive</span>
</button>
</div>
<!-- ==================== SCREEN 0: TRADITIONAL HOME LOBBY / START SCREEN ==================== -->
<section class="w-full h-dvh overflow-y-auto flex flex-col justify-between p-3 sm:p-5 max-w-4xl mx-auto" id="viewHome">
<div class="w-full flex flex-nowrap items-center justify-between gap-2 bg-slate-900/95 backdrop-blur-md border-2 border-amber-400/70 rounded-2xl px-2.5 py-2 sm:px-4 sm:py-2.5 shadow-lg" id="homeTopBar">
<div class="flex items-center gap-2 min-w-0 flex-1">
<div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl bg-gradient-to-br from-amber-400 to-orange-600 flex items-center justify-center shadow-md text-white text-lg sm:text-xl flex-shrink-0 border border-amber-200">
          👑
        </div>
<div class="min-w-0 flex-1">
<div class="flex items-center gap-1.5 min-w-0">
<span class="font-black text-xs sm:text-base text-amber-300 truncate" id="homePlayerName">Bannu Champion</span>
<span class="px-1.5 py-0.5 text-[8px] sm:text-[10px] font-bold rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-400/40 truncate flex-shrink-0" id="networkResilienceBadge">
              🟢 Ready
            </span>
</div>
<div class="text-[10px] sm:text-[11px] font-bold text-slate-300 truncate mt-0.5">
<span id="homeQuickStats">🏆 0 Wins • ⚔️ 0 Kills</span>
</div>
</div>
</div>
<div class="flex items-center gap-1 sm:gap-1.5 flex-shrink-0">
<select aria-label="Language" class="h-8 sm:h-9 bg-slate-800 border border-amber-400/50 rounded-xl px-1.5 sm:px-2.5 text-[10px] sm:text-xs font-bold text-amber-200 cursor-pointer" id="langSelect">
<option value="en">EN / اردو</option>
<option value="ur">اردو</option>
<option value="ps">پښتو</option>
</select>
<button class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl bg-slate-800 hover:bg-slate-700 border border-amber-400/50 text-white flex items-center justify-center text-xs sm:text-sm transition shadow-sm" id="soundToggleBtn" title="Toggle Sound Effects" type="button">
          🔊
        </button>
<button class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl gold-gradient-btn font-bold text-xs flex items-center justify-center shadow-sm transition" id="fullscreenToggleBtn" title="Toggle Fullscreen" type="button">
          ⛶
        </button>
</div>
</div>
<!-- Center Hero & Instant Quick-Launch Card -->
<div class="my-auto py-2 flex flex-col items-center text-center">
<div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 border border-amber-300 text-amber-900 text-xs font-extrabold mb-1.5">
<span>🎲</span>
<span id="headerPresetBadge">بنوں روایتی رولز (Bannu Rules)</span>
</div>
<h1 class="text-2xl sm:text-4xl font-black tracking-tight text-slate-900" id="appMainTitle">
        Bannu Royale Ludo
      </h1>
<p class="text-xs sm:text-sm text-slate-600 max-w-md mt-0.5 mb-3" id="appSubTitle">
        Authentic Pashtun 2-Dice Cultural Rules &amp; Classic Yalla Ludo — Direct Drag &amp; Tap Board
      </p>
<!-- Auto-Saved Crash/Close Recovery Banner (Visible whenever an unfinished match is saved!) -->
<div class="hidden w-full max-w-xl mb-3 p-3 rounded-2xl bg-emerald-50 border-2 border-emerald-400 flex items-center justify-between gap-2 shadow-md" id="resumeSavedMatchBanner">
<div class="text-left">
<div class="text-xs font-black text-emerald-900">🔄 Unfinished Match Saved (ادھورا کھیل محفوظ ہے)</div>
<div class="text-[11px] text-emerald-700" id="resumeSavedMatchInfo">Disconnected or closed earlier? Resume from the exact turn!</div>
</div>
<button class="px-4 py-2 rounded-xl font-black text-xs emerald-play-btn" id="resumeSavedMatchBtn" type="button">
          ▶️ Resume Match
        </button>
</div>
<!-- Main Pre-Game Mode Picker Card -->
<div class="w-full max-w-xl royal-card rounded-3xl p-4 sm:p-5 border-2 border-amber-300 shadow-xl text-left space-y-3">
<!-- 1. Rulebook Preset Switch -->
<div>
<label class="block text-[11px] font-extrabold uppercase tracking-wider text-amber-800 mb-1.5">1. Select Rulebook (قوانین کا انتخاب)</label>
<div class="grid grid-cols-2 gap-2">
<button class="py-2.5 px-3 rounded-2xl text-xs sm:text-sm font-black border-2 transition flex items-center justify-center gap-1.5 bg-amber-500 border-amber-600 text-white shadow" id="presetBannuQuickBtn" type="button">
<span>🏔️</span><span>Bannu 2-Dice Rules</span>
</button>
<button class="py-2.5 px-3 rounded-2xl text-xs sm:text-sm font-bold border-2 transition flex items-center justify-center gap-1.5 bg-white border-amber-200 text-slate-700 hover:bg-amber-50" id="presetYallaQuickBtn" type="button">
<span>🌐</span><span>Yalla 1-Die Classic</span>
</button>
</div>
</div>
<!-- 2. Match Mode, AI Intelligence, Bead Count, Kill Mode & Turn Timer Row -->
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-2">
<div>
<label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Match Format</label>
<select class="w-full bg-amber-50/90 border border-amber-300 rounded-xl px-2 py-1.5 text-xs font-bold text-slate-900" id="homeQuickFormatSelect">
<option selected="" value="2v2_ai">🤝 2v2 Teams (vs AI)</option>
<option value="1v1_ai">⚔️ 1v1 Duel (vs AI)</option>
<option value="3p_ai">👥 3-Player FFA (vs AI)</option>
<option value="4p_ai">👑 4-Player FFA (vs AI)</option>
<option value="ai_2p">🤖 AI vs AI: 2-Player (1v1)</option>
<option value="ai_3p">🤖 AI vs AI: 3-Player (FFA)</option>
<option value="ai_vs_ai">🤖 AI vs AI: 4P (2v2 Teams)</option>
<option value="ai_4p">🤖 AI vs AI: 4-Player (FFA)</option>
<option value="pass_2p">👥 2P Same Device (1v1)</option>
<option value="pass_3p">👥 3P Same Device (3 Players)</option>
<option value="pass_4p_ffa">👥 4P Same Device (FFA)</option>
<option value="pass_play">👥 4P Same Device (2v2 Teams)</option>
</select>
</div>
<div>
<label class="block text-[10px] font-bold uppercase text-amber-800 mb-1">AI Intelligence</label>
<select class="w-full bg-amber-50/90 border border-amber-400 rounded-xl px-2 py-1.5 text-xs font-extrabold text-amber-950" id="homeQuickAiDiffSelect">
<option value="easy">🟢 Easy (Normal)</option>
<option value="medium">🟡 Medium (Balanced)</option>
<option value="hard">🟠 Hard (Tough)</option>
<option selected="" value="hardest">🔥 Hardest (Utmost Expert)</option>
</select>
</div>
<div>
<label class="block text-[10px] font-bold uppercase text-amber-800 mb-1">AI Pace / Speed</label>
<div class="flex gap-1">
<select class="w-full bg-amber-50/90 border border-amber-400 rounded-xl px-2 py-1.5 text-xs font-extrabold text-amber-950" id="homeQuickAiSpeedSelect">
<option selected="" value="default">⚡ Fast (Default)</option>
<option value="slow">🐢 Slow</option>
<option value="dramatic">🎭 Dramatic</option>
<option value="slowest">⏳ Slowest</option>
<option value="custom">✏️ Custom...</option>
</select>
<input class="hidden w-16 bg-white border border-amber-400 rounded-xl px-2 py-1 text-xs font-bold text-slate-900" id="homeCustomAiSpeedInput" max="10" min="0.2" placeholder="Sec" step="0.1" type="number" value="1.5"/>
</div>
</div>
<div>
<label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Beads Per Player</label>
<select class="w-full bg-amber-50/90 border border-amber-300 rounded-xl px-2 py-1.5 text-xs font-bold text-slate-900" id="homeQuickTokensSelect">
<option value="2">♟️ 2 Beads (Fast)</option>
<option value="3">♟️ 3 Beads (Medium)</option>
<option selected="" value="4">♟️ 4 Beads (Standard)</option>
</select>
</div>
<div>
<label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Kill Rule Mode</label>
<select class="w-full bg-amber-50/90 border border-amber-300 rounded-xl px-2 py-1.5 text-xs font-bold text-slate-900" id="homeQuickCloseSelect">
<option selected="" value="close">🔒 Close Game + Kill Re-Roll</option>
<option value="open">🔓 Open Game + Kill Re-Roll</option>
</select>
</div>
<div>
<label class="block text-[10px] font-bold uppercase text-slate-500 mb-1">Turn Timer</label>
<div class="flex gap-1">
<select class="w-full bg-amber-50/90 border border-amber-300 rounded-xl px-2 py-1.5 text-xs font-bold text-slate-900" id="homeQuickTimerSelect">
<option value="0">🚫 No Timer (Off)</option>
<option value="15">⏱️ 15 Seconds</option>
<option selected="" value="30">⏱️ 30 Seconds</option>
<option value="60">⏱️ 1 Minute</option>
<option value="120">⏱️ 2 Minutes</option>
<option value="180">⏱️ 3 Minutes</option>
<option value="custom">✏️ Custom...</option>
</select>
<input class="hidden w-16 bg-white border border-amber-400 rounded-xl px-2 py-1 text-xs font-bold text-slate-900" id="homeCustomTimerInput" max="3600" min="5" placeholder="Sec" type="number" value="45"/>
</div>
</div>
</div>
<!-- BIG START GAME HERO BUTTON -->
<button class="w-full py-3.5 px-6 rounded-2xl font-black text-base sm:text-lg emerald-play-btn transition flex items-center justify-center gap-2 shadow-xl" id="startMatchHeroBtn" type="button">
<span>▶️</span>
<span>PLAY GAME NOW (کھیل شروع کریں)</span>
</button>
<button class="w-full py-2.5 px-4 rounded-2xl font-extrabold text-xs sm:text-sm bg-slate-900 hover:bg-slate-800 text-amber-300 border border-amber-400/60 transition flex items-center justify-center gap-2 shadow-md" id="homeOpenReplayStudioBtn" type="button">
<span>🎬</span>
<span>WATCH GAME REPLAYS — CURRENT &amp; PAST (ری پلے اسٹوڈیو)</span>
</button>
</div>
</div>
<!-- Bottom Secondary Navigation Bar on Home Screen -->
<div class="w-full grid grid-cols-2 sm:grid-cols-5 gap-2" id="homeDesktopBottomNav">
<button class="royal-card hover:bg-amber-50 py-2.5 px-3 rounded-2xl text-xs font-extrabold text-slate-800 flex items-center justify-center gap-1.5 transition" id="navRulesBtn" type="button">
<span>⚙️</span><span>Advanced Rules</span>
</button>
<button class="royal-card hover:bg-amber-50 py-2.5 px-3 rounded-2xl text-xs font-extrabold text-slate-800 flex items-center justify-center gap-1.5 transition" id="navNetworkBtn" type="button">
<span>📡</span><span>Wi-Fi &amp; QR Room</span>
<span class="px-1.5 py-0.2 bg-emerald-100 text-emerald-800 border border-emerald-300 rounded-full text-[10px]" id="lanPeerCountBadge">0</span>
</button>
<button class="royal-card hover:bg-amber-50 py-2.5 px-3 rounded-2xl text-xs font-extrabold text-slate-800 flex items-center justify-center gap-1.5 transition" id="navStatsBtn" type="button">
<span>🏆</span><span>Stats &amp; Backup</span>
</button>
<button class="royal-card hover:bg-amber-50 py-2.5 px-3 rounded-2xl text-xs font-extrabold text-slate-800 flex items-center justify-center gap-1.5 transition" id="navGuideBtn" type="button">
<span>📖</span><span>Bannu Guide</span>
</button>
<button class="royal-card hover:bg-amber-50 py-2.5 px-3 rounded-2xl text-xs font-extrabold text-rose-800 border-rose-300 flex items-center justify-center gap-1.5 transition" id="navReplayBtn" type="button">
<span>🎬</span><span>Match Replays</span>
</button>
</div>
</section>
<!-- ==================== SCREEN 1: ZERO-SCROLLBAR PURE GAMEPLAY ARENA (`100dvh`) ==================== -->
<section class="hidden w-full h-dvh max-h-dvh overflow-hidden flex flex-col items-center justify-between px-2 py-1 select-none" id="viewPlay">
<div class="w-full max-w-[720px] h-[48px] flex-shrink-0 grid grid-cols-12 items-center gap-1.5" id="playTopRow">
<div class="col-span-4 relative royal-card rounded-xl px-2 py-1 border-2 border-rose-400 flex flex-col justify-center h-full transition-all" id="playerCard0">
<div class="hidden absolute top-11 left-1 z-30 px-2 py-0.5 rounded-lg bg-amber-400 text-slate-950 font-black text-[10px] shadow" id="emoteBubble0"></div>
<div class="flex items-center justify-between gap-1">
<div class="flex items-center gap-1 min-w-0">
<span class="text-xs">🔴</span>
<span class="font-extrabold text-[11px] sm:text-xs text-slate-900 truncate" id="pName0">You</span>
<span class="text-[8px] px-1 rounded bg-amber-200 text-slate-950 border border-amber-500 font-black" id="pTeamBadge0" title="Teammate with Yellow">♦T1</span>
</div>
<span class="text-[8px] font-black px-1.5 py-0.5 rounded bg-slate-900 text-amber-300" id="pStatusTag0">BARI</span>
</div>
<div class="flex items-center justify-between text-[10px] font-extrabold text-slate-800 mt-0.5">
<span id="pKills0">⚔️ 0</span>
<span id="pHome0">🏠 0/4</span>
</div>
<div class="w-full h-0.5 bg-amber-100 rounded-full overflow-hidden mt-0.5">
<div class="h-full bg-rose-500 transition-all duration-300" id="turnTimerBar0" style="width: 100%"></div>
</div>
