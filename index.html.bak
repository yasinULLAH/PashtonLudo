      document.getElementById('qrImageUploadInput').addEventListener('change', function (e) {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const img = new Image();
        const reader = new FileReader();
        reader.onload = function (ev) {
          img.onload = function () {
            const c = document.getElementById('qrScanHiddenCanvas');
            const g = c.getContext('2d');
            c.width = img.width;
            c.height = img.height;
            g.drawImage(img, 0, 0);
            const imgData = g.getImageData(0, 0, c.width, c.height);
            if (window.jsQR) {
              const decoded = window.jsQR(imgData.data, imgData.width, imgData.height);
              if (decoded && decoded.data) {
                document.getElementById('remoteSdpTokenInput').value = decoded.data;
                processScannedRemoteToken(decoded.data);
                return;
              }
            }
            showToast('⚠️ Could not detect a valid QR code in that image.');
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('copySdpTokenBtn').addEventListener('click', function () {
        const el = document.getElementById('localSdpTokenOutput');
        el.select();
        document.execCommand('copy');
        showToast('📋 Offline WebRTC Handshake Token copied!');
      });
      document.getElementById('acceptRemoteSdpBtn').addEventListener('click', function () {
        const val = document.getElementById('remoteSdpTokenInput').value;
        processScannedRemoteToken(val);
      });

      document.getElementById('declineLanInviteBtn').addEventListener('click', function () {
        document.getElementById('lanInviteModal').classList.add('hidden');
        if (pendingIncomingInvite) {
          if (localBroadcastChannel) {
            localBroadcastChannel.postMessage({
              type: 'INVITE_DECLINED',
              targetId: pendingIncomingInvite.senderId,
              senderId: myRoomId,
              responderName: careerStats.playerName
            });
          }
          if (pendingIncomingInvite.conn && pendingIncomingInvite.conn.open) {
            pendingIncomingInvite.conn.send({
              type: 'INVITE_DECLINED',
              responderId: myRoomId,
              responderName: careerStats.playerName
            });
          }
          pendingIncomingInvite = null;
        }
      });
      document.getElementById('acceptLanInviteBtn').addEventListener('click', function () {
        document.getElementById('lanInviteModal').classList.add('hidden');
        if (!pendingIncomingInvite) return;
        const inv = pendingIncomingInvite;
        pendingIncomingInvite = null;
        if (localBroadcastChannel) {
          localBroadcastChannel.postMessage({
            type: 'INVITE_ACCEPTED',
            targetId: inv.senderId,
            senderId: myRoomId,
            responderName: careerStats.playerName,
            matchType: inv.matchType
          });
        }
        if (inv.conn && inv.conn.open) {
          inv.conn.send({
            type: 'INVITE_ACCEPTED',
            responderId: myRoomId,
            responderName: careerStats.playerName,
            matchType: inv.matchType
          });
        }
        launchVerifiedLanMatch(inv.senderId, inv.senderName, inv.matchType, false);
      });

      document.getElementById('saveProfileNameBtn').addEventListener('click', function () {
