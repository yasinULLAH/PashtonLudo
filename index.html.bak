      document.getElementById('createWifiRoomBtn').addEventListener('click', function () {
        if (localBroadcastChannel) {
          localBroadcastChannel.postMessage({
            type: 'ROOM_HOST',
            senderId: myRoomId,
            name: careerStats.playerName + ' (Room Host)',
            mode: rulesConfig.presetName
          });
        }
        showToast('🏠 Broadcasted Room ' + myRoomId + ' to all active Wi-Fi players!');
      });

      document.getElementById('copyPeerIdBtn').addEventListener('click', function () {
        const text = document.getElementById('myPeerIdDisplay').textContent;
        navigator.clipboard?.writeText(text).catch(function(){});
        showToast('📋 Copied Wi-Fi Room ID: ' + text);
      });
      function resolveTargetPeerFromInput() {
        let code = document.getElementById('joinPeerIdInput').value.trim().toUpperCase();
        if (/^\d{4}$/.test(code)) {
          code = 'BANNU-' + code;
        }
        if (!code || code === myRoomId) {
          showToast('⚠️ Enter a valid Friend\'s Room ID (e.g. BANNU-4821 or 4821).');
          return null;
        }
        const existing = discoveredPeers.get(code) || { id: code, name: 'Player ' + code, mode: rulesConfig.presetName };
        upsertDiscoveredPeer(existing);
        return existing;
      }
      document.getElementById('connectPeerIdBtn').addEventListener('click', function () {
        const target = resolveTargetPeerFromInput();
        if (target) {
          rulesConfig.teamMode = true;
          sendLanMatchInvite(target, '2v2 Team Match');
        }
      });
      const c1v1 = document.getElementById('connectPeerId1v1Btn');
      if (c1v1) {
        c1v1.addEventListener('click', function () {
          const target = resolveTargetPeerFromInput();
          if (target) {
            rulesConfig.teamMode = false;
            sendLanMatchInvite(target, '1v1 Match');
          }
        });
      }
