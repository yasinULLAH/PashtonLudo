        { tier: 10, minXp: 8800, icon: '🧹', titleEn: 'Clean Sweep Master', titleUr: 'کلین سویپ ماسٹر', perk: '0-Kill Opponent Crusher' },
        { tier: 11, minXp: 11200, icon: '🏔️', titleEn: 'Marwat Tactician', titleUr: 'مروت حکمت کار', perk: 'Remainder Math Pro' },
