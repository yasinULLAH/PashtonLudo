      function openCrownCheatModal() {
        const modal = document.getElementById('crownCheatModal');
        document.getElementById('crownAuthStep').classList.remove('hidden');
        document.getElementById('crownDiceStep').classList.add('hidden');
        document.getElementById('crownPasswordInput').value = '';
        document.getElementById('crownDiceValuesInput').value = rulesConfig.diceCount === 2 ? '6,6' : '6';
        document.getElementById('crownDicePromptText').textContent =
          rulesConfig.diceCount === 2
            ? '2-Dice Mode: Enter two values (1-6) separated by comma (e.g. 6,6 or 6,2):'
            : '1-Die Mode: Enter a die value from 1 to 6:';
        modal.classList.remove('hidden');
        setTimeout(function () {
          document.getElementById('crownPasswordInput').focus();
        }, 50);
      }

      function closeCrownCheatModal() {
        document.getElementById('crownCheatModal').classList.add('hidden');
      }

      function parseCrownDiceInput() {
        const raw = document.getElementById('crownDiceValuesInput').value.trim();
        const parts = raw.split(',').map(function (s) { return parseInt(s.trim(), 10); }).filter(function (n) { return !isNaN(n) && n >= 1 && n <= 6; });
        if (parts.length === 0) return null;
        if (rulesConfig.diceCount === 2) {
          return [parts[0], parts[1] !== undefined ? parts[1] : parts[0]];
        }
        return [parts[0]];
      }

      document.getElementById('closeCrownCheatBtn').addEventListener('click', closeCrownCheatModal);
      document.getElementById('ignoreCrownAuthBtn').addEventListener('click', closeCrownCheatModal);

      document.getElementById('exitScenarioDrillBtn').addEventListener('click', function () {
        restorePreDrillMatch();
      });

      document.getElementById('unlockCrownAuthBtn').addEventListener('click', function () {
        const pwd = document.getElementById('crownPasswordInput').value.trim();
        if (pwd === 'yasin1122') {
          document.getElementById('crownAuthStep').classList.add('hidden');
          document.getElementById('crownDiceStep').classList.remove('hidden');
          document.getElementById('crownDiceValuesInput').focus();
        } else {
          showToast('⛔ Incorrect password.');
        }
      });

      document.getElementById('applyComingDiceBtn').addEventListener('click', function () {
        const vals = parseCrownDiceInput();
        if (!vals) {
          showToast('Enter valid dice numbers (1-6), e.g. 6,6');
          return;
        }
        queuedCheatDice = vals;
        closeCrownCheatModal();
