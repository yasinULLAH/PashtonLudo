          onEffectUr: 'آن (ON — ڈیفالٹ): شکار کرنے والی گوٹی اسی باری کے ری رول میں بھی لاک رہے گی اور اگلی باری آنے پر کھلے گی۔',
          offEffectEn: 'DISABLED (OFF): Capturing bead locks only for the remaining die of that single roll and unlocks immediately on the bonus re-roll.',
          offEffectUr: 'آف (OFF): شکار کرنے والی گوٹی ری رول ملتے ہی اسی باری میں کھل جائے گی۔',
          exampleEn: 'You roll 3+4, move Bead #1 by +3 to kill Green (Bead #1 locks 🔒), and move Bead #2 by +4. Now you roll your Kill Bonus (say 5+2) in the same Bari: Bead #1 stays locked until your next Bari!',
          exampleUr: 'مثال: آپ نے 3 چل کر مخالف گوٹی ماری تو وہ گوٹی لاک ہو گئی۔ اب شکار کے انعام میں جو آپ دوبارہ ڈائس پھینکیں گے، اس میں بھی وہ گوٹی لاک رہے گی۔'
        }
      ];

      let currentGuideCategory = 'all';

      function getRuleLiveStatusInfo(item) {
        if (item.ruleKey === 'diceCount') {
          const is2D = rulesConfig.diceCount === 2;
          return {
            isOn: is2D,
            label: is2D ? 'Active: 2 Dice (دو دانے)' : 'Active: 1 Die (ایک دانہ)',
            canToggle: true
          };
        }
        const val = Boolean(rulesConfig[item.ruleKey]);
        return {
          isOn: val,
          label: val ? '🟢 Currently ON (فعال)' : '⚪ Currently OFF (بند)',
          canToggle: true
        };
      }

      function renderComprehensiveGuide() {
        const container = document.getElementById('comprehensiveGuideList');
        if (!container) return;
        const searchInput = document.getElementById('guideSearchInput');
        const query = (searchInput ? searchInput.value : '').trim().toLowerCase();

        const filtered = COMPREHENSIVE_GUIDE_ITEMS.filter(function (item) {
          if (currentGuideCategory !== 'all' && item.cat !== currentGuideCategory) return false;
          if (!query) return true;
          const hay = (
            item.titleEn + ' ' + item.titleUr + ' ' +
            item.enDesc + ' ' + item.urDesc + ' ' +
            item.exampleEn + ' ' + item.exampleUr
          ).toLowerCase();
          return hay.indexOf(query) !== -1;
        });

        if (filtered.length === 0) {
          container.innerHTML = '<div class="p-6 rounded-2xl bg-amber-50 border border-amber-200 text-center text-xs font-bold text-slate-600">No matching rules found. Try another keyword or select "All Rules".</div>';
          return;
        }

        container.innerHTML = '';
        filtered.forEach(function (item) {
          const status = getRuleLiveStatusInfo(item);
          const card = document.createElement('div');
          card.className = 'p-4 rounded-2xl border-2 transition ' +
            (status.isOn ? 'bg-amber-50/85 border-amber-400 shadow-sm' : 'bg-white border-slate-200');

          card.innerHTML =
            '<div class="flex flex-wrap items-start justify-between gap-2 pb-2.5 border-b border-amber-200/80">' +
              '<div class="space-y-0.5">' +
                '<div class="flex flex-wrap items-center gap-1.5">' +
                  '<h3 class="font-black text-sm sm:text-base text-slate-900">' + item.titleEn + '</h3>' +
                  '<span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-amber-100 text-amber-900 border border-amber-300">' + item.defaultBadge + '</span>' +
                '</div>' +
                '<div class="font-bold text-xs sm:text-sm text-amber-900" dir="rtl">' + item.titleUr + '</div>' +
              '</div>' +
              '<button type="button" data-rule-key="' + item.ruleKey + '" class="guide-toggle-rule-btn px-3 py-1.5 rounded-xl text-xs font-black border transition cursor-pointer ' +
                (status.isOn
                  ? 'bg-emerald-600 hover:bg-emerald-500 text-white border-emerald-700 shadow-sm'
                  : 'bg-slate-100 hover:bg-amber-100 text-slate-700 border-slate-300') + '">' +
                status.label + ' (Tap to Toggle)' +
              '</button>' +
            '</div>' +
            '<div class="grid grid-cols-1 md:grid-cols-2 gap-3 my-2.5 text-xs">' +
              '<div class="p-2.5 rounded-xl bg-white/90 border border-amber-200/70 space-y-1">' +
                '<div class="font-extrabold text-[10px] uppercase tracking-wider text-slate-500">🇬🇧 How It Works (English)</div>' +
                '<p class="text-slate-800 leading-relaxed">' + item.enDesc + '</p>' +
              '</div>' +
              '<div class="p-2.5 rounded-xl bg-white/90 border border-amber-200/70 space-y-1 text-right" dir="rtl">' +
                '<div class="font-extrabold text-[10px] text-amber-800">🇵🇰 اصول کی تفصیل (اردو)</div>' +
                '<p class="text-slate-800 leading-relaxed font-semibold">' + item.urDesc + '</p>' +
              '</div>' +
            '</div>' +
            '<div class="grid grid-cols-1 md:grid-cols-2 gap-2.5 mb-2.5 text-[11px]">' +
              '<div class="p-2.5 rounded-xl bg-emerald-50/90 border border-emerald-200 space-y-1">' +
                '<div class="font-black text-emerald-900">✅ Effect When ENABLED (آن کرنے کا اثر):</div>' +
                '<div class="text-emerald-950">' + item.onEffectEn + '</div>' +
                '<div class="text-emerald-900 font-semibold text-right" dir="rtl">' + item.onEffectUr + '</div>' +
              '</div>' +
              '<div class="p-2.5 rounded-xl bg-rose-50/80 border border-rose-200 space-y-1">' +
                '<div class="font-black text-rose-900">🚫 Effect When DISABLED (آف کرنے کا اثر):</div>' +
                '<div class="text-rose-950">' + item.offEffectEn + '</div>' +
                '<div class="text-rose-900 font-semibold text-right" dir="rtl">' + item.offEffectUr + '</div>' +
              '</div>' +
            '</div>' +
            '<div class="p-2.5 rounded-xl bg-indigo-50/90 border border-indigo-200 text-[11px] space-y-1">' +
              '<div class="font-black text-indigo-950">💡 Practical Board Example (عملی مثال):</div>' +
              '<div class="text-indigo-950">' + item.exampleEn + '</div>' +
              '<div class="text-indigo-900 font-semibold text-right" dir="rtl">' + item.exampleUr + '</div>' +
            '</div>';

          const toggleBtn = card.querySelector('.guide-toggle-rule-btn');
          if (toggleBtn) {
            toggleBtn.addEventListener('click', function () {
              const rKey = item.ruleKey;
              if (rKey === 'diceCount') {
                rulesConfig.diceCount = (rulesConfig.diceCount === 2 ? 1 : 2);
              } else {
                rulesConfig[rKey] = !rulesConfig[rKey];
              }
              rulesConfig.presetName = 'Custom Rules';
              saveRulesPreferences(true);
              syncRulesStudioControls();
              updateAllUI();
              renderComprehensiveGuide();
              showToast('⚙️ Updated rule: ' + item.titleEn, true);
            });
          }

          container.appendChild(card);
        });
      }

      // --- 16. SCREEN NAVIGATION, IMMERSIVE BOARD-ONLY MODE & EVENT LISTENERS ---
      const SCREENS = ['viewHome', 'viewPlay', 'viewRules', 'viewNetwork', 'viewStats', 'viewGuide'];

      function switchNavigationTab(targetViewId) {
        if (targetViewId !== 'viewNetwork') stopCameraQrScanner();
        if (targetViewId !== 'viewPlay') {
          document.body.classList.remove('immersive-board-only');
          document.body.classList.remove('in-play-mode');
          gameState.isMatchActive = false;
          if (gameState.aiTimer) clearTimeout(gameState.aiTimer);
        } else {
          document.body.classList.add('in-play-mode');
        }
        SCREENS.forEach(function (vId) {
          const el = document.getElementById(vId);
          if (!el) return;
          if (vId === targetViewId) el.classList.remove('hidden');
          else el.classList.add('hidden');
        });
        document.querySelectorAll('.android-tab-btn').forEach(function (btn) {
          if (btn.dataset.targetView === targetViewId) {
            btn.classList.add('active');
          } else {
            btn.classList.remove('active');
          }
        });
        if (targetViewId === 'viewHome') checkSavedMatchBanner();
        if (targetViewId === 'viewStats') renderStatsView();
        if (targetViewId === 'viewGuide') renderComprehensiveGuide();
        if (targetViewId === 'viewPlay') {
          requestAnimationFrame(function () { drawBoard(); });
        }
      }

      function toggleImmersiveBoardOnlyMode(forceState) {
        const enable = forceState !== undefined ? forceState : !document.body.classList.contains('immersive-board-only');
        if (enable) {
          document.body.classList.add('immersive-board-only');
          document.getElementById('pauseMenuModal').classList.add('hidden');
          if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
            document.documentElement.requestFullscreen().catch(function () {});
          }
          showToast('👁️ Immersive Board-Only Mode: Tap your corner yard on the board to roll & drag/tap beads to move!');
        } else {
          document.body.classList.remove('immersive-board-only');
        }
        drawBoard();
      }

      document.getElementById('toggleImmersivePlayBtn').addEventListener('click', function () {
        toggleImmersiveBoardOnlyMode();
      });
      document.getElementById('enterImmersiveFromMenuBtn').addEventListener('click', function () {
        setGamePaused(false);
        toggleImmersiveBoardOnlyMode(true);
      });
      document.getElementById('exitImmersiveBtn').addEventListener('click', function () {
        toggleImmersiveBoardOnlyMode(false);
      });
      document.getElementById('immersiveRollBtn').addEventListener('pointerdown', function (e) {
        if (!verifyMultiMouseAccess(e.pointerId, 'roll the dice')) return;
        if (netMatch.isActive && gameState.currentTurn !== netMatch.myLocalSeat) {
          const actor = gameState.players[gameState.currentTurn];
          showToast('⏳ Waiting for ' + (actor ? actor.name : 'other player') + '\'s turn...');
          return;
        }
        if ((gameState.phase === 'ROLL' || canPlayerRollBonusNow()) && gameState.players[gameState.currentTurn].type === 'human') {
          rollDiceForCurrentPlayer();
        }
      });

      document.getElementById('inGameFullscreenBtn').addEventListener('click', function () {
        if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen().catch(function () {});
          showToast('⛶ Fullscreen Activated');
        } else if (document.exitFullscreen) {
          document.exitFullscreen().catch(function () {});
        }
      });

      document.getElementById('resumeSavedMatchBtn').addEventListener('click', function () {
        resumeSavedMatch();
      });

      document.getElementById('homeQuickTimerSelect').addEventListener('change', function () {
        document.getElementById('homeCustomTimerInput').classList.toggle('hidden', this.value !== 'custom');
      });
      document.getElementById('turnTimerSelect').addEventListener('change', function () {
        document.getElementById('rulesCustomTimerInput').classList.toggle('hidden', this.value !== 'custom');
      });

      document.getElementById('homeQuickAiDiffSelect').addEventListener('change', function () {
        rulesConfig.aiDifficulty = this.value;
        saveRulesPreferences(false);
        syncRulesStudioControls();
      });
      document.getElementById('pauseAiDifficultySelect').addEventListener('change', function () {
        rulesConfig.aiDifficulty = this.value;
        saveRulesPreferences(false);
        syncRulesStudioControls();
        showToast('🧠 AI Intelligence set to: ' + this.options[this.selectedIndex].text, true);
      });
      document.getElementById('pauseResetAiLearningBtn').addEventListener('click', resetAiKnowledge);
      document.getElementById('rulesResetAiLearningBtn').addEventListener('click', resetAiKnowledge);
      document.getElementById('homeQuickAiSpeedSelect').addEventListener('change', function () {
        const isCustom = this.value === 'custom';
        document.getElementById('homeCustomAiSpeedInput').classList.toggle('hidden', !isCustom);
        rulesConfig.aiSpeed = this.value;
        saveRulesPreferences(false);
        syncRulesStudioControls();
      });
      document.getElementById('homeCustomAiSpeedInput').addEventListener('input', function () {
        rulesConfig.aiCustomSpeedSec = Math.max(0.2, Math.min(10, parseFloat(this.value) || 1.5));
        rulesConfig.aiSpeed = 'custom';
        saveRulesPreferences(false);
        syncRulesStudioControls();
      });
      document.getElementById('pauseAiSpeedSelect').addEventListener('change', function () {
        const isCustom = this.value === 'custom';
        document.getElementById('pauseAiCustomSpeedInput').classList.toggle('hidden', !isCustom);
        rulesConfig.aiSpeed = this.value;
        saveRulesPreferences(false);
        syncRulesStudioControls();
        showToast('⏱️ AI Pace set to: ' + this.options[this.selectedIndex].text, true);
      });
      document.getElementById('pauseAiCustomSpeedInput').addEventListener('input', function () {
        rulesConfig.aiCustomSpeedSec = Math.max(0.2, Math.min(10, parseFloat(this.value) || 1.5));
        rulesConfig.aiSpeed = 'custom';
        saveRulesPreferences(false);
        syncRulesStudioControls();
      });
      document.getElementById('aiSpeedSelect').addEventListener('change', function () {
        const isCustom = this.value === 'custom';
        document.getElementById('rulesCustomAiSpeedInput').classList.toggle('hidden', !isCustom);
        rulesConfig.aiSpeed = this.value;
        saveRulesPreferences(false);
        syncRulesStudioControls();
      });
      document.getElementById('rulesCustomAiSpeedInput').addEventListener('input', function () {
        rulesConfig.aiCustomSpeedSec = Math.max(0.2, Math.min(10, parseFloat(this.value) || 1.5));
        rulesConfig.aiSpeed = 'custom';
        saveRulesPreferences(false);
        syncRulesStudioControls();
      });
      document.getElementById('quickAiSpeedBtn').addEventListener('click', function () {
        const order = ['default', 'slow', 'dramatic', 'slowest'];
        let curIdx = order.indexOf(rulesConfig.aiSpeed);
        if (curIdx === -1) curIdx = 0;
        const nextSpeed = order[(curIdx + 1) % order.length];
        rulesConfig.aiSpeed = nextSpeed;
        saveRulesPreferences(false);
        syncRulesStudioControls();
        const labelMap = {
          default: '⚡ Fast (Default)',
          slow: '🐢 Slow (Deliberate)',
          dramatic: '🎭 Dramatic (Suspenseful)',
          slowest: '⏳ Slowest (Spectator)'
        };
        showToast('⏱️ AI Match Pace: ' + (labelMap[nextSpeed] || nextSpeed), true);
      });

      document.getElementById('startMatchHeroBtn').addEventListener('click', function () {
        netMatch.isActive = false;
        const fmt = document.getElementById('homeQuickFormatSelect').value;
        const homeAiEl = document.getElementById('homeQuickAiDiffSelect');
        if (homeAiEl) rulesConfig.aiDifficulty = homeAiEl.value;
        const homeSpeedEl = document.getElementById('homeQuickAiSpeedSelect');
        if (homeSpeedEl) {
          rulesConfig.aiSpeed = homeSpeedEl.value;
          if (rulesConfig.aiSpeed === 'custom') {
            rulesConfig.aiCustomSpeedSec = Math.max(0.2, Math.min(10, parseFloat(document.getElementById('homeCustomAiSpeedInput').value) || 1.5));
          }
        }
        rulesConfig.tokensPerPlayer = Number(document.getElementById('homeQuickTokensSelect').value);
        rulesConfig.closeGameMode = (document.getElementById('homeQuickCloseSelect').value === 'close');
        const homeTimerVal = document.getElementById('homeQuickTimerSelect').value;
        rulesConfig.turnTimeSeconds = homeTimerVal === 'custom'
          ? Math.max(5, parseInt(document.getElementById('homeCustomTimerInput').value, 10) || 45)
          : Number(homeTimerVal);

        if (fmt === '2v2_ai') {
          rulesConfig.teamMode = true;
          seatConfig[0] = { name: careerStats.playerName, type: 'human', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Sher Khan AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Wazir Partner', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Marwat AI', type: 'ai', active: true, isBotTakeover: false };
        } else if (fmt === '1v1_ai') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: careerStats.playerName, type: 'human', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
          seatConfig[2] = { name: 'Sher Khan AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
        } else if (fmt === '3p_ai') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: careerStats.playerName, type: 'human', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Sher Khan AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Wazir AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
        } else if (fmt === '4p_ai') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: careerStats.playerName, type: 'human', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Sher Khan AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Wazir AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Marwat AI', type: 'ai', active: true, isBotTakeover: false };
        } else if (fmt === 'ai_2p') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: 'Afridi AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
          seatConfig[2] = { name: 'Sher Khan AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
        } else if (fmt === 'ai_3p') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: 'Afridi AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Sher Khan AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Wazir AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
        } else if (fmt === 'ai_4p') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: 'Afridi AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Sher Khan AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Wazir AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Marwat AI', type: 'ai', active: true, isBotTakeover: false };
        } else if (fmt === 'ai_vs_ai') {
          rulesConfig.teamMode = true;
          seatConfig[0] = { name: 'Afridi AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Sher Khan AI', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Wazir Partner', type: 'ai', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Marwat AI', type: 'ai', active: true, isBotTakeover: false };
        } else if (fmt === 'pass_2p') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: 'Player 1 (Red)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
          seatConfig[2] = { name: 'Player 2 (Yellow)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
        } else if (fmt === 'pass_3p') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: 'Player 1 (Red)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Player 2 (Green)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Player 3 (Yellow)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Empty', type: 'ai', active: false, isBotTakeover: false };
        } else if (fmt === 'pass_4p_ffa') {
          rulesConfig.teamMode = false;
          seatConfig[0] = { name: 'Player 1 (Red)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Player 2 (Green)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Player 3 (Yellow)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Player 4 (Blue)', type: 'human', active: true, isBotTakeover: false };
        } else if (fmt === 'pass_play') {
          rulesConfig.teamMode = true;
          seatConfig[0] = { name: 'Player 1 (Red)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[1] = { name: 'Player 2 (Green)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[2] = { name: 'Player 3 (Yellow)', type: 'human', active: true, isBotTakeover: false };
          seatConfig[3] = { name: 'Player 4 (Blue)', type: 'human', active: true, isBotTakeover: false };
        }

        saveRulesPreferences(true);
        switchNavigationTab('viewPlay');
        initNewMatch('Match started! Roll the dice and drag or tap your beads on the board.', false);
        broadcastSettingsSync();
      });

      document.getElementById('navRulesBtn').addEventListener('click', function () {
        syncRulesStudioControls();
        switchNavigationTab('viewRules');
      });
      document.getElementById('navNetworkBtn').addEventListener('click', function () {
        switchNavigationTab('viewNetwork');
      });
      document.getElementById('navStatsBtn').addEventListener('click', function () {
        switchNavigationTab('viewStats');
      });
      document.getElementById('navGuideBtn').addEventListener('click', function () {
        switchNavigationTab('viewGuide');
      });
      document.getElementById('guideToRulesStudioBtn').addEventListener('click', function () {
        syncRulesStudioControls();
        switchNavigationTab('viewRules');
      });
      document.querySelectorAll('.guide-cat-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          currentGuideCategory = btn.dataset.cat || 'all';
          document.querySelectorAll('.guide-cat-btn').forEach(function (b) {
            const active = (b.dataset.cat === currentGuideCategory);
            b.className = 'guide-cat-btn px-3 py-1.5 rounded-xl text-xs transition ' +
              (active ? 'font-black bg-amber-500 text-white shadow-sm' : 'font-bold bg-white text-slate-700 border border-amber-200');
          });
          renderComprehensiveGuide();
        });
      });
      document.getElementById('guideSearchInput').addEventListener('input', function () {
        renderComprehensiveGuide();
      });

      document.querySelectorAll('.back-to-home-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          switchNavigationTab('viewHome');
        });
      });

      document.querySelectorAll('.android-tab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const target = btn.dataset.targetView;
          if (target === 'viewRules') syncRulesStudioControls();
          switchNavigationTab(target);
        });
      });

      window.addEventListener('resize', function () {
        if (gameState.players && gameState.players.length === 4) {
          drawBoard();
        }
        if (replayState.isOpen) {
          drawReplayBoardCanvas();
        }
      });

      document.getElementById('openPauseMenuBtn').addEventListener('click', function () {
        setGamePaused(true);
        renderSeatTakeoverControls();
        document.getElementById('pauseMenuModal').classList.remove('hidden');
      });
      document.getElementById('closePauseMenuBtn').addEventListener('click', function () {
        document.getElementById('pauseMenuModal').classList.add('hidden');
        setGamePaused(false);
      });
      document.getElementById('resumeGameBtn').addEventListener('click', function () {
        document.getElementById('pauseMenuModal').classList.add('hidden');
        setGamePaused(false);
      });
      document.getElementById('exitToHomeBtn').addEventListener('click', function () {
        setGamePaused(false);
        saveActiveMatchSnapshot();
        document.getElementById('pauseMenuModal').classList.add('hidden');
        switchNavigationTab('viewHome');
      });

      document.getElementById('quickCustomizeRulesBtn').addEventListener('click', function () {
        document.getElementById('pauseMenuModal').classList.add('hidden');
        syncRulesStudioControls();
        switchNavigationTab('viewRules');
      });

      document.getElementById('langSelect').addEventListener('change', function () {
        const lang = this.value;
        const mainT = document.getElementById('appMainTitle');
        const subT = document.getElementById('appSubTitle');
        if (lang === 'ur') {
          mainT.textContent = 'بنوں رائل لڈو — پشتون اور کلاسک قوانین';
          subT.textContent = 'بورڈ پر گوٹی کھینچیں یا ٹیپ کریں • شکار پر دوبارہ باری اور کلوز گیم';
          showToast('اردو زبان فعال کر دی گئی ہے!');
        } else if (lang === 'ps') {
          mainT.textContent = 'بنو رایل لډو — پښتون دودیز قوانین';
          subT.textContent = 'دوه دانې (۲ ډایس)، کلوز ګیم، ۲ پر ۲ ټیم او آفلاین ملټي پلیر';
          showToast('پښتو ژبه فعاله شوه!');
        } else {
          mainT.textContent = 'Bannu Royale Ludo';
          subT.textContent = 'Authentic Pashtun 2-Dice Cultural Rules & Classic Yalla Ludo — Direct Drag & Tap Board';
          showToast('Switched to English / Bilingual mode.');
        }
      });

      document.getElementById('soundToggleBtn').addEventListener('click', function () {
        soundEnabled = !soundEnabled;
        this.textContent = soundEnabled ? '🔊' : '🔇';
        showToast(soundEnabled ? '🔊 Sound Effects Enabled' : '🔇 Sound Muted');
      });

      document.getElementById('fullscreenToggleBtn').addEventListener('click', function () {
        if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen().catch(function () {});
        } else if (document.exitFullscreen) {
          document.exitFullscreen().catch(function () {});
        }
      });

      document.getElementById('toggleEmoteTrayBtn').addEventListener('click', function () {
        document.getElementById('quickEmoteDrawer').classList.toggle('hidden');
      });

      document.querySelectorAll('.emote-send-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          const text = btn.dataset.emote;
          triggerPlayerEmote(0, text);
          document.getElementById('quickEmoteDrawer').classList.add('hidden');
          broadcastNetworkAction({ type: 'EMOTE', playerIdx: 0, text: text });
        });
      });

      document.getElementById('reclaimSeatTopBtn').addEventListener('click', function () {
        gameState.players.forEach(function (pl, idx) {
          if (pl && pl.active && pl.isBotTakeover) {
            handlePlayerDisconnectOrLeave(idx, 'reclaimed seat');
          }
        });
      });

      document.getElementById('rollDiceBtn').addEventListener('pointerdown', function (e) {
        const actor = gameState.players[gameState.currentTurn];
        if (actor && actor.type === 'human') {
          if (netMatch.isActive && gameState.currentTurn !== netMatch.myLocalSeat) {
            showToast('⏳ Waiting for ' + actor.name + '\'s turn (' + PLAYER_META[actor.id].colorName + ')...');
            return;
          }
          if (!verifyMultiMouseAccess(e.pointerId, 'roll the dice')) return;
          actor.consecutiveTimeouts = 0;
          if (gameState.phase === 'ROLL' || canPlayerRollBonusNow()) {
            rollDiceForCurrentPlayer();
          }
        }
      });
      document.getElementById('dieSlot0').addEventListener('pointerdown', function (e) {
        const actor = gameState.players[gameState.currentTurn];
        if (!actor || actor.type !== 'human') return;

        if (netMatch.isActive && gameState.currentTurn !== netMatch.myLocalSeat) {
          if (e.cancelable) e.preventDefault();
          showToast('⏳ Waiting for ' + actor.name + '\'s turn (' + PLAYER_META[actor.id].colorName + ')...');
          return;
        }
        if (!verifyMultiMouseAccess(e.pointerId, 'use Die 1')) return;
        actor.consecutiveTimeouts = 0;
        const activePool = gameState.dicePool.filter(function (d) { return !d.used; });
        const d0 = (gameState.dicePool.length > 2 && activePool.length > 0) ? activePool[0] : gameState.dicePool[0];
        if (gameState.phase === 'ROLL') {
          rollDiceForCurrentPlayer();
        } else if (gameState.phase === 'MOVE' && d0 && !d0.used) {
          gameState.preferredDieFilter = (gameState.preferredDieFilter === d0.id ? null : d0.id);
          updateAllUI();
        }
      });
      document.getElementById('dieSlot1').addEventListener('pointerdown', function (e) {
        const actor = gameState.players[gameState.currentTurn];
        if (!actor || actor.type !== 'human') return;

        if (netMatch.isActive && gameState.currentTurn !== netMatch.myLocalSeat) {
          if (e.cancelable) e.preventDefault();
          showToast('⏳ Waiting for ' + actor.name + '\'s turn (' + PLAYER_META[actor.id].colorName + ')...');
          return;
        }
        if (!verifyMultiMouseAccess(e.pointerId, 'use Die 2')) return;
        actor.consecutiveTimeouts = 0;
        const activePool = gameState.dicePool.filter(function (d) { return !d.used; });
        const d1 = (gameState.dicePool.length > 2 && activePool.length > 1) ? activePool[1] : gameState.dicePool[1];
        if (gameState.phase === 'ROLL') {
          rollDiceForCurrentPlayer();
        } else if (gameState.phase === 'MOVE' && d1 && !d1.used) {
          gameState.preferredDieFilter = (gameState.preferredDieFilter === d1.id ? null : d1.id);
          updateAllUI();
        }
      });
      document.getElementById('dicePlusDivider').addEventListener('pointerdown', function (e) {
        const actor = gameState.players[gameState.currentTurn];
        if (!actor || actor.type !== 'human') return;

        if (netMatch.isActive && gameState.currentTurn !== netMatch.myLocalSeat) {
          if (e.cancelable) e.preventDefault();
          showToast('⏳ Waiting for ' + actor.name + '\'s turn (' + PLAYER_META[actor.id].colorName + ')...');
          return;
        }
        if (!verifyMultiMouseAccess(e.pointerId, 'combine dice')) return;
        if (gameState.phase === 'MOVE') {
          gameState.preferredDieFilter = (gameState.preferredDieFilter === 'combined' ? null : 'combined');
          updateAllUI();
        }
      });

      document.getElementById('undoMoveBtn').addEventListener('click', function () {
        restoreUndoSnapshot();
      });

      window.addEventListener('keydown', function (e) {
        if (e.code === 'Space' && !['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement.tagName)) {
          if (gameState.isMatchActive && gameState.phase === 'ROLL' && gameState.players[gameState.currentTurn].type === 'human') {
            if (netMatch.isActive && gameState.currentTurn !== netMatch.myLocalSeat) return;
            e.preventDefault();
            rollDiceForCurrentPlayer();
          }
        }
      });

