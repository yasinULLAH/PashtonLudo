      });

      document.getElementById('exportStatsBackupBtn').addEventListener('click', function () {
        const backupPayload = {
          app: 'BannuRoyaleLudo',
          version: '5.0-Complete',
          author: 'Yasin Ullah (Bannu Software Solutions)',
          dedication: "Dedicated to Muhib Ullah, the author's little brother.",
          exportedAt: new Date().toISOString(),
          careerStats: careerStats,
          rulesConfig: rulesConfig,
          aiKnowledgeBase: aiKnowledgeBase
        };
        const blob = new Blob([JSON.stringify(backupPayload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'bannu_ludo_backup_' + new Date().toISOString().slice(0, 10) + '.json';
        a.click();
        URL.revokeObjectURL(url);
        showToast('💾 Backup JSON downloaded!');
      });

      document.getElementById('importStatsBackupInput').addEventListener('change', function (e) {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (ev) {
          try {
            const data = JSON.parse(ev.target.result);
            if (data.careerStats) {
              careerStats = Object.assign({}, DEFAULT_STATS, data.careerStats);
              if (data.rulesConfig) rulesConfig = Object.assign({}, rulesConfig, data.rulesConfig);
              if (data.aiKnowledgeBase) {
                aiKnowledgeBase = Object.assign({}, DEFAULT_AI_KNOWLEDGE, data.aiKnowledgeBase);
                saveAiKnowledge();
              }
              saveCareerStats();
              syncRulesStudioControls();
              showToast('✅ Career Stats & Custom Rules Restored Successfully!');
            }
          } catch (err) {
            showToast('⚠️ Invalid backup file format.');
          }
        };
        reader.readAsText(file);
      });

      document.getElementById('resetStatsBtn').addEventListener('click', function () {
