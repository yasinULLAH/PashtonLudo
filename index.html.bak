      // Active Dashboard UI State
      let dashState = {
        activeRole: 'super_admin',
        activeSubTab: 'overview',
        reportPage: 1,
        reportPageSize: 8,
        reportSearch: '',
        reportRulebook: 'all',
        reportOutcome: 'all',
        reportFormat: 'all',
        reportSort: 'date_desc',
        achCategory: 'all',
        achStatus: 'all',
        achSearch: '',
        chartInstances: {},
        chartDatasetsCache: {},
        currentInspectedChartId: null
      };

      function getFilteredSortedReportRecords() {
        ensureCareerStatsSchema();
        const records = (careerStats.matchRecords || []).slice();
        const q = (dashState.reportSearch || '').trim().toLowerCase();
        const filtered = records.filter(function (r) {
          if (dashState.reportRulebook === 'bannu' && r.rulebookType !== 'bannu') return false;
          if (dashState.reportRulebook === 'yalla' && r.rulebookType !== 'yalla') return false;
          if (dashState.reportRulebook === 'close' && !r.closeGameMode) return false;
          if (dashState.reportRulebook === 'open' && r.closeGameMode) return false;
          if (dashState.reportOutcome === 'won' && !r.won) return false;
          if (dashState.reportOutcome === 'cleansweep' && !r.isCleanSweep) return false;
          if (dashState.reportOutcome === 'lost' && r.won) return false;
          if (dashState.reportFormat !== 'all' && r.formatCode !== dashState.reportFormat) return false;
          if (q) {
            const hay = ((r.matchId || '') + ' ' + (r.mode || '') + ' ' + (r.format || '') + ' ' + (r.result || '') + ' ' + (r.date || '')).toLowerCase();
            if (hay.indexOf(q) === -1) return false;
          }
          return true;
        });

        filtered.sort(function (a, b) {
          const s = dashState.reportSort;
          if (s === 'date_asc') return String(a.timestamp || a.date).localeCompare(String(b.timestamp || b.date));
          if (s === 'duration_desc') return (b.durationMs || 0) - (a.durationMs || 0);
          if (s === 'duration_asc') return (a.durationMs || 0) - (b.durationMs || 0);
          if (s === 'kills_desc') return (b.kills || 0) - (a.kills || 0);
          if (s === 'movetime_asc') return (a.avgBeadMoveMs || 9999) - (b.avgBeadMoveMs || 9999);
          if (s === 'movetime_desc') return (b.avgBeadMoveMs || 0) - (a.avgBeadMoveMs || 0);
          if (s === 'turns_desc') return (b.totalTurns || 0) - (a.totalTurns || 0);
          return String(b.timestamp || b.date).localeCompare(String(a.timestamp || a.date));
        });
        return filtered;
      }

      function renderReportsTableAndPagination() {
        const tbody = document.getElementById('reportsTableBody');
        const sumBar = document.getElementById('reportFilteredSummaryBar');
        const pagSum = document.getElementById('reportPaginationSummary');
        const pagInd = document.getElementById('reportPageIndicator');
        if (!tbody) return;

        const filtered = getFilteredSortedReportRecords();
        const total = filtered.length;
        const pageSize = Math.max(1, Number(dashState.reportPageSize) || 8);
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        if (dashState.reportPage > totalPages) dashState.reportPage = totalPages;
        if (dashState.reportPage < 1) dashState.reportPage = 1;

        const startIdx = (dashState.reportPage - 1) * pageSize;
        const pageItems = filtered.slice(startIdx, startIdx + pageSize);

        // Filtered summary metrics
        if (sumBar) {
          const fWins = filtered.filter(function (r) { return r.won; }).length;
          const fSweeps = filtered.filter(function (r) { return r.isCleanSweep; }).length;
          const fKills = filtered.reduce(function (acc, r) { return acc + (r.kills || 0); }, 0);
          const fAvgDur = total > 0 ? Math.round(filtered.reduce(function (acc, r) { return acc + (r.durationMs || 0); }, 0) / total) : 0;
          const fAvgMove = total > 0 ? Math.round(filtered.reduce(function (acc, r) { return acc + (r.avgBeadMoveMs || 0); }, 0) / total) : 0;
          sumBar.innerHTML =
            '<div class="p-2 rounded-xl bg-slate-900 text-white"><span class="text-[10px] text-amber-300 block font-bold">Filtered Matches</span><b class="text-sm font-black">' + total + ' Records</b></div>' +
            '<div class="p-2 rounded-xl bg-emerald-50 border border-emerald-200"><span class="text-[10px] text-emerald-700 block font-bold">Filtered Win Rate</span><b class="text-sm font-black text-emerald-900">' + (total > 0 ? Math.round((fWins / total) * 100) : 0) + '% (' + fWins + 'W)</b></div>' +
            '<div class="p-2 rounded-xl bg-indigo-50 border border-indigo-200"><span class="text-[10px] text-indigo-700 block font-bold">Clean Sweeps</span><b class="text-sm font-black text-indigo-900">' + fSweeps + ' 🧹</b></div>' +
            '<div class="p-2 rounded-xl bg-rose-50 border border-rose-200"><span class="text-[10px] text-rose-700 block font-bold">Filtered Kills</span><b class="text-sm font-black text-rose-900">' + fKills + ' ⚔️</b></div>' +
            '<div class="p-2 rounded-xl bg-sky-50 border border-sky-200"><span class="text-[10px] text-sky-700 block font-bold">Avg Game / Move</span><b class="text-sm font-black text-sky-900">' + formatDurationMs(fAvgDur) + ' • ' + (fAvgMove / 1000).toFixed(2) + 's</b></div>';
        }

        if (pageItems.length === 0) {
          tbody.innerHTML = '<tr><td colspan="8" class="py-6 text-center text-slate-400 italic">No match records match your current filters.</td></tr>';
        } else {
          tbody.innerHTML = pageItems.map(function (r) {
            const badgeClass = r.isCleanSweep
              ? 'bg-indigo-100 text-indigo-900 border-indigo-300'
              : (r.won ? 'bg-emerald-100 text-emerald-900 border-emerald-300' : 'bg-rose-50 text-rose-800 border-rose-200');
            return '<tr class="hover:bg-amber-50/60 transition">' +
              '<td class="py-2.5 px-3 font-mono font-bold text-slate-900">' + (r.matchId || 'M-001') + '<div class="text-[10px] font-sans text-slate-500">' + (r.date || '') + '</div></td>' +
              '<td class="py-2.5 px-3"><div class="font-bold text-slate-900">' + (r.mode || '') + '</div><div class="text-[10px] text-slate-500">' + (r.format || '2v2') + ' • ' + (r.closeGameMode ? '🔒 Close Game' : '🔓 Open Game') + '</div></td>' +
              '<td class="py-2.5 px-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-black border ' + badgeClass + '">' + (r.result || '') + '</span></td>' +
              '<td class="py-2.5 px-3 text-right font-bold">⚔️ ' + (r.kills || 0) + ' <span class="text-slate-400">/</span> 🔒 ' + (r.closeLocks || 0) + '</td>' +
              '<td class="py-2.5 px-3 text-right font-mono font-bold text-slate-800">' + formatDurationMs(r.durationMs || 240000) + '<div class="text-[10px] text-slate-500">' + (r.totalTurns || 20) + ' Baris</div></td>' +
              '<td class="py-2.5 px-3 text-right font-mono font-bold text-emerald-700">' + ((r.avgBeadMoveMs || 1250) / 1000).toFixed(2) + 's</td>' +
              '<td class="py-2.5 px-3 text-right font-mono font-bold text-sky-700">' + ((r.avgTurnTimeMs || 4300) / 1000).toFixed(2) + 's</td>' +
              '<td class="py-2.5 px-3 text-center"><div class="flex items-center justify-center gap-1"><button type="button" data-match-id="' + r.matchId + '" class="replay-match-btn px-2 py-1 rounded-xl bg-rose-600 hover:bg-rose-500 text-white font-black text-[10px] shadow-sm">🎬 Replay</button><button type="button" data-match-id="' + r.matchId + '" class="inspect-match-btn px-2 py-1 rounded-xl bg-amber-100 hover:bg-amber-200 text-amber-950 font-black text-[10px] border border-amber-300">🔍 Details</button></div></td>' +
            '</tr>';
          }).join('');

          tbody.querySelectorAll('.replay-match-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
              openReplayStudio(btn.dataset.matchId);
            });
          });
          tbody.querySelectorAll('.inspect-match-btn').forEach(function (btn) {
            btn.addEventListener('click', function () {
              openMatchDrilldownModal(btn.dataset.matchId);
            });
          });
        }

        if (pagSum) {
          pagSum.textContent = total === 0
            ? 'Showing 0 of 0 records'
            : ('Showing ' + (startIdx + 1) + '–' + Math.min(total, startIdx + pageItems.length) + ' of ' + total + ' records');
        }
        if (pagInd) {
          pagInd.textContent = 'Page ' + dashState.reportPage + ' / ' + totalPages;
        }
      }

      let currentDrilldownMatchId = null;
      function openMatchDrilldownModal(matchId) {
        ensureCareerStatsSchema();
        const rec = (careerStats.matchRecords || []).find(function (m) { return m.matchId === matchId; }) || (careerStats.matchRecords || [])[0];
        if (!rec) return;
        currentDrilldownMatchId = rec.matchId;
        const modal = document.getElementById('matchDrilldownModal');
        document.getElementById('matchDrilldownTitle').textContent = '🔍 Match Telemetry Breakdown — ' + rec.matchId + ' (' + rec.result + ')';
        document.getElementById('matchDrilldownSubtitle').textContent = rec.mode + ' • ' + rec.format + ' • Duration: ' + formatDurationMs(rec.durationMs) + ' • ' + rec.totalTurns + ' Baris';

        const playersHtml = (rec.playersSummary || []).filter(function (p) { return p.active !== false; }).map(function (p) {
          return '<div class="p-3 rounded-2xl bg-amber-50/70 border border-amber-200 space-y-1">' +
            '<div class="flex items-center justify-between"><span class="font-black text-slate-900">' + p.name + ' (' + p.color + ')</span><span class="px-2 py-0.5 rounded bg-white border border-amber-300 text-[10px] font-bold">🏠 ' + p.homeCompleted + ' Home</span></div>' +
            '<div class="grid grid-cols-2 gap-1 text-[11px] text-slate-700 pt-1">' +
              '<div>⚔️ Kills: <b>' + p.kills + '</b></div>' +
              '<div>💀 Deaths: <b>' + (p.deaths || 0) + '</b></div>' +
              '<div>⚡ Avg Bead Move: <b>' + ((p.avgMoveMs || 1300) / 1000).toFixed(2) + 's</b></div>' +
              '<div>⏱️ Avg Bari Turn: <b>' + ((p.avgTurnMs || 4400) / 1000).toFixed(2) + 's</b></div>' +
              '<div>👣 Steps Moved: <b>' + (p.stepsMoved || 0) + '</b></div>' +
              '<div>🕒 Total Active Time: <b>' + formatDurationMs(p.totalTurnTimeMs || 95000) + '</b></div>' +
            '</div>' +
          '</div>';
        }).join('');

        const logsHtml = (rec.moveLogs || []).map(function (ml) {
          return '<tr class="border-b border-amber-100">' +
            '<td class="py-1.5 px-2 font-mono">#' + ml.moveNo + '</td>' +
            '<td class="py-1.5 px-2 font-bold">' + ml.playerName + ' (Bead #' + ml.tokenId + ')</td>' +
            '<td class="py-1.5 px-2">' + ml.outcome + '</td>' +
            '<td class="py-1.5 px-2 text-right font-mono">' + (ml.decisionMs / 1000).toFixed(2) + 's</td>' +
            '<td class="py-1.5 px-2 text-right font-mono">' + (ml.animMs / 1000).toFixed(2) + 's</td>' +
            '<td class="py-1.5 px-2 text-right font-mono font-bold text-emerald-700">' + (ml.totalMoveMs / 1000).toFixed(2) + 's</td>' +
          '</tr>';
        }).join('');

        document.getElementById('matchDrilldownContent').innerHTML =
          '<div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">' + playersHtml + '</div>' +
          (logsHtml ? (
            '<div class="pt-2"><div class="font-black text-xs uppercase text-amber-900 mb-1">👣 Recorded Bead Movements in Match ' + rec.matchId + '</div>' +
            '<div class="overflow-x-auto rounded-xl border border-amber-200 bg-white"><table class="w-full text-left text-[11px]"><thead><tr class="bg-slate-900 text-amber-300"><th class="py-1.5 px-2">Move</th><th class="py-1.5 px-2">Player &amp; Bead</th><th class="py-1.5 px-2">Outcome</th><th class="py-1.5 px-2 text-right">Think</th><th class="py-1.5 px-2 text-right">Hop</th><th class="py-1.5 px-2 text-right">Total</th></tr></thead><tbody>' + logsHtml + '</tbody></table></div></div>'
          ) : '');
        modal.classList.remove('hidden');
      }

      function renderTelemetryTab() {
        ensureCareerStatsSchema();
        const grid = document.getElementById('playerTelemetryCardsGrid');
        const logBody = document.getElementById('beadMovementLogTableBody');
        if (grid) {
          const seatColors = [
            { border: 'border-rose-300 bg-rose-50/70', badge: 'bg-rose-600 text-white', icon: '🔴' },
            { border: 'border-emerald-300 bg-emerald-50/70', badge: 'bg-emerald-600 text-white', icon: '🟢' },
            { border: 'border-amber-300 bg-amber-50/70', badge: 'bg-amber-600 text-white', icon: '🟡' },
            { border: 'border-blue-300 bg-blue-50/70', badge: 'bg-blue-600 text-white', icon: '🔵' }
          ];
          grid.innerHTML = careerStats.seatStats.map(function (st, idx) {
            const sc = seatColors[idx];
            const avgDecisionSec = st.moves > 0 ? (st.totalDecisionMs / st.moves / 1000).toFixed(2) : '0.00';
            const avgAnimSec = st.moves > 0 ? (st.totalAnimMs / st.moves / 1000).toFixed(2) : '0.00';
            const avgFullMoveSec = st.moves > 0 ? ((st.totalDecisionMs + st.totalAnimMs) / st.moves / 1000).toFixed(2) : '0.00';
            const avgTurnSec = st.turns > 0 ? (st.totalTurnMs / st.turns / 1000).toFixed(2) : '0.00';
            const avgGameTime = st.matches > 0 ? formatDurationMs(Math.round(st.totalGameTimeMs / st.matches)) : '0m 00s';
            const seatName = idx === 0 ? careerStats.playerName : (seatConfig[idx] ? seatConfig[idx].name : st.color);
            return '<div class="p-3.5 rounded-2xl border-2 ' + sc.border + ' space-y-2">' +
              '<div class="flex items-center justify-between">' +
                '<span class="font-black text-xs text-slate-900 truncate">' + sc.icon + ' ' + seatName + '</span>' +
                '<span class="px-2 py-0.5 rounded-lg text-[10px] font-black ' + sc.badge + '">' + st.wins + 'W / ' + st.matches + 'M</span>' +
              '</div>' +
              '<div class="grid grid-cols-2 gap-1.5 text-[11px] bg-white/90 p-2.5 rounded-xl border border-amber-200/60">' +
                '<div><span class="text-slate-400 block text-[9px] font-bold uppercase">Avg Bead Move</span><b class="text-emerald-700 font-mono">' + avgFullMoveSec + 's</b></div>' +
                '<div><span class="text-slate-400 block text-[9px] font-bold uppercase">Think / Hop</span><b class="text-slate-800 font-mono">' + avgDecisionSec + 's / ' + avgAnimSec + 's</b></div>' +
                '<div><span class="text-slate-400 block text-[9px] font-bold uppercase">Avg Bari Turn</span><b class="text-sky-700 font-mono">' + avgTurnSec + 's</b></div>' +
                '<div><span class="text-slate-400 block text-[9px] font-bold uppercase">Full Turn Time</span><b class="text-slate-800 font-mono">' + formatDurationMs(st.totalTurnMs) + '</b></div>' +
                '<div><span class="text-slate-400 block text-[9px] font-bold uppercase">Avg Game Time</span><b class="text-purple-700 font-mono">' + avgGameTime + '</b></div>' +
                '<div><span class="text-slate-400 block text-[9px] font-bold uppercase">Full Game Time</span><b class="text-slate-800 font-mono">' + formatDurationMs(st.totalGameTimeMs) + '</b></div>' +
                '<div><span class="text-slate-400 block text-[9px] font-bold uppercase">Kills / Locks</span><b class="text-rose-700">⚔️' + st.kills + ' • 🔒' + st.closeLocks + '</b></div>' +
                '<div><span class="text-slate-400 block text-[9px] font-bold uppercase">Steps / Home</span><b class="text-amber-900">👣' + st.stepsMoved + ' • 🏠' + st.homeCompleted + '</b></div>' +
              '</div>' +
            '</div>';
          }).join('');
        }

        if (logBody) {
          const logs = careerStats.beadMoveLogs || [];
          if (logs.length === 0) {
            logBody.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-slate-400 italic">Make a move on the board to see real-time millisecond bead movement logs.</td></tr>';
          } else {
            logBody.innerHTML = logs.slice(0, 40).map(function (ml) {
              return '<tr class="hover:bg-amber-50/50">' +
                '<td class="py-2 px-3 font-mono font-bold text-slate-700">' + (ml.matchId || 'LIVE') + ' #' + ml.moveNo + '</td>' +
                '<td class="py-2 px-3 font-bold text-slate-900">' + ml.playerName + ' <span class="text-[10px] px-1.5 py-0.2 rounded bg-amber-100 text-amber-900">Bead #' + ml.tokenId + '</span></td>' +
                '<td class="py-2 px-3 font-semibold text-slate-800">' + ml.outcome + '</td>' +
                '<td class="py-2 px-3 text-right font-mono text-slate-700">' + (ml.decisionMs / 1000).toFixed(2) + 's <span class="text-[10px] text-slate-400">(' + ml.decisionMs + 'ms)</span></td>' +
                '<td class="py-2 px-3 text-right font-mono text-slate-700">' + (ml.animMs / 1000).toFixed(2) + 's <span class="text-[10px] text-slate-400">(' + ml.animMs + 'ms)</span></td>' +
                '<td class="py-2 px-3 text-right font-mono font-black text-emerald-700">' + (ml.totalMoveMs / 1000).toFixed(2) + 's</td>' +
              '</tr>';
            }).join('');
          }
        }
      }

      function renderProgressionTab() {
        const xpInfo = computeCareerXpAndRank();
        const allBadges = evaluateAll64Achievements();
        const unlockedCount = allBadges.filter(function (b) { return b.unlocked; }).length;

        const heroBadgesEl = document.getElementById('heroStatBadgesCount');
        if (heroBadgesEl) heroBadgesEl.textContent = unlockedCount + ' / ' + allBadges.length;

        const rankBadgeEl = document.getElementById('rankLadderProgressBadge');
        if (rankBadgeEl) rankBadgeEl.textContent = 'Rank ' + xpInfo.currentRank.tier + ' / ' + OFFICIAL_RANKS_LADDER.length;

        // Mode Masteries
        const masteryContainer = document.getElementById('modeMasteryListContainer');
        if (masteryContainer) {
          const masteries = computeModeMasteries();
          masteryContainer.innerHTML = masteries.map(function (m) {
            return '<div class="p-2.5 rounded-2xl bg-amber-50/60 border border-amber-200 space-y-1">' +
              '<div class="flex items-center justify-between text-xs">' +
                '<span class="font-black text-slate-900">' + m.icon + ' ' + m.name + '</span>' +
                '<span class="px-2 py-0.5 rounded-full bg-slate-900 text-amber-300 font-black text-[10px]">Lv.' + m.level + '</span>' +
              '</div>' +
              '<div class="flex items-center justify-between text-[10px] text-slate-500">' +
                '<span dir="rtl" class="font-bold text-amber-900">' + m.ur + '</span>' +
                '<span>' + m.pts + ' / ' + m.nextPts + ' Mastery PTS</span>' +
              '</div>' +
              '<div class="w-full h-2 bg-slate-200 rounded-full overflow-hidden">' +
                '<div class="h-full ' + m.color + '" style="width:' + m.pct + '%"></div>' +
              '</div>' +
            '</div>';
          }).join('');
        }

        // 20 Ranks Ladder
        const ranksGrid = document.getElementById('ranksLadderGrid');
        if (ranksGrid) {
          ranksGrid.innerHTML = OFFICIAL_RANKS_LADDER.map(function (rk) {
            const isUnlocked = xpInfo.xp >= rk.minXp;
            const isCurrent = xpInfo.currentRank.tier === rk.tier;
            return '<div class="p-2.5 rounded-2xl border-2 transition flex items-center justify-between gap-2 ' +
              (isCurrent ? 'bg-amber-100 border-amber-500 shadow-sm' : (isUnlocked ? 'bg-emerald-50/70 border-emerald-300' : 'bg-slate-50 border-slate-200 opacity-70')) + '">' +
              '<div class="flex items-center gap-2 min-w-0">' +
                '<div class="w-9 h-9 rounded-xl bg-white border border-amber-300 flex items-center justify-center text-lg flex-shrink-0">' + rk.icon + '</div>' +
                '<div class="min-w-0">' +
                  '<div class="font-black text-xs text-slate-900 truncate">#' + rk.tier + ' ' + rk.titleEn + (isCurrent ? ' (CURRENT)' : '') + '</div>' +
                  '<div class="text-[10px] font-bold text-amber-900" dir="rtl">' + rk.titleUr + '</div>' +
                  '<div class="text-[9px] text-slate-500">' + rk.perk + '</div>' +
                '</div>' +
              '</div>' +
              '<div class="text-right flex-shrink-0">' +
                '<span class="px-2 py-0.5 rounded-lg text-[10px] font-black ' + (isUnlocked ? 'bg-emerald-600 text-white' : 'bg-slate-200 text-slate-700') + '">' + (isUnlocked ? '✓ Unlocked' : (rk.minXp + ' XP')) + '</span>' +
              '</div>' +
            '</div>';
          }).join('');
        }

        // Full 64 Achievements Catalog
        const catalogGrid = document.getElementById('fullAchievementsCatalogGrid');
        if (catalogGrid) {
          const q = (dashState.achSearch || '').trim().toLowerCase();
          const filteredBadges = allBadges.filter(function (b) {
            if (dashState.achCategory !== 'all' && b.cat !== dashState.achCategory) return false;
            if (dashState.achStatus === 'unlocked' && !b.unlocked) return false;
            if (dashState.achStatus === 'locked' && b.unlocked) return false;
            if (q) {
              const hay = (b.title + ' ' + b.titleUr + ' ' + b.desc + ' ' + b.tier).toLowerCase();
              if (hay.indexOf(q) === -1) return false;
            }
            return true;
          });

          const tierColors = {
            Bronze: 'bg-amber-100 text-amber-900 border-amber-300',
            Silver: 'bg-slate-200 text-slate-800 border-slate-400',
            Gold: 'bg-yellow-200 text-yellow-950 border-yellow-500',
            Diamond: 'bg-sky-100 text-sky-900 border-sky-400',
            Mythic: 'bg-purple-100 text-purple-900 border-purple-400'
          };

          catalogGrid.innerHTML = filteredBadges.map(function (b) {
            return '<div class="p-3 rounded-2xl border-2 flex flex-col justify-between gap-2 transition ' +
              (b.unlocked ? 'bg-amber-50/95 border-amber-400 shadow-sm' : 'bg-white border-slate-200') + '">' +
              '<div>' +
                '<div class="flex items-start justify-between gap-1">' +
                  '<span class="font-black text-xs text-slate-900">' + b.icon + ' ' + b.title + '</span>' +
                  '<span class="px-1.5 py-0.2 rounded text-[9px] font-black border ' + (tierColors[b.tier] || tierColors.Bronze) + '">' + b.tier + ' +' + b.xp + 'XP</span>' +
                '</div>' +
                '<div class="text-[11px] font-bold text-amber-900 mt-0.5" dir="rtl">' + b.titleUr + '</div>' +
                '<div class="text-[10px] text-slate-600 mt-0.5">' + b.desc + '</div>' +
              '</div>' +
              '<div>' +
                '<div class="flex items-center justify-between text-[10px] font-bold mb-1">' +
                  '<span class="' + (b.unlocked ? 'text-emerald-700 font-black' : 'text-slate-500') + '">' + (b.unlocked ? '✅ UNLOCKED' : 'Progress') + '</span>' +
                  '<span class="font-mono">' + b.cur + ' / ' + b.target + ' (' + b.pct + '%)</span>' +
                '</div>' +
                '<div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden">' +
                  '<div class="h-full ' + (b.unlocked ? 'bg-emerald-500' : 'bg-amber-500') + '" style="width:' + b.pct + '%"></div>' +
                '</div>' +
              '</div>' +
            '</div>';
          }).join('');
        }
      }

      function renderSuperAdminTab() {
        ensureCareerStatsSchema();
        const diagEl = document.getElementById('superAdminSystemDiagnostics');
        const alertsEl = document.getElementById('superAdminAlertsList');
        const feedEl = document.getElementById('superAdminActivityFeed');
        const alertBadge = document.getElementById('adminAlertsCountBadge');

        if (diagEl) {
          let storageBytes = 0;
          try {
            storageBytes = (localStorage.getItem('bannu_ludo_career_v2') || '').length + (localStorage.getItem('bannu_ludo_rules_v2') || '').length;
          } catch (e) {}
          const kbSize = (storageBytes / 1024).toFixed(1) + ' KB';
          const linkedMice = getLinkedMiceCount();
          const activeRulesCount = Object.keys(rulesConfig).filter(function (k) { return rulesConfig[k] === true; }).length;
          diagEl.innerHTML =
            '<div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-200"><span>🗄️ LocalStorage Telemetry DB</span><b class="font-mono text-emerald-700">' + kbSize + ' (' + (careerStats.matchRecords || []).length + ' Matches)</b></div>' +
            '<div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-200"><span>🔒 Close Game Bari Lock Mode</span><b class="text-amber-900">' + (rulesConfig.closeGameMode ? (rulesConfig.keepCaptureLockOnBonusRoll ? 'Locked Entire Bari ✓' : 'Unlocks on Bonus Roll') : 'Open Game') + '</b></div>' +
            '<div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-200"><span>⚙️ Active Cultural Rule Flags</span><b class="text-indigo-800">' + activeRulesCount + ' Enabled Rules</b></div>' +
            '<div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-200"><span>🖱️ Multi-Mouse Hardware Lock</span><b class="text-slate-800">' + (rulesConfig.multiMouseLock ? ('ACTIVE (' + linkedMice + ' Mice)') : ('Standby (' + linkedMice + ' Linked)')) + '</b></div>' +
            '<div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-200"><span>📡 P2P / LAN Room ID</span><b class="font-mono text-amber-800">' + myRoomId + ' (' + discoveredPeers.size + ' Peers)</b></div>' +
            '<div class="flex items-center justify-between p-2 rounded-xl bg-slate-50 border border-slate-200"><span>🔊 WebAudio Synthesizer</span><b class="text-emerald-700">' + (soundEnabled ? 'Enabled (Low-Latency)' : 'Muted') + '</b></div>';
        }

        if (alertsEl) {
          const alerts = [
            { level: 'emerald', icon: '🔒', title: 'Close Game Bari Lock Verified', desc: 'Capturing beads stay locked across all bonus re-rolls within the same Bari until the player’s next Bari (configurable in Rules Studio).' },
            { level: 'indigo', icon: '🧹', title: 'Clean Sweep Instant Victory Active', desc: 'Reaching all beads Home while opponent(s) have 0 kills immediately triggers a Flawless Clean Sweep win across 1v1, 2v2, and 3P/4P FFA.' },
            { level: 'amber', icon: '🎲', title: 'Dice Entropy & Distribution Audit', desc: 'Total 6s rolled: ' + ((careerStats.diceFaceCounts && careerStats.diceFaceCounts[6]) || 0) + ' • Double Sixes (6+6): ' + (careerStats.doubleSixes || 0) + ' — within normal tactical distribution.' },
            { level: 'sky', icon: '⏱️', title: 'Move Telemetry Precision', desc: 'Tracking millisecond think/decision latency and hop animation duration across all 4 player seats.' }
          ];
          if (alertBadge) alertBadge.textContent = alerts.length + ' Active Insights';
          alertsEl.innerHTML = alerts.map(function (a) {
            return '<div class="p-2.5 rounded-2xl bg-' + a.level + '-50/90 border border-' + a.level + '-200 space-y-0.5">' +
              '<div class="font-black text-slate-900">' + a.icon + ' ' + a.title + '</div>' +
              '<div class="text-[11px] text-slate-600 leading-snug">' + a.desc + '</div>' +
            '</div>';
          }).join('');
        }

        if (feedEl) {
          const feed = careerStats.activityFeed || [];
          feedEl.innerHTML = feed.slice(0, 25).map(function (ev) {
            return '<div class="p-2 rounded-xl bg-amber-50/60 border border-amber-200/80 flex items-start gap-2">' +
              '<span class="text-base">' + (ev.icon || '🎲') + '</span>' +
              '<div class="min-w-0 flex-1">' +
                '<div class="font-bold text-slate-900 truncate">' + ev.title + '</div>' +
                '<div class="text-[10px] text-slate-600">' + ev.detail + '</div>' +
                '<div class="text-[9px] text-slate-400 font-mono">' + String(ev.ts || '').slice(0, 19).replace('T', ' ') + '</div>' +
              '</div>' +
            '</div>';
          }).join('');
        }
      }

      function renderInfographicsAndCharts() {
        ensureCareerStatsSchema();
        const s = careerStats;
        const records = (s.matchRecords || []).slice().reverse();

        // 1. Bead Lifecycle Funnel Infographic
        const funnelEl = document.getElementById('infographicBeadFunnel');
        const totalYard = Math.max(20, (s.matches || 1) * (rulesConfig.tokensPerPlayer || 4));
        const spawned = Math.max(totalYard, s.totalSpawns || 24);
        const bloodLoops = s.totalOuterLoops || 6;
        const killsMade = s.kills || 16;
        const homeDone = s.totalHomeCompleted || 19;
        dashState.chartDatasetsCache['funnel'] = {
          title: 'Bead Lifecycle Conversion Funnel Dataset',
          headers: ['Stage', 'Count', 'Conversion %', 'Tactical Notes'],
          rows: [
            ['1. Hand / Yard Spawns (⚡)', spawned, '100%', 'Beads brought out on 6 (or 1)'],
            ['2. Outer Track Captures (⚔️)', killsMade, Math.round((killsMade / Math.max(1, spawned)) * 100) + '%', 'Blood Gate unlocks earned'],
            ['3. Close Game Bari Locks (🔒)', s.totalCloseLocks || 0, Math.round(((s.totalCloseLocks || 0) / Math.max(1, spawned)) * 100) + '%', 'Locked on capture square during Bari'],
            ['4. No-Kill Outer Loops (🔄)', bloodLoops, Math.round((bloodLoops / Math.max(1, spawned)) * 100) + '%', '52-cell extra laps before kill'],
            ['5. Final Home Triangle Completed (🏠)', homeDone, Math.round((homeDone / Math.max(1, spawned)) * 100) + '%', 'Beads safely crowned in Home']
          ]
        };
        if (funnelEl) {
          funnelEl.innerHTML = dashState.chartDatasetsCache['funnel'].rows.map(function (r, idx) {
            const cols = ['bg-amber-500', 'bg-rose-500', 'bg-indigo-500', 'bg-purple-500', 'bg-emerald-600'];
            const pctNum = parseInt(r[2], 10) || 25;
            return '<div class="space-y-0.5">' +
              '<div class="flex justify-between text-[11px] font-bold"><span>' + r[0] + '</span><span class="font-mono">' + r[1] + ' (' + r[2] + ')</span></div>' +
              '<div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden"><div class="h-full ' + cols[idx % cols.length] + '" style="width:' + Math.min(100, Math.max(10, pctNum)) + '%"></div></div>' +
            '</div>';
          }).join('');
        }

        // 2. Dice Probability Heatmap Infographic
        const diceEl = document.getElementById('infographicDiceHeatmap');
        const df = s.diceFaceCounts || { 1: 10, 2: 10, 3: 10, 4: 10, 5: 10, 6: 12 };
        const totalDiceRolled = Math.max(1, (df[1] || 0) + (df[2] || 0) + (df[3] || 0) + (df[4] || 0) + (df[5] || 0) + (df[6] || 0));
        dashState.chartDatasetsCache['dice_polar'] = {
          title: 'Dice Face Frequency & Probability Dataset (Faces 1–6)',
          headers: ['Die Face', 'Times Rolled', 'Actual Share %', 'Expected Fair %'],
          rows: [1, 2, 3, 4, 5, 6].map(function (face) {
            const cnt = df[face] || 0;
            const pct = ((cnt / totalDiceRolled) * 100).toFixed(1) + '%';
            return ['Face ' + face + (face === 6 ? ' (🔥 Spawn/Bonus)' : ''), cnt, pct, '16.7%'];
          })
        };
        if (diceEl) {
          diceEl.innerHTML = '<div class="grid grid-cols-3 gap-1.5">' + [1, 2, 3, 4, 5, 6].map(function (face) {
            const cnt = df[face] || 0;
            const pct = ((cnt / totalDiceRolled) * 100).toFixed(1);
            return '<div class="p-2 rounded-xl border ' + (face === 6 ? 'bg-rose-50 border-rose-300 text-rose-900' : 'bg-amber-50/60 border-amber-200 text-slate-800') + ' text-center">' +
              '<div class="text-[10px] font-black">🎲 Face ' + face + '</div>' +
              '<div class="text-sm font-black font-mono">' + cnt + '</div>' +
              '<div class="text-[9px] font-semibold text-slate-500">' + pct + '%</div>' +
            '</div>';
          }).join('') + '</div>' +
          '<div class="text-[10px] text-slate-500 font-semibold pt-1 flex justify-between"><span>Total Dice Rolled: <b>' + totalDiceRolled + '</b></span><span>Double Sixes (6+6): <b class="text-amber-700">' + (s.doubleSixes || 0) + '</b></span></div>';
        }

        // 3. Seat & Team Dominance Infographic
        const domEl = document.getElementById('infographicSeatDominance');
        const seatArr = s.seatStats || DEFAULT_STATS.seatStats;
        dashState.chartDatasetsCache['seat_bar'] = {
          title: 'Per-Seat Combat, Completion & Timing Dataset',
          headers: ['Seat Color', 'Matches', 'Wins', 'Kills (شکار)', 'Deaths', 'Home Beads', 'Spawns', 'Avg Bead Move (s)', 'Avg Bari Turn (s)'],
          rows: seatArr.map(function (st) {
            const avgMv = st.moves > 0 ? ((st.totalDecisionMs + st.totalAnimMs) / st.moves / 1000).toFixed(2) : '1.30';
            const avgTrn = st.turns > 0 ? (st.totalTurnMs / st.turns / 1000).toFixed(2) : '4.20';
            return [st.color, st.matches, st.wins, st.kills, st.deaths, st.homeCompleted, st.spawns, avgMv + 's', avgTrn + 's'];
          })
        };
        if (domEl) {
          const t1Wins = (seatArr[0].wins || 0) + (seatArr[2].wins || 0);
          const t2Wins = (seatArr[1].wins || 0) + (seatArr[3].wins || 0);
          const t1Pct = Math.round((t1Wins / Math.max(1, t1Wins + t2Wins)) * 100);
          domEl.innerHTML =
            '<div class="p-2.5 rounded-2xl bg-amber-50 border border-amber-200 space-y-1">' +
              '<div class="flex justify-between text-[11px] font-black"><span>♦ Team 1 (Red &amp; Yellow)</span><span>' + t1Pct + '% Dominance</span></div>' +
              '<div class="w-full h-2.5 bg-sky-200 rounded-full overflow-hidden flex"><div class="h-full bg-amber-500" style="width:' + t1Pct + '%"></div></div>' +
              '<div class="flex justify-between text-[10px] text-slate-600"><span>♦T1 Kills: <b>' + ((seatArr[0].kills || 0) + (seatArr[2].kills || 0)) + '</b></span><span>★T2 Kills: <b>' + ((seatArr[1].kills || 0) + (seatArr[3].kills || 0)) + '</b></span></div>' +
            '</div>' +
            '<div class="grid grid-cols-2 gap-1.5 pt-1">' +
              seatArr.map(function (st) {
                return '<div class="px-2.5 py-1.5 rounded-xl bg-white border border-slate-200 flex items-center justify-between text-[11px]">' +
                  '<span class="font-bold">' + st.color + '</span>' +
                  '<span class="font-mono font-black text-slate-800">' + st.wins + 'W • ⚔️' + st.kills + '</span>' +
                '</div>';
              }).join('') +
            '</div>';
        }

        // Prepare datasets for the remaining charts
        dashState.chartDatasetsCache['trend_line'] = {
          title: 'Match Duration & Avg Bead Move Speed Trend Dataset',
          headers: ['Match ID', 'Date', 'Mode', 'Result', 'Duration (min)', 'Avg Bead Move (s)', 'Avg Turn (s)', 'Kills'],
          rows: records.map(function (r) {
            return [r.matchId, r.date, r.mode, r.result, ((r.durationMs || 240000) / 60000).toFixed(2), ((r.avgBeadMoveMs || 1250) / 1000).toFixed(2), ((r.avgTurnTimeMs || 4300) / 1000).toFixed(2), r.kills || 0];
          })
        };

        const cleanSweepWins = s.cleanSweeps || 0;
        const standardTeamWins = Math.max(0, (s.teamWins || 0) - cleanSweepWins);
        const soloWins = Math.max(0, (s.wins || 0) - cleanSweepWins - standardTeamWins);
        const losses = Math.max(0, (s.matches || 0) - (s.wins || 0));
        dashState.chartDatasetsCache['outcome_doughnut'] = {
          title: 'Match Outcomes & Clean Sweep Breakdown Dataset',
          headers: ['Outcome Category', 'Matches Count', 'Share %'],
          rows: [
            ['🧹 Clean Sweep Victories (0-Kill Opponents)', cleanSweepWins, Math.round((cleanSweepWins / Math.max(1, s.matches)) * 100) + '%'],
            ['🤝 Standard 2v2 Team Victories', standardTeamWins, Math.round((standardTeamWins / Math.max(1, s.matches)) * 100) + '%'],
            ['🏆 Solo 1v1 / FFA Victories', soloWins, Math.round((soloWins / Math.max(1, s.matches)) * 100) + '%'],
            ['🏁 Lost Matches', losses, Math.round((losses / Math.max(1, s.matches)) * 100) + '%']
          ]
        };

        const radarScores = [
          Math.min(100, Math.round((s.kills || 0) * 5 + 20)),
          Math.min(100, Math.round(s.totalBeadMovesCount > 0 ? Math.max(30, 110 - ((s.totalMoveDecisionMs / s.totalBeadMovesCount) / 25)) : 82)),
          Math.min(100, Math.round((s.cleanSweeps || 0) * 28 + 35)),
          Math.min(100, Math.round((s.totalCloseLocks || 0) * 8 + 25)),
          Math.min(100, Math.round((s.teamWins || 0) * 18 + (s.totalPartnerAssists || 0) * 6 + 30)),
          Math.min(100, Math.round((s.doubleSixes || 0) * 9 + 30))
        ];
        dashState.chartDatasetsCache['tactical_radar'] = {
          title: '6-Axis Tactical Skill Radar Dataset',
          headers: ['Tactical Dimension', 'Rating (0–100)', 'Underlying Metric'],
          rows: [
            ['Shikari Aggression (Kills)', radarScores[0], (s.kills || 0) + ' Career Kills'],
            ['Bead Move Reflex Speed', radarScores[1], (s.totalBeadMovesCount > 0 ? ((s.totalMoveDecisionMs + s.totalMoveAnimMs) / s.totalBeadMovesCount / 1000).toFixed(2) : '1.20') + 's Avg Move'],
            ['Clean Sweep Dominance', radarScores[2], (s.cleanSweeps || 0) + ' Clean Sweeps'],
            ['Close Game Lock Control', radarScores[3], (s.totalCloseLocks || 0) + ' Bari Locks'],
            ['2v2 Partner Synergy', radarScores[4], (s.teamWins || 0) + ' Team Wins & ' + (s.totalPartnerAssists || 0) + ' Assists'],
            ['Dice & Spawn Efficiency', radarScores[5], (s.doubleSixes || 0) + ' Double Sixes & ' + (s.totalSpawns || 0) + ' Spawns']
          ]
        };

        dashState.chartDatasetsCache['timing_stacked'] = {
          title: 'Per-Player Bead Movement Think Time vs Hop Animation Time Dataset',
          headers: ['Seat', 'Total Moves', 'Avg Think/Decision (s)', 'Avg Hop Anim (s)', 'Total Avg Move (s)', 'Avg Bari Turn (s)', 'Full Game Time'],
          rows: seatArr.map(function (st) {
            const dec = st.moves > 0 ? (st.totalDecisionMs / st.moves / 1000).toFixed(2) : '1.05';
            const anim = st.moves > 0 ? (st.totalAnimMs / st.moves / 1000).toFixed(2) : '0.22';
            const tot = st.moves > 0 ? ((st.totalDecisionMs + st.totalAnimMs) / st.moves / 1000).toFixed(2) : '1.27';
            const trn = st.turns > 0 ? (st.totalTurnMs / st.turns / 1000).toFixed(2) : '4.25';
            return [st.color, st.moves, dec + 's', anim + 's', tot + 's', trn + 's', formatDurationMs(st.totalGameTimeMs)];
          })
        };

        dashState.chartDatasetsCache['full_reports'] = {
          title: 'Complete Filtered Match Reports Dataset',
          headers: ['Match ID', 'Date', 'Mode', 'Format', 'Result', 'Clean Sweep', 'Kills', 'Close Locks', 'Duration', 'Avg Bead Move (s)', 'Avg Bari Turn (s)'],
          rows: getFilteredSortedReportRecords().map(function (r) {
            return [r.matchId, r.date, r.mode, r.format, r.result, r.isCleanSweep ? 'YES' : 'NO', r.kills, r.closeLocks || 0, formatDurationMs(r.durationMs), ((r.avgBeadMoveMs || 1200) / 1000).toFixed(2) + 's', ((r.avgTurnTimeMs || 4300) / 1000).toFixed(2) + 's'];
          })
        };

        if (!window.Chart) return;

        function mountOrUpdateChart(key, canvasId, config) {
          const el = document.getElementById(canvasId);
          if (!el) return;
          if (dashState.chartInstances[key]) {
            try { dashState.chartInstances[key].destroy(); } catch (e) {}
          }
          dashState.chartInstances[key] = new window.Chart(el.getContext('2d'), config);
        }

        // 1. Line/Area Trend Chart
        mountOrUpdateChart('trend_line', 'dashChartTrendLine', {
          type: 'line',
          data: {
            labels: records.map(function (r) { return r.matchId; }),
            datasets: [
              {
                label: 'Game Time (min)',
                data: records.map(function (r) { return Number(((r.durationMs || 240000) / 60000).toFixed(2)); }),
                borderColor: '#d97706',
                backgroundColor: 'rgba(245, 158, 11, 0.18)',
                fill: true,
                tension: 0.35
              },
              {
                label: 'Avg Bead Move (s)',
                data: records.map(function (r) { return Number(((r.avgBeadMoveMs || 1200) / 1000).toFixed(2)); }),
                borderColor: '#059669',
                backgroundColor: 'rgba(16, 185, 129, 0.12)',
                fill: false,
                tension: 0.35
              }
            ]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { font: { size: 10, weight: 'bold' } } } } }
        });

        // 2. Grouped Bar Chart
        mountOrUpdateChart('seat_bar', 'dashChartSeatBar', {
          type: 'bar',
          data: {
            labels: ['Red (You)', 'Green', 'Yellow (Partner)', 'Blue'],
            datasets: [
              { label: 'Kills (شکار)', data: seatArr.map(function (x) { return x.kills; }), backgroundColor: '#e11d48' },
              { label: 'Home Completed', data: seatArr.map(function (x) { return x.homeCompleted; }), backgroundColor: '#059669' },
              { label: 'Spawns', data: seatArr.map(function (x) { return x.spawns; }), backgroundColor: '#f59e0b' }
            ]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { labels: { font: { size: 10, weight: 'bold' } } } } }
        });

        // 3. Doughnut Outcome Chart
        mountOrUpdateChart('outcome_doughnut', 'dashChartOutcomeDoughnut', {
          type: 'doughnut',
          data: {
            labels: ['Clean Sweeps 🧹', '2v2 Team Wins 🤝', 'Solo Wins 🏆', 'Losses'],
            datasets: [{
              data: [cleanSweepWins, standardTeamWins, soloWins, losses],
              backgroundColor: ['#4f46e5', '#10b981', '#f59e0b', '#f43f5e']
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 10, weight: 'bold' } } } } }
        });

        // 4. Radar Tactical Chart
        mountOrUpdateChart('tactical_radar', 'dashChartTacticalRadar', {
          type: 'radar',
          data: {
            labels: ['Shikari Kills', 'Move Speed', 'Clean Sweep', 'Close Lock', '2v2 Synergy', 'Dice Luck'],
            datasets: [{
              label: careerStats.playerName,
              data: radarScores,
              backgroundColor: 'rgba(245, 158, 11, 0.25)',
              borderColor: '#d97706',
              pointBackgroundColor: '#e11d48'
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, scales: { r: { suggestedMin: 0, suggestedMax: 100 } }, plugins: { legend: { display: false } } }
        });

        // 5. Polar Area Dice Chart
        mountOrUpdateChart('dice_polar', 'dashChartDicePolar', {
          type: 'polarArea',
          data: {
            labels: ['Face 1', 'Face 2', 'Face 3', 'Face 4', 'Face 5', 'Face 6 (🔥)'],
            datasets: [{
              data: [df[1] || 0, df[2] || 0, df[3] || 0, df[4] || 0, df[5] || 0, df[6] || 0],
              backgroundColor: [
                'rgba(100, 116, 139, 0.65)',
                'rgba(14, 165, 233, 0.65)',
                'rgba(168, 85, 247, 0.65)',
                'rgba(16, 185, 129, 0.65)',
                'rgba(245, 158, 11, 0.65)',
                'rgba(225, 29, 72, 0.80)'
              ]
            }]
          },
          options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 9, weight: 'bold' } } } } }
        });

        // 6. Stacked Timing Chart
        mountOrUpdateChart('timing_stacked', 'dashChartTimingStacked', {
          type: 'bar',
          data: {
            labels: ['Red (You)', 'Green', 'Yellow', 'Blue'],
            datasets: [
              {
                label: 'Avg Think/Decision (s)',
                data: seatArr.map(function (st) { return st.moves > 0 ? Number((st.totalDecisionMs / st.moves / 1000).toFixed(2)) : 1.05; }),
                backgroundColor: '#0284c7'
              },
              {
                label: 'Avg Hop Anim (s)',
                data: seatArr.map(function (st) { return st.moves > 0 ? Number((st.totalAnimMs / st.moves / 1000).toFixed(2)) : 0.22; }),
                backgroundColor: '#f59e0b'
              }
            ]
          },
          options: {
            indexAxis: 'y',
            responsive: true,
            maintainAspectRatio: false,
            scales: { x: { stacked: true }, y: { stacked: true } },
            plugins: { legend: { position: 'bottom', labels: { font: { size: 10, weight: 'bold' } } } }
          }
        });
      }

      function openChartDataInspectorModal(chartId) {
        renderInfographicsAndCharts();
        const ds = dashState.chartDatasetsCache[chartId] || dashState.chartDatasetsCache['full_reports'];
        if (!ds) return;
        dashState.currentInspectedChartId = chartId;
        document.getElementById('chartDataModalTitle').textContent = '📋 ' + ds.title;
        document.getElementById('chartDataModalSubtitle').textContent = 'Showing ' + ds.rows.length + ' verified source rows that derived this visual chart';

        const thHtml = ds.headers.map(function (h) {
          return '<th class="py-2 px-3 bg-slate-900 text-amber-300 font-black text-[10px] uppercase tracking-wider">' + h + '</th>';
        }).join('');
        const trHtml = ds.rows.map(function (row) {
          return '<tr class="border-b border-amber-100 hover:bg-amber-50/60">' +
            row.map(function (cell, idx) {
              return '<td class="py-2 px-3 text-xs ' + (idx === 0 ? 'font-bold text-slate-900' : 'font-mono text-slate-700') + '">' + cell + '</td>';
            }).join('') +
          '</tr>';
        }).join('');

        document.getElementById('chartDataModalTableWrap').innerHTML =
          '<table class="w-full text-left border-collapse"><thead><tr>' + thHtml + '</tr></thead><tbody>' + trHtml + '</tbody></table>';
        document.getElementById('chartDataInspectorModal').classList.remove('hidden');
      }

      function exportCurrentInspectedChartCsv() {
        const chartId = dashState.currentInspectedChartId || 'full_reports';
        const ds = dashState.chartDatasetsCache[chartId];
        if (!ds) return;
        const lines = [ds.headers.join(',')];
        ds.rows.forEach(function (r) {
          lines.push(r.map(function (c) { return '"' + String(c).replace(/"/g, '""') + '"'; }).join(','));
        });
        const blob = new Blob([lines.join('\n')], { type: 'text/csv;charset=utf-8;' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'bannu_ludo_chart_data_' + chartId + '.csv';
        a.click();
        URL.revokeObjectURL(url);
        showToast('⬇️ Downloaded CSV data for ' + ds.title + '!', true);
      }

      function exportComprehensiveExcelWorkbook() {
        ensureCareerStatsSchema();
        renderInfographicsAndCharts();
        if (!window.XLSX) {
          showToast('⚠️ Excel library loading — exporting CSV fallback.', true);
          exportCurrentInspectedChartCsv();
          return;
        }
        const wb = window.XLSX.utils.book_new();
        const xpInfo = computeCareerXpAndRank();
        const s = careerStats;
        const avgMoveSec = s.totalBeadMovesCount > 0 ? ((s.totalMoveDecisionMs + s.totalMoveAnimMs) / s.totalBeadMovesCount / 1000).toFixed(2) : '1.25';
        const avgTurnSec = s.totalTurnsCount > 0 ? (s.totalTurnTimeMs / s.totalTurnsCount / 1000).toFixed(2) : '4.30';

        // Sheet 1: Executive KPIs & Rank Summary
        const summaryRows = [
          ['BANNU ROYALE LUDO — EXECUTIVE ANALYTICS & TELEMETRY REPORT'],
          ['Generated At', new Date().toISOString(), 'Player Name', s.playerName],
          ['Official Rank', '#' + xpInfo.currentRank.tier + ' ' + xpInfo.currentRank.titleEn + ' (' + xpInfo.currentRank.titleUr + ')', 'Level & XP', 'Level ' + xpInfo.level + ' (' + xpInfo.xp + ' XP)'],
          [],
          ['Metric Category', 'KPI Name', 'Value', 'Notes'],
          ['Career Overview', 'Total Matches Played', s.matches, 'All formats combined'],
          ['Career Overview', 'Total Matches Won', s.wins, (s.matches > 0 ? Math.round((s.wins / s.matches) * 100) : 0) + '% Win Rate'],
          ['Flawless Achievement', 'Clean Sweep Victories (🧹)', s.cleanSweeps, 'Won while all opponents had 0 kills'],
          ['Combat Telemetry', 'Total Enemy Kills (شکار)', s.kills, 'Blood gate & field captures'],
          ['Combat Telemetry', 'Times Captured (Deaths)', s.deaths || 0, 'K/D Ratio: ' + (s.kills / Math.max(1, s.deaths || 1)).toFixed(2)],
          ['Bannu Rules', 'Close Game Bari Locks Triggered', s.totalCloseLocks || 0, 'Locked across bonus re-rolls in same Bari'],
          ['Bannu Rules', 'No-Kill Outer Blood Loops', s.totalOuterLoops || 0, 'Full 52-cell extra laps'],
          ['Team Play', '2v2 Team Wins', s.teamWins, 'Partner Assists: ' + (s.totalPartnerAssists || 0)],
          ['Timing Telemetry', 'Total Active Play Time', formatDurationMs(s.totalPlayTimeMs), 'Avg per match: ' + formatDurationMs(Math.round((s.totalPlayTimeMs || 0) / Math.max(1, s.matches)))],
          ['Timing Telemetry', 'Average Bead Movement Time', avgMoveSec + 's', 'Fastest Move: ' + ((s.fastestBeadMoveMs || 780) / 1000).toFixed(2) + 's'],
          ['Timing Telemetry', 'Average Bari Turn Time', avgTurnSec + 's', 'Across ' + (s.totalTurnsCount || 0) + ' Baris']
        ];
        const wsSummary = window.XLSX.utils.aoa_to_sheet(summaryRows);
        wsSummary['!cols'] = [{ wch: 24 }, { wch: 34 }, { wch: 26 }, { wch: 36 }];
        window.XLSX.utils.book_append_sheet(wb, wsSummary, 'Executive Summary');

        // Sheet 2: Match History Reports
        const matchHeaders = ['Match ID', 'Date', 'Rulebook & Mode', 'Format', 'Close Game', 'Result', 'Clean Sweep', 'Kills', 'Deaths', 'Close Locks', 'Outer Loops', 'Duration', 'Total Baris', 'Avg Bead Move (s)', 'Avg Bari Turn (s)'];
        const matchRows = [matchHeaders].concat(getFilteredSortedReportRecords().map(function (r) {
          return [
            r.matchId, r.date, r.mode, r.format, r.closeGameMode ? 'Close Game' : 'Open Game',
            r.result, r.isCleanSweep ? 'YES (Clean Sweep)' : 'NO', r.kills || 0, r.deaths || 0,
            r.closeLocks || 0, r.outerLoops || 0, formatDurationMs(r.durationMs), r.totalTurns || 0,
            Number(((r.avgBeadMoveMs || 1200) / 1000).toFixed(2)), Number(((r.avgTurnTimeMs || 4300) / 1000).toFixed(2))
          ];
        }));
        const wsMatches = window.XLSX.utils.aoa_to_sheet(matchRows);
        wsMatches['!cols'] = [{ wch: 12 }, { wch: 12 }, { wch: 32 }, { wch: 14 }, { wch: 14 }, { wch: 20 }, { wch: 18 }, { wch: 8 }, { wch: 8 }, { wch: 12 }, { wch: 12 }, { wch: 14 }, { wch: 12 }, { wch: 18 }, { wch: 18 }];
        window.XLSX.utils.book_append_sheet(wb, wsMatches, 'Match Reports');

        // Sheet 3: Per-Seat Player Telemetry
        const seatDs = dashState.chartDatasetsCache['seat_bar'];
        const wsSeats = window.XLSX.utils.aoa_to_sheet([seatDs.headers].concat(seatDs.rows));
        wsSeats['!cols'] = seatDs.headers.map(function () { return { wch: 18 }; });
        window.XLSX.utils.book_append_sheet(wb, wsSeats, 'Player Seat Telemetry');

        // Sheet 4: Granular Bead Movement Logs
        const moveHeaders = ['Match ID', 'Move #', 'Player Name', 'Color', 'Bead #', 'Delta', 'Outcome', 'Decision Time (ms)', 'Hop Anim Time (ms)', 'Full Move Time (s)', 'Timestamp'];
        const moveRows = [moveHeaders].concat((s.beadMoveLogs || []).map(function (ml) {
          return [ml.matchId || 'LIVE', ml.moveNo, ml.playerName, ml.colorName, ml.tokenId, ml.delta, ml.outcome, ml.decisionMs, ml.animMs, Number((ml.totalMoveMs / 1000).toFixed(2)), ml.ts || ''];
        }));
        const wsMoves = window.XLSX.utils.aoa_to_sheet(moveRows);
        wsMoves['!cols'] = moveHeaders.map(function () { return { wch: 18 }; });
        window.XLSX.utils.book_append_sheet(wb, wsMoves, 'Bead Movement Logs');

        // Sheet 5: 64 Achievements & Ranks
        const achHeaders = ['Badge ID', 'Category', 'Tier', 'XP Reward', 'Title (EN)', 'Title (UR)', 'Requirement', 'Current Progress', 'Target', 'Status'];
        const achRows = [achHeaders].concat(evaluateAll64Achievements().map(function (a) {
          return [a.id, a.cat, a.tier, a.xp, a.title, a.titleUr, a.desc, a.cur, a.target, a.unlocked ? 'UNLOCKED' : 'IN PROGRESS'];
        }));
        const wsAch = window.XLSX.utils.aoa_to_sheet(achRows);
        wsAch['!cols'] = [{ wch: 10 }, { wch: 14 }, { wch: 10 }, { wch: 10 }, { wch: 28 }, { wch: 24 }, { wch: 38 }, { wch: 16 }, { wch: 10 }, { wch: 14 }];
        window.XLSX.utils.book_append_sheet(wb, wsAch, '64 Achievements');

        // Copyright metadata (document properties)
        wb.Props = wb.Props || {};
        wb.Props.Title = 'Bannu Royale Ludo — Analytics & Telemetry Report';
        wb.Props.Subject = 'Proprietary report — All Rights Reserved';
        wb.Props.Author = 'Yasin Ullah (Bannu Software Solutions)';
        wb.Props.Company = 'Bannu Software Solutions';
        wb.Props.Comments = '© 2026 Yasin Ullah — Bannu Software Solutions. All Rights Reserved. This report and the software that produced it are proprietary. Unauthorized copying, modification, reuse or distribution is strictly prohibited.';

        window.XLSX.writeFile(wb, 'bannu_royale_ludo_analytics_' + new Date().toISOString().slice(0, 10) + '.xlsx');
        showToast('📊 Downloaded Pretty-Formatted Multi-Sheet Excel (.xlsx) Report!', true);
      }

      function exportComprehensivePdfReport() {
        ensureCareerStatsSchema();
        renderInfographicsAndCharts();
        const xpInfo = computeCareerXpAndRank();
        const s = careerStats;
        const avgMoveSec = s.totalBeadMovesCount > 0 ? ((s.totalMoveDecisionMs + s.totalMoveAnimMs) / s.totalBeadMovesCount / 1000).toFixed(2) : '1.25';
        const avgTurnSec = s.totalTurnsCount > 0 ? (s.totalTurnTimeMs / s.totalTurnsCount / 1000).toFixed(2) : '4.30';

        if (window.jspdf && window.jspdf.jsPDF) {
          const doc = new window.jspdf.jsPDF({ orientation: 'landscape', unit: 'pt', format: 'a4' });
          doc.setFillColor(15, 23, 42);
          doc.rect(0, 0, 842, 68, 'F');
          doc.setTextColor(251, 191, 36);
          doc.setFontSize(18);
          doc.text('BANNU ROYALE LUDO — EXECUTIVE ANALYTICS & TELEMETRY REPORT', 32, 34);
          doc.setTextColor(226, 232, 240);
          doc.setFontSize(10);
          doc.text('Player: ' + s.playerName + '  |  Rank: #' + xpInfo.currentRank.tier + ' ' + xpInfo.currentRank.titleEn + '  |  Level ' + xpInfo.level + ' (' + xpInfo.xp + ' XP)  |  Date: ' + new Date().toISOString().slice(0, 10), 32, 52);

          const kpiBody = [
            ['Matches Played', String(s.matches), 'Matches Won', s.wins + ' (' + (s.matches > 0 ? Math.round((s.wins / s.matches) * 100) : 0) + '%)', 'Clean Sweeps', String(s.cleanSweeps)],
            ['Total Kills', String(s.kills), 'Close Game Locks', String(s.totalCloseLocks || 0), 'Double Sixes (6+6)', String(s.doubleSixes)],
            ['Total Play Time', formatDurationMs(s.totalPlayTimeMs), 'Avg Bead Move Time', avgMoveSec + 's', 'Avg Bari Turn Time', avgTurnSec + 's']
          ];
          if (doc.autoTable) {
            doc.autoTable({
              startY: 82,
              head: [['KPI Metric', 'Value', 'KPI Metric', 'Value', 'KPI Metric', 'Value']],
              body: kpiBody,
              theme: 'grid',
              headStyles: { fillColor: [217, 119, 6], textColor: 255, fontSize: 9 },
              styles: { fontSize: 9, cellPadding: 5 }
            });

            const matchRows = getFilteredSortedReportRecords().map(function (r) {
              return [
                r.matchId, r.date, String(r.mode || '').replace(/[^\x20-\x7E]/g, '').trim() || 'Bannu 2-Dice',
                r.format, r.isCleanSweep ? 'CLEAN SWEEP' : (r.won ? 'WON' : 'LOST'),
                String(r.kills || 0), String(r.closeLocks || 0),
                formatDurationMs(r.durationMs), ((r.avgBeadMoveMs || 1200) / 1000).toFixed(2) + 's', ((r.avgTurnTimeMs || 4300) / 1000).toFixed(2) + 's'
              ];
            });
            doc.autoTable({
              startY: doc.lastAutoTable.finalY + 16,
              head: [['Match ID', 'Date', 'Rulebook', 'Format', 'Result', 'Kills', 'Locks', 'Duration', 'Avg Move', 'Avg Turn']],
              body: matchRows,
              theme: 'striped',
              headStyles: { fillColor: [15, 23, 42], textColor: [251, 191, 36], fontSize: 9 },
              styles: { fontSize: 8.5, cellPadding: 4 }
            });

            const seatRows = (s.seatStats || []).map(function (st) {
              return [
                st.color, String(st.matches), String(st.wins), String(st.kills), String(st.deaths),
                String(st.homeCompleted), (st.moves > 0 ? ((st.totalDecisionMs + st.totalAnimMs) / st.moves / 1000).toFixed(2) : '1.25') + 's',
                (st.turns > 0 ? (st.totalTurnMs / st.turns / 1000).toFixed(2) : '4.30') + 's', formatDurationMs(st.totalGameTimeMs)
              ];
            });
            doc.autoTable({
              startY: doc.lastAutoTable.finalY + 16,
              head: [['Seat Color', 'Matches', 'Wins', 'Kills', 'Deaths', 'Home Beads', 'Avg Bead Move', 'Avg Bari Turn', 'Full Game Time']],
              body: seatRows,
              theme: 'grid',
              headStyles: { fillColor: [5, 150, 105], textColor: 255, fontSize: 9 },
              styles: { fontSize: 8.5, cellPadding: 4 }
            });

            // Proprietary copyright footer on the report page
            const __pageH = doc.internal.pageSize.getHeight();
            const __pageW = doc.internal.pageSize.getWidth();
            doc.setTextColor(120, 113, 108);
            doc.setFontSize(7);
            doc.text('© 2026 Yasin Ullah — Bannu Software Solutions. All Rights Reserved.  Proprietary report: unauthorized copying, modification or reuse is strictly prohibited.', 32, __pageH - 12, { maxWidth: __pageW - 64 });
          }
          doc.save('bannu_royale_ludo_report_' + new Date().toISOString().slice(0, 10) + '.pdf');
          showToast('📄 Downloaded Official Multi-Table PDF Report!', true);
        } else {
          window.print();
        }
      }

      function switchDashboardSubTab(tabKey) {
        dashState.activeSubTab = tabKey;
        const panes = ['overview', 'reports', 'telemetry', 'progression', 'superadmin', 'vault'];
        panes.forEach(function (k) {
          const el = document.getElementById('dashPane_' + k);
          if (el) el.classList.toggle('hidden', k !== tabKey);
        });
        document.querySelectorAll('.dash-subtab-btn').forEach(function (btn) {
          const active = btn.dataset.dashtab === tabKey;
          btn.className = 'dash-subtab-btn px-3 py-2 rounded-2xl text-xs transition ' +
            (active ? 'font-black bg-amber-500 text-white shadow border border-amber-600' : 'font-bold bg-white text-slate-700 border border-amber-200 hover:bg-amber-50');
        });
        if (tabKey === 'overview') renderInfographicsAndCharts();
        if (tabKey === 'reports') renderReportsTableAndPagination();
        if (tabKey === 'telemetry') renderTelemetryTab();
        if (tabKey === 'progression') renderProgressionTab();
        if (tabKey === 'superadmin') renderSuperAdminTab();
        if (tabKey === 'vault') drawStatsPictureCard();
      }

      function applyDashboardRoleVisibility(role) {
        dashState.activeRole = role || 'super_admin';
        careerStats.role = dashState.activeRole;
        const roleBadge = document.getElementById('dashActiveRoleBadge');
        const superAdminBtn = document.getElementById('dashTabSuperAdminBtn');
        if (roleBadge) {
          roleBadge.textContent = dashState.activeRole === 'super_admin' ? 'SUPER ADMIN' : (dashState.activeRole === 'analyst' ? 'ANALYST & REFEREE' : 'PLAYER VIEW');
        }
        if (superAdminBtn) {
          superAdminBtn.classList.toggle('hidden', dashState.activeRole === 'player');
        }
        if (dashState.activeRole === 'player' && dashState.activeSubTab === 'superadmin') {
          switchDashboardSubTab('overview');
        }
      }

      function renderStatsView() {
        ensureCareerStatsSchema();
        const s = careerStats;
        const xpInfo = computeCareerXpAndRank();
        const allBadges = evaluateAll64Achievements();
        const unlockedCount = allBadges.filter(function (b) { return b.unlocked; }).length;

        const nameInp = document.getElementById('profileNameInput');
        if (nameInp) nameInp.value = s.playerName;
        const mEl = document.getElementById('statMatches');
        if (mEl) mEl.textContent = String(s.matches);
        const wEl = document.getElementById('statWins');
        if (wEl) wEl.textContent = String(s.wins);
        const kEl = document.getElementById('statKills');
        if (kEl) kEl.textContent = String(s.kills);
        const d6El = document.getElementById('statDoubleSixes');
        if (d6El) d6El.textContent = String(s.doubleSixes);
        const rate = s.matches > 0 ? Math.round((s.wins / s.matches) * 100) : 0;
        const wrEl = document.getElementById('statWinRate');
        if (wrEl) wrEl.textContent = rate + '%';
        const twEl = document.getElementById('statTeamWins');
        if (twEl) twEl.textContent = String(s.teamWins);
        const hwEl = document.getElementById('statHardAiWins');
        if (hwEl) hwEl.textContent = String(s.hardAiWins);
        const stEl = document.getElementById('statStreak');
        if (stEl) stEl.textContent = s.streak + ' 🔥';
        const bstEl = document.getElementById('kpiSubBestStreak');
        if (bstEl) bstEl.textContent = 'Best: ' + (s.bestStreak || s.streak || 0) + ' 🔥';

        // Extended Hero & KPI Readouts
        const avgMoveSec = s.totalBeadMovesCount > 0 ? ((s.totalMoveDecisionMs + s.totalMoveAnimMs) / s.totalBeadMovesCount / 1000).toFixed(2) + 's' : '1.25s';
        const avgTurnSec = s.totalTurnsCount > 0 ? (s.totalTurnTimeMs / s.totalTurnsCount / 1000).toFixed(2) + 's' : '4.30s';
        const avgGameDur = s.matches > 0 ? formatDurationMs(Math.round((s.totalPlayTimeMs || 0) / s.matches)) : '5m 30s';

        const setTxt = function (id, val) {
          const el = document.getElementById(id);
          if (el) el.textContent = val;
        };
        setTxt('dashRankCrestIcon', xpInfo.currentRank.icon);
        setTxt('dashLevelPill', 'LVL ' + xpInfo.level);
        setTxt('dashRankTitleEn', '#' + xpInfo.currentRank.tier + ' ' + xpInfo.currentRank.titleEn);
        setTxt('dashRankTitleUr', xpInfo.currentRank.titleUr);
        setTxt('dashRankNextInfo', 'Perk: ' + xpInfo.currentRank.perk + ' • Next Rank: ' + xpInfo.nextRank.titleEn);
        setTxt('dashXpCurrentText', xpInfo.xp + ' XP');
        setTxt('dashPrestigeBadge', '⭐ Prestige ' + xpInfo.prestige);
        setTxt('dashXpTargetText', 'Next Level: ' + xpInfo.nextLevelXp + ' XP');
        const xpBar = document.getElementById('dashXpProgressBar');
        if (xpBar) xpBar.style.width = xpInfo.levelProgressPct + '%';

        setTxt('heroStatCleanSweeps', (s.cleanSweeps || 0) + ' 🧹');
        setTxt('heroStatAvgMoveTime', avgMoveSec);
        setTxt('heroStatAvgTurnTime', avgTurnSec);
        setTxt('heroStatAvgGameTime', avgGameDur);
        setTxt('heroStatCloseLocks', (s.totalCloseLocks || 0) + ' 🔒');
        setTxt('heroStatBadgesCount', unlockedCount + ' / ' + allBadges.length);

        setTxt('kpiCleanSweeps', (s.cleanSweeps || 0) + ' 🧹');
        setTxt('kpiTotalPlayTime', formatDurationMs(s.totalPlayTimeMs || 0));
        setTxt('kpiAvgMatchTimeSub', 'Avg: ' + avgGameDur + '/game');
        setTxt('kpiAvgBeadMoveMs', avgMoveSec);
        setTxt('kpiFastestMoveSub', 'Fastest: ' + ((s.fastestBeadMoveMs || 780) / 1000).toFixed(2) + 's');
        setTxt('kpiAvgTurnTimeSec', avgTurnSec);
        setTxt('kpiTotalTurnsSub', (s.totalTurnsCount || 0) + ' Total Baris');
        setTxt('kpiKillDeathRatio', (s.kills / Math.max(1, s.deaths || 1)).toFixed(2));
        setTxt('kpiDeathsSub', (s.deaths || 0) + ' Losses to Yard');
        setTxt('kpiCloseLocksCount', (s.totalCloseLocks || 0) + ' 🔒');
        setTxt('kpiOuterLoopsCount', (s.totalOuterLoops || 0) + ' 🔄');
        setTxt('kpiTotalStepsMoved', String(s.totalStepsMoved || 0));
        setTxt('kpiTotalSpawnsSub', (s.totalSpawns || 0) + ' Spawns • ' + (s.totalHomeCompleted || 0) + ' Home');

        // Classic Vault Featured Achievements Grid
        const achGrid = document.getElementById('achievementsGrid');
        if (achGrid) {
          const featured = allBadges.slice(0, 12);
          achGrid.innerHTML = featured.map(function (a) {
            return '<div class="p-2 rounded-xl border ' +
              (a.unlocked ? 'bg-amber-100/90 border-amber-500 text-slate-950' : 'bg-slate-100 border-slate-300 text-slate-700') + '">' +
              '<div class="font-bold text-[11px]">' + a.icon + ' ' + a.title + (a.unlocked ? ' ✓' : '') + '</div>' +
              '<div class="text-[10px] font-medium">' + a.desc + ' (' + a.cur + '/' + a.target + ')</div>' +
            '</div>';
          }).join('');
        }

        const histEl = document.getElementById('matchHistoryContainer');
        if (histEl) {
          const list = s.history || [];
          if (list.length === 0) {
            histEl.innerHTML = '<div class="text-slate-400 italic">No matches recorded yet.</div>';
          } else {
            histEl.innerHTML = list.slice(0, 15).map(function (h, idx) {
              const mId = h.matchId || ((careerStats.matchRecords && careerStats.matchRecords[idx]) ? careerStats.matchRecords[idx].matchId : '');
              return '<div class="px-2.5 py-1.5 rounded-xl bg-amber-50/70 border border-amber-200 flex items-center justify-between gap-2">' +
                '<span class="truncate"><b>' + h.mode + '</b> <span class="text-slate-500">(' + h.date + ')</span></span>' +
                '<div class="flex items-center gap-1.5 flex-shrink-0">' +
                  '<span class="font-bold text-amber-900">' + h.result + ' • ⚔️' + h.kills + '</span>' +
                  (mId ? '<button type="button" data-match-id="' + mId + '" class="hist-replay-btn px-2 py-0.5 rounded-lg bg-rose-600 hover:bg-rose-500 text-white font-black text-[10px]">🎬 Replay</button>' : '') +
                '</div>' +
              '</div>';
            }).join('');
            histEl.querySelectorAll('.hist-replay-btn').forEach(function (btn) {
              btn.addEventListener('click', function () {
                openReplayStudio(btn.dataset.matchId);
              });
            });
          }
        }

        renderInfographicsAndCharts();
        renderReportsTableAndPagination();
        renderTelemetryTab();
        renderProgressionTab();
        renderSuperAdminTab();
        drawStatsPictureCard();
      }

      function drawStatsPictureCard() {
        const c = document.getElementById('statsCardCanvas');
        if (!c) return;
        ensureCareerStatsSchema();
        const xpInfo = computeCareerXpAndRank();
        const g = c.getContext('2d');
        const W = c.width;
        const H = c.height;

        const grad = g.createLinearGradient(0, 0, W, H);
        grad.addColorStop(0, '#fffbeb');
        grad.addColorStop(0.5, '#fef3c7');
        grad.addColorStop(1, '#fde68a');
        g.fillStyle = grad;
        g.fillRect(0, 0, W, H);

        g.strokeStyle = '#d97706';
        g.lineWidth = 5;
        g.strokeRect(14, 14, W - 28, H - 28);

        g.fillStyle = '#b45309';
        g.font = '900 19px Inter, sans-serif';
        g.fillText('🎲 BANNU ROYALE LUDO — OFFICIAL CAREER & TELEMETRY CARD', 30, 48);

        g.fillStyle = '#0f172a';
        g.font = '900 26px Inter, sans-serif';
        g.fillText(careerStats.playerName + '  [LVL ' + xpInfo.level + ']', 30, 84);

        const rate = careerStats.matches > 0 ? Math.round((careerStats.wins / careerStats.matches) * 100) : 0;
        const avgMv = careerStats.totalBeadMovesCount > 0 ? ((careerStats.totalMoveDecisionMs + careerStats.totalMoveAnimMs) / careerStats.totalBeadMovesCount / 1000).toFixed(2) + 's' : '1.25s';
        g.fillStyle = '#0369a1';
        g.font = '700 14px Inter, sans-serif';
        g.fillText('Rank #' + xpInfo.currentRank.tier + ': ' + xpInfo.currentRank.titleEn + '  •  Win Rate: ' + rate + '%  •  Avg Move: ' + avgMv, 30, 112);

        const boxes = [
          { label: 'MATCHES WON / CLEAN SWEEPS', val: careerStats.wins + '/' + careerStats.matches + ' (🧹' + (careerStats.cleanSweeps || 0) + ')', col: '#059669' },
          { label: 'ENEMY KILLS (شکار) & LOCKS', val: '⚔️' + careerStats.kills + '  🔒' + (careerStats.totalCloseLocks || 0), col: '#e11d48' },
          { label: 'DOUBLE SIXES (6+6) & XP', val: '🔥' + careerStats.doubleSixes + '  ⭐' + xpInfo.xp + ' XP', col: '#d97706' },
          { label: '2v2 TEAM WINS & PLAY TIME', val: '🤝' + careerStats.teamWins + '  ⏱️' + formatDurationMs(careerStats.totalPlayTimeMs), col: '#7c3aed' }
        ];

        boxes.forEach(function (bx, i) {
          const x = 30 + (i % 2) * 272;
          const y = 136 + Math.floor(i / 2) * 92;
          g.fillStyle = '#ffffff';
          g.fillRect(x, y, 256, 76);
          g.strokeStyle = bx.col;
          g.lineWidth = 2.5;
          g.strokeRect(x, y, 256, 76);

          g.fillStyle = '#64748b';
          g.font = '700 11px Inter, sans-serif';
          g.fillText(bx.label, x + 14, y + 25);

          g.fillStyle = bx.col;
          g.font = '900 22px Inter, sans-serif';
          g.fillText(bx.val, x + 14, y + 56);
        });

        g.fillStyle = '#92400e';
        g.font = '700 12px Inter, sans-serif';
        g.fillText('Authentic Bannu 2-Dice • Close Bari Lock • Clean Sweep Victory • Full Telemetry', 30, 338);

        g.fillStyle = '#b45309';
        g.font = '800 12px Inter, sans-serif';
        g.fillText('💛 Created by Yasin Ullah  •  Dedicated to my little brother Muhib Ullah', 30, 360);

        g.fillStyle = '#78350f';
        g.font = '700 10px Inter, sans-serif';
        g.fillText('© 2026 Yasin Ullah — Bannu Software Solutions. All Rights Reserved.', 30, 374);
      }

      // --- 14B. FULL-SCREEN MOBILE-FIRST GAME REPLAY STUDIO ENGINE ---
      let replayState = {
        isOpen: false,
        wasMatchPausedBeforeOpen: false,
        activeMatchId: 'LIVE',
        frames: [],
        rulesSnap: null,
        matchMeta: null,
        currentFrameIdx: 0,
        isPlaying: false,
        speed: 1,
        loop: false,
        sound: true,
        showTrail: true,
        boardRotationDeg: 0,
        playTimer: null,
        hopAnimTimer: null,
        animTokenOverride: null
      };

      function encodePlayersStateForReplay(playersArr) {
        const stMap = { yard: 0, board: 1, home_stretch: 2, completed: 3 };
        return (playersArr || []).map(function (pl, idx) {
          return {
            id: idx,
            name: pl ? pl.name : PLAYER_META[idx].colorName,
            active: pl ? Boolean(pl.active) : true,
            kills: pl ? (pl.kills || 0) : 0,
            assistUnlocked: pl ? Boolean(pl.assistUnlocked) : false,
            tokens: (pl && pl.tokens ? pl.tokens : []).map(function (tk) {
              return [
                stMap[tk.state] !== undefined ? stMap[tk.state] : 0,
                tk.steps || 0,
                tk.homeStep || 0,
                tk.lockedThisTurn ? 1 : 0
              ];
            })
          };
        });
      }

      function decodePlayersStateFromReplay(encodedPlayers, tokensPerPlayer) {
        const revMap = ['yard', 'board', 'home_stretch', 'completed'];
        const count = tokensPerPlayer || 4;
        return [0, 1, 2, 3].map(function (idx) {
          const ep = (encodedPlayers && encodedPlayers[idx]) ? encodedPlayers[idx] : null;
          const meta = PLAYER_META[idx];
          const tks = [];
          for (let t = 0; t < count; t++) {
            const rawTk = (ep && ep.tokens && ep.tokens[t]) ? ep.tokens[t] : [0, 0, 0, 0];
            tks.push({
              owner: idx,
              id: t,
              state: revMap[rawTk[0]] || 'yard',
              steps: rawTk[1] || 0,
              homeStep: rawTk[2] || 0,
              lockedThisTurn: Boolean(rawTk[3]),
              animCoords: null
            });
          }
          return {
            id: idx,
            name: ep ? ep.name : meta.colorName,
            active: ep ? Boolean(ep.active) : true,
            team: meta.team,
            partner: meta.partner,
            kills: ep ? (ep.kills || 0) : 0,
            assistUnlocked: ep ? Boolean(ep.assistUnlocked) : false,
            tokens: tks
          };
        });
      }

      function recordLiveReplayFrame(opts) {
        if (!gameState.players || gameState.players.length !== 4) return;
        if (!Array.isArray(gameState.replayFrames)) gameState.replayFrames = [];
        const now = Date.now();
        const startedAt = (gameState.matchTelemetry && gameState.matchTelemetry.startedAt) ? gameState.matchTelemetry.startedAt : now;
        const frame = {
          frameIdx: gameState.replayFrames.length,
          type: (opts && opts.type) || 'MOVE',
          turn: gameState.currentTurn || 0,
          actorIdx: (opts && opts.actorIdx !== undefined) ? opts.actorIdx : (gameState.currentTurn || 0),
          ownerIdx: (opts && opts.ownerIdx !== undefined) ? opts.ownerIdx : (gameState.currentTurn || 0),
          tokenId: (opts && opts.tokenId !== undefined) ? opts.tokenId : null,
          delta: (opts && opts.delta) || 0,
          dicePool: JSON.parse(JSON.stringify(gameState.dicePool || [])),
          title: (opts && opts.title) || 'Board Update',
          subtitle: (opts && opts.subtitle) || '',
          elapsedMs: Math.max(0, now - startedAt),
          ts: new Date(now).toLocaleTimeString(),
          trail: (opts && opts.trail) ? opts.trail : null,
          players: encodePlayersStateForReplay(gameState.players)
        };
        gameState.replayFrames.push(frame);
      }

      function computeReplayPathCoordsForMove(ownerIdx, startState, startSteps, startHomeStep, delta, eligibleHome) {
        if (startState === 'yard' || startState === 0) {
          return [MAIN_TRACK[START_TRACK_INDEX[ownerIdx]]];
        }
        const coords = [];
        let curState = (startState === 2 || startState === 'home_stretch') ? 'home_stretch' : 'board';
        let curSteps = startSteps || 0;
        let curHomeStep = startHomeStep || 0;
        for (let s = 1; s <= delta; s++) {
          if (curState === 'home_stretch') {
            curHomeStep = Math.min(6, curHomeStep + 1);
            coords.push(HOME_PATHS[ownerIdx][Math.min(5, curHomeStep - 1)]);
          } else {
            const posInLap = curSteps % 52;
            if (posInLap === 50 && eligibleHome) {
              curState = 'home_stretch';
              curHomeStep = 1;
              coords.push(HOME_PATHS[ownerIdx][0]);
            } else {
              curSteps += 1;
              const tIdx = (START_TRACK_INDEX[ownerIdx] + curSteps) % 52;
              coords.push(MAIN_TRACK[tIdx]);
            }
          }
        }
        return coords;
      }

      function ensureReplayFramesForRecord(rec) {
        if (!rec) return [];
        if (Array.isArray(rec.replayFrames) && rec.replayFrames.length > 1) {
          return rec.replayFrames;
        }
        const is2Dice = rec.rulebookType !== 'yalla';
        const pSum = Array.isArray(rec.playersSummary) && rec.playersSummary.length === 4
          ? rec.playersSummary
          : [0, 1, 2, 3].map(function (i) {
              return { seat: i, name: PLAYER_META[i].colorName, color: PLAYER_META[i].colorName, active: true, kills: i === 0 ? (rec.kills || 2) : 1, homeCompleted: i === 0 ? 4 : 2 };
            });
        const simPlayers = [0, 1, 2, 3].map(function (i) {
          const ps = pSum[i] || {};
          return {
            id: i,
            name: ps.name || PLAYER_META[i].colorName,
            active: ps.active !== false,
            kills: 0,
            assistUnlocked: false,
            tokens: [0, 1, 2, 3].map(function (t) {
              return { owner: i, id: t, state: 'yard', steps: 0, homeStep: 0, lockedThisTurn: false };
            })
          };
        });

        const frames = [];
        let elapsed = 0;
        function pushSimFrame(type, turn, actorIdx, ownerIdx, tokenId, delta, dicePool, title, subtitle, trail) {
          frames.push({
            frameIdx: frames.length,
            type: type,
            turn: turn,
            actorIdx: actorIdx,
            ownerIdx: ownerIdx,
            tokenId: tokenId,
            delta: delta,
            dicePool: dicePool,
            title: title,
            subtitle: subtitle,
            elapsedMs: elapsed,
            ts: 'Step ' + frames.length,
            trail: trail,
            players: encodePlayersStateForReplay(simPlayers)
          });
        }

        pushSimFrame('START', 0, 0, 0, null, 0, [{ id: 0, value: 6, used: true }, { id: 1, value: 6, used: true }], '🏁 Match Started — ' + (rec.mode || 'Bannu Royale Ludo'), (rec.format || '2v2 Teams') + ' • ' + (rec.date || ''), null);

        const activeSeats = [0, 1, 2, 3].filter(function (i) { return simPlayers[i].active; });
        let seed = 0;
        const idStr = String(rec.matchId || 'M-100');
        for (let c = 0; c < idStr.length; c++) seed = (seed * 31 + idStr.charCodeAt(c)) % 9973;
        function nextRand(max) {
          seed = (seed * 1103515245 + 12345) & 0x7fffffff;
          return (seed % max) + 1;
        }

        // Phase 1: Spawn & tactical board progression
        const totalRounds = 9;
        for (let r = 0; r < totalRounds; r++) {
          for (let sIdx = 0; sIdx < activeSeats.length; sIdx++) {
            const pIdx = activeSeats[sIdx];
            const pl = simPlayers[pIdx];
            const targetHome = (pSum[pIdx] && pSum[pIdx].homeCompleted !== undefined) ? pSum[pIdx].homeCompleted : 2;
            const targetKills = (pSum[pIdx] && pSum[pIdx].kills !== undefined) ? pSum[pIdx].kills : 1;

            elapsed += 6500 + nextRand(3500);
            let d1 = r < 2 ? 6 : nextRand(6);
            let d2 = is2Dice ? (r === 0 ? nextRand(5) : nextRand(6)) : 0;
            const diceArr = is2Dice
              ? [{ id: 0, value: d1, used: false }, { id: 1, value: d2, used: false }]
              : [{ id: 0, value: d1, used: false }];
            const rollText = is2Dice ? (d1 + ' & ' + d2 + ' (Total ' + (d1 + d2) + ')') : String(d1);
            pushSimFrame('ROLL', pIdx, pIdx, pIdx, null, is2Dice ? (d1 + d2) : d1, JSON.parse(JSON.stringify(diceArr)), '🎲 ' + pl.name + ' rolled ' + rollText, 'Bari Roll • ' + PLAYER_META[pIdx].colorName, null);

            elapsed += 1200;
            const yardTk = pl.tokens.find(function (t) { return t.state === 'yard'; });
            if (yardTk && (d1 === 6 || d2 === 6 || r < 2)) {
              const startRC = YARD_SLOTS[pIdx][yardTk.id].slice();
              yardTk.state = 'board';
              yardTk.steps = 0;
              const endRC = MAIN_TRACK[START_TRACK_INDEX[pIdx]].slice();
              diceArr[0].used = true;
              pushSimFrame('SPAWN', pIdx, pIdx, pIdx, yardTk.id, 6, JSON.parse(JSON.stringify(diceArr)), '⚡ ' + pl.name + ' spawned Bead #' + (yardTk.id + 1) + ' (+6)', 'Brought out from Yard onto Start Stop', {
                ownerIdx: pIdx,
                tokenId: yardTk.id,
                startRC: startRC,
                endRC: endRC,
                pathCoords: [endRC],
                delta: 6
              });
            }

            const boardTks = pl.tokens.filter(function (t) { return t.state === 'board' || t.state === 'home_stretch'; });
            if (boardTks.length > 0) {
              const mvTk = boardTks[r % boardTks.length];
              const prevState = mvTk.state;
              const prevSteps = mvTk.steps;
              const prevHome = mvTk.homeStep;
              const startRC = (prevState === 'home_stretch' ? HOME_PATHS[pIdx][prevHome - 1] : MAIN_TRACK[(START_TRACK_INDEX[pIdx] + prevSteps) % 52]).slice();
              const stepDelta = is2Dice ? (d1 === 6 && yardTk ? d2 : (d1 + d2)) : d1;
              const moveDelta = Math.max(2, stepDelta || 4);
              const pathCoords = computeReplayPathCoordsForMove(pIdx, prevState, prevSteps, prevHome, moveDelta, true);
              const endRC = pathCoords.length > 0 ? pathCoords[pathCoords.length - 1] : startRC;
              diceArr.forEach(function (d) { d.used = true; });

              let evType = 'MOVE';
              let titleStr = pl.name + ' moved Bead #' + (mvTk.id + 1) + ' (+' + moveDelta + ')';
              let subStr = 'Think: ' + ((900 + nextRand(500)) / 1000).toFixed(2) + 's • Hop: 0.22s';

              if (pl.kills < targetKills && r >= 2 && mvTk.state === 'board') {
                const victimSeat = activeSeats.find(function (as) { return as !== pIdx && (!rec.formatCode || rec.formatCode !== '2v2' || PLAYER_META[as].team !== PLAYER_META[pIdx].team); });
                if (victimSeat !== undefined) {
                  const vPl = simPlayers[victimSeat];
                  const vTk = vPl.tokens.find(function (vt) { return vt.state === 'board'; });
                  if (vTk) {
                    vTk.state = 'yard';
                    vTk.steps = 0;
                    pl.kills += 1;
                    evType = 'KILL';
                    titleStr = '⚔️ ' + pl.name + ' killed ' + vPl.name + ' (Bead #' + (vTk.id + 1) + ')!';
                    subStr = 'Blood Gate Hunt (+' + moveDelta + ') • Total Kills: ' + pl.kills;
                  }
                }
              }

              const doneNow = pl.tokens.filter(function (t) { return t.state === 'completed'; }).length;
              if (r >= 5 && doneNow < targetHome) {
                mvTk.state = 'completed';
                mvTk.steps = 50;
                mvTk.homeStep = 6;
                const homeEndRC = HOME_PATHS[pIdx][5].slice();
                pathCoords.push(homeEndRC);
                evType = 'HOME';
                titleStr = '🏠 ' + pl.name + ' completed Bead #' + (mvTk.id + 1) + ' into Home!';
                subStr = 'Home Goal Reached (' + (doneNow + 1) + '/' + (rec.rulesSnapshot ? rec.rulesSnapshot.tokensPerPlayer : 4) + ')';
              } else {
                const nextSteps = prevSteps + moveDelta;
                if (nextSteps >= 51 && pl.kills > 0) {
                  mvTk.state = 'home_stretch';
                  mvTk.steps = 50;
                  mvTk.homeStep = Math.min(5, nextSteps - 50);
                } else {
                  mvTk.state = 'board';
                  mvTk.steps = nextSteps % 50;
                }
              }

              pushSimFrame(evType, pIdx, pIdx, pIdx, mvTk.id, moveDelta, JSON.parse(JSON.stringify(diceArr)), titleStr, subStr, {
                ownerIdx: pIdx,
                tokenId: mvTk.id,
                startRC: startRC,
                endRC: pathCoords[pathCoords.length - 1] || endRC,
                pathCoords: pathCoords,
                delta: moveDelta
              });
            }
          }
        }

        // Sync final frame counts with exact record summary
        activeSeats.forEach(function (i) {
          const ps = pSum[i];
          if (!ps) return;
          simPlayers[i].kills = ps.kills || 0;
          const hCount = Math.min(4, ps.homeCompleted || 0);
          for (let t = 0; t < hCount; t++) {
            simPlayers[i].tokens[t].state = 'completed';
            simPlayers[i].tokens[t].steps = 50;
            simPlayers[i].tokens[t].homeStep = 6;
          }
        });
        elapsed = rec.durationMs || elapsed;
        pushSimFrame('VICTORY', 0, 0, 0, null, 0, [{ id: 0, value: 6, used: true }], '👑 Match Finished — ' + (rec.result || 'Victory!'), (rec.mode || '') + ' • Duration: ' + formatDurationMs(elapsed), null);
        rec.replayFrames = frames;
        return frames;
      }

      function getAvailableReplaySources() {
        ensureCareerStatsSchema();
        const sources = [];
        if (Array.isArray(gameState.replayFrames) && gameState.replayFrames.length > 0) {
          sources.push({
            id: 'LIVE',
            label: '🔴 Current Match (' + gameState.replayFrames.length + ' steps)',
            mode: rulesConfig.presetName,
            format: rulesConfig.teamMode ? '2v2 Teams' : 'FFA / Duel',
            rulesSnap: {
              presetName: rulesConfig.presetName,
              diceCount: rulesConfig.diceCount,
              tokensPerPlayer: rulesConfig.tokensPerPlayer,
              closeGameMode: Boolean(rulesConfig.closeGameMode),
              teamMode: Boolean(rulesConfig.teamMode),
              killRequiredForHome: Boolean(rulesConfig.killRequiredForHome),
              twoKillsForHome: Boolean(rulesConfig.twoKillsForHome),
              pairBlockadeRule: Boolean(rulesConfig.pairBlockadeRule)
            },
            frames: gameState.replayFrames
          });
        }
        (careerStats.matchRecords || []).forEach(function (rec) {
          const frames = ensureReplayFramesForRecord(rec);
          sources.push({
            id: rec.matchId,
            label: '📜 ' + rec.matchId + ' • ' + (rec.result || 'Match') + ' (' + (rec.date || '') + ')',
            mode: rec.mode || 'Bannu 2-Dice',
            format: rec.format || '2v2 Teams',
            rulesSnap: rec.rulesSnapshot || {
              presetName: rec.mode || 'Bannu Rules',
              diceCount: rec.rulebookType === 'yalla' ? 1 : 2,
              tokensPerPlayer: 4,
              closeGameMode: rec.closeGameMode !== false,
              teamMode: rec.formatCode === '2v2',
              killRequiredForHome: rec.rulebookType !== 'yalla',
              twoKillsForHome: false,
              pairBlockadeRule: false
            },
            frames: frames,
            record: rec
          });
        });
        return sources;
      }

      function clearReplayTimers() {
        if (replayState.playTimer) {
          clearTimeout(replayState.playTimer);
          replayState.playTimer = null;
        }
        if (replayState.hopAnimTimer) {
          clearTimeout(replayState.hopAnimTimer);
          replayState.hopAnimTimer = null;
        }
        replayState.animTokenOverride = null;
      }

      function openReplayStudio(preferredMatchId) {
        clearReplayTimers();
        replayState.wasMatchPausedBeforeOpen = Boolean(gameState.isPaused);
        if (gameState.isMatchActive && !gameState.isPaused) {
          setGamePaused(true);
        }
        replayState.isOpen = true;
        replayState.isPlaying = false;

        const sources = getAvailableReplaySources();
        const sel = document.getElementById('replayMatchSelect');
        sel.innerHTML = '';
        sources.forEach(function (src) {
          const opt = document.createElement('option');
          opt.value = src.id;
          opt.textContent = src.label;
          sel.appendChild(opt);
        });

        let targetId = preferredMatchId;
        if (!targetId || !sources.some(function (s) { return s.id === targetId; })) {
          targetId = sources.length > 0 ? sources[0].id : 'LIVE';
        }
        sel.value = targetId;
        document.getElementById('replayStudioModal').classList.remove('hidden');
        loadMatchIntoReplayStudio(targetId);
      }

      function closeReplayStudio() {
        clearReplayTimers();
        replayState.isOpen = false;
        replayState.isPlaying = false;
        document.getElementById('replayStudioModal').classList.add('hidden');
        document.getElementById('replayMoveListDrawer').classList.add('hidden');
        if (gameState.isMatchActive && !replayState.wasMatchPausedBeforeOpen && document.getElementById('pauseMenuModal').classList.contains('hidden')) {
          setGamePaused(false);
        }
      }

      function loadMatchIntoReplayStudio(matchId) {
        clearReplayTimers();
        replayState.isPlaying = false;
        const sources = getAvailableReplaySources();
        const chosen = sources.find(function (s) { return s.id === matchId; }) || sources[0];
        if (!chosen) return;

        replayState.activeMatchId = chosen.id;
        replayState.frames = chosen.frames || [];
        replayState.rulesSnap = chosen.rulesSnap || Object.assign({}, rulesConfig);
        replayState.matchMeta = chosen;
        replayState.currentFrameIdx = 0;

        const slider = document.getElementById('replayTimelineSlider');
        slider.min = '0';
        slider.max = String(Math.max(0, replayState.frames.length - 1));
        slider.value = '0';

        const modeBadge = document.getElementById('replayMetaModeBadge');
        if (modeBadge) modeBadge.textContent = chosen.mode + ' • ' + chosen.format;

        renderReplayMoveListDrawer();
        stepReplayToFrame(0, false);
        updateReplayPlayPauseUI();
      }

      function renderReplayMoveListDrawer() {
        const container = document.getElementById('replayMoveListContainer');
        if (!container) return;
        container.innerHTML = '';
        const badgeColors = {
          START: 'bg-slate-700 text-white',
          ROLL: 'bg-amber-500 text-slate-950',
          SPAWN: 'bg-sky-500 text-white',
          MOVE: 'bg-indigo-600 text-white',
          KILL: 'bg-rose-600 text-white',
          HOME: 'bg-emerald-600 text-white',
          LOOP: 'bg-purple-600 text-white',
          VICTORY: 'bg-yellow-400 text-slate-950'
        };
        replayState.frames.forEach(function (fr, idx) {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.dataset.frameIdx = String(idx);
          btn.className = 'replay-log-row-btn w-full text-left p-2 rounded-xl border transition flex items-start justify-between gap-2 ' +
            (idx === replayState.currentFrameIdx ? 'bg-amber-500/20 border-amber-400 text-white' : 'bg-slate-800/80 hover:bg-slate-800 border-slate-700 text-slate-200');
          btn.innerHTML =
            '<div class="min-w-0 flex-1">' +
              '<div class="flex items-center gap-1.5">' +
                '<span class="px-1.5 py-0.2 rounded text-[9px] font-black ' + (badgeColors[fr.type] || badgeColors.MOVE) + '">#' + idx + ' ' + fr.type + '</span>' +
                '<span class="font-bold truncate text-[11px]">' + fr.title + '</span>' +
              '</div>' +
              '<div class="text-[10px] text-slate-400 truncate mt-0.5">' + (fr.subtitle || '') + '</div>' +
            '</div>';
          btn.addEventListener('click', function () {
            pauseReplayPlayback();
            stepReplayToFrame(idx, false);
          });
          container.appendChild(btn);
        });
      }

      function formatReplayClock(ms) {
        const totalSec = Math.max(0, Math.floor((Number(ms) || 0) / 1000));
        const mins = Math.floor(totalSec / 60);
        const secs = totalSec % 60;
        return (mins < 10 ? '0' + mins : mins) + ':' + (secs < 10 ? '0' + secs : secs);
      }

      function stepReplayToFrame(targetIdx, withHopAnimation, onAnimDone) {
        if (!replayState.frames || replayState.frames.length === 0) return;
        const clampedIdx = Math.max(0, Math.min(replayState.frames.length - 1, Number(targetIdx) || 0));
        const prevIdx = replayState.currentFrameIdx;
        replayState.currentFrameIdx = clampedIdx;
        if (replayState.hopAnimTimer) {
          clearTimeout(replayState.hopAnimTimer);
          replayState.hopAnimTimer = null;
        }
        replayState.animTokenOverride = null;

        const fr = replayState.frames[clampedIdx];
        const slider = document.getElementById('replayTimelineSlider');
        if (slider) slider.value = String(clampedIdx);

        updateReplayHudForFrame(fr, clampedIdx);

        const canAnimateHop = Boolean(
          withHopAnimation &&
          fr.trail &&
          Array.isArray(fr.trail.pathCoords) &&
          fr.trail.pathCoords.length > 0 &&
          replayState.speed <= 4
        );

        if (canAnimateHop) {
          const prevFr = clampedIdx > 0 ? replayState.frames[clampedIdx - 1] : fr;
          const coords = fr.trail.pathCoords;
          let hopStep = 0;
          const stepDelay = Math.max(18, Math.round(95 / Math.max(0.25, replayState.speed)));

          function tickHop() {
            if (!replayState.isOpen || replayState.currentFrameIdx !== clampedIdx) return;
            if (hopStep < coords.length) {
              replayState.animTokenOverride = {
                basePlayersEncoded: prevFr.players,
                ownerIdx: fr.trail.ownerIdx,
                tokenId: fr.trail.tokenId,
                rc: coords[hopStep]
              };
              if (replayState.sound) playSound('step');
              drawReplayBoardCanvas();
              hopStep += 1;
              replayState.hopAnimTimer = setTimeout(tickHop, stepDelay);
            } else {
              replayState.animTokenOverride = null;
              if (replayState.sound) {
                if (fr.type === 'KILL') playSound('kill');
                else if (fr.type === 'HOME' || fr.type === 'VICTORY') playSound('home');
              }
              drawReplayBoardCanvas();
              if (typeof onAnimDone === 'function') onAnimDone();
            }
          }
          tickHop();
        } else {
          if (withHopAnimation && replayState.sound) {
            if (fr.type === 'ROLL') playSound('roll');
            else if (fr.type === 'KILL') playSound('kill');
            else if (fr.type === 'HOME' || fr.type === 'VICTORY') playSound('home');
            else if (fr.type === 'MOVE' || fr.type === 'SPAWN') playSound('step');
          }
          drawReplayBoardCanvas();
          if (typeof onAnimDone === 'function') onAnimDone();
        }
      }

      function updateReplayHudForFrame(fr, idx) {
        const total = Math.max(1, replayState.frames.length - 1);
        document.getElementById('replayStepCounterLabel').textContent = 'Step ' + idx + ' / ' + total;
        document.getElementById('replayTimeElapsedLabel').textContent = formatReplayClock(fr.elapsedMs || 0);

        const typeBadge = document.getElementById('replayEventTypeBadge');
        typeBadge.textContent = fr.type || 'STEP';
        const badgeMap = {
          START: 'bg-slate-700 text-white',
          ROLL: 'bg-amber-400 text-slate-950',
          SPAWN: 'bg-sky-400 text-slate-950',
          MOVE: 'bg-indigo-500 text-white',
          KILL: 'bg-rose-600 text-white',
          HOME: 'bg-emerald-500 text-slate-950',
          LOOP: 'bg-purple-500 text-white',
          VICTORY: 'bg-yellow-400 text-slate-950'
        };
        typeBadge.className = 'px-2 py-0.5 rounded-lg font-black text-[10px] flex-shrink-0 ' + (badgeMap[fr.type] || badgeMap.MOVE);

        document.getElementById('replayEventTitle').textContent = fr.title || 'Replay Step';
        document.getElementById('replayEventSubtitle').textContent = fr.subtitle || ('Step ' + idx + ' of ' + total);

        const diceReadoutBox = document.getElementById('replayDiceReadout');
        if (diceReadoutBox && !document.getElementById('replayDieFace0')) {
          diceReadoutBox.innerHTML =
            '<div class="die-3d-scene" id="replayDieFace0" style="--cube-size: 18px; --cube-half: 9px; width: 19px; height: 19px;"></div>' +
            '<div class="die-3d-scene hidden" id="replayDieFace1" style="--cube-size: 18px; --cube-half: 9px; width: 19px; height: 19px;"></div>' +
            '<span class="font-mono font-black text-[11px] text-amber-300 ml-0.5" id="replayDiceText">-</span>';
        }
        const diceTextEl = document.getElementById('replayDiceText');
        const rDie1El = document.getElementById('replayDieFace1');
        if (Array.isArray(fr.dicePool) && fr.dicePool.length > 0) {
          if (diceTextEl) diceTextEl.textContent = fr.dicePool.map(function (d) { return d.value; }).join('+');
          const forceReplaySpin = (fr.type === 'ROLL');
          renderDieFace('replayDieFace0', fr.dicePool[0].value, false, forceReplaySpin);
          if (fr.dicePool.length >= 2) {
            if (rDie1El) rDie1El.classList.remove('hidden');
            renderDieFace('replayDieFace1', fr.dicePool[1].value, false, forceReplaySpin);
          } else if (rDie1El) {
            rDie1El.classList.add('hidden');
          }
        } else if (diceTextEl) {
          diceTextEl.textContent = '-';
        }

        // Render 4 player cards at this frame
        const rSnap = replayState.rulesSnap || rulesConfig;
        const decodedPlayers = decodePlayersStateFromReplay(fr.players, rSnap.tokensPerPlayer || 4);
        const strip = document.getElementById('replayPlayersStrip');
        const icons = ['🔴', '🟢', '🟡', '🔵'];
        const borders = ['border-rose-500/70', 'border-emerald-500/70', 'border-amber-400/70', 'border-blue-500/70'];
        strip.innerHTML = decodedPlayers.map(function (pl, pIdx) {
          if (!pl.active) {
            return '<div class="rounded-xl bg-slate-900/50 border border-slate-800 px-2 py-1 opacity-40 text-[10px]">' + icons[pIdx] + ' Off</div>';
          }
          const isTurn = fr.turn === pIdx;
          const doneCount = pl.tokens.filter(function (t) { return t.state === 'completed'; }).length;
          return '<div class="rounded-xl px-2 py-1 border transition flex flex-col justify-center ' +
            (isTurn ? 'bg-amber-500/20 border-amber-400 shadow-md ring-1 ring-amber-400' : ('bg-slate-900/85 ' + borders[pIdx])) + '">' +
            '<div class="flex items-center justify-between gap-1">' +
              '<span class="font-black text-[10px] sm:text-xs text-white truncate">' + icons[pIdx] + ' ' + pl.name + '</span>' +
              (isTurn ? '<span class="px-1 rounded bg-amber-400 text-slate-950 font-black text-[8px]">BARI</span>' : '') +
            '</div>' +
            '<div class="flex items-center justify-between text-[9px] sm:text-[10px] font-bold text-slate-300 mt-0.5">' +
              '<span>⚔️ ' + pl.kills + '</span>' +
              '<span>🏠 ' + doneCount + '/' + (rSnap.tokensPerPlayer || 4) + '</span>' +
            '</div>' +
          '</div>';
        }).join('');

        // Highlight active row in drawer if open
        const drawer = document.getElementById('replayMoveListContainer');
        if (drawer && !document.getElementById('replayMoveListDrawer').classList.contains('hidden')) {
          drawer.querySelectorAll('.replay-log-row-btn').forEach(function (b) {
            const bIdx = Number(b.dataset.frameIdx);
            b.className = 'replay-log-row-btn w-full text-left p-2 rounded-xl border transition flex items-start justify-between gap-2 ' +
              (bIdx === idx ? 'bg-amber-500/20 border-amber-400 text-white' : 'bg-slate-800/80 hover:bg-slate-800 border-slate-700 text-slate-200');
          });
        }

        updateReplayPlayPauseUI();
      }

      function updateReplayPlayPauseUI() {
        const iconEl = document.getElementById('replayPlayPauseIcon');
        const labelEl = document.getElementById('replayPlayPauseLabel');
        const statusPill = document.getElementById('replayFloatingStatusPill');
        if (iconEl) iconEl.textContent = replayState.isPlaying ? '⏸️' : '▶️';
        if (labelEl) labelEl.textContent = replayState.isPlaying ? 'Pause' : 'Play';
        if (statusPill) {
          statusPill.textContent = (replayState.isPlaying ? '▶️ PLAYING' : '⏸️ PAUSED') + ' • ' + replayState.speed + 'x';
        }
      }

      function scheduleNextReplayPlaybackTick() {
        if (replayState.playTimer) {
          clearTimeout(replayState.playTimer);
          replayState.playTimer = null;
        }
        if (!replayState.isOpen || !replayState.isPlaying) return;

        const baseInterval = Math.max(90, Math.round(950 / Math.max(0.25, replayState.speed)));
        replayState.playTimer = setTimeout(function () {
          if (!replayState.isOpen || !replayState.isPlaying) return;
          if (replayState.currentFrameIdx < replayState.frames.length - 1) {
            stepReplayToFrame(replayState.currentFrameIdx + 1, true, function () {
              if (replayState.isPlaying) scheduleNextReplayPlaybackTick();
            });
          } else if (replayState.loop) {
            stepReplayToFrame(0, false, function () {
              if (replayState.isPlaying) scheduleNextReplayPlaybackTick();
            });
          } else {
            replayState.isPlaying = false;
            updateReplayPlayPauseUI();
          }
        }, baseInterval);
      }

      function startReplayPlayback() {
        if (!replayState.frames || replayState.frames.length === 0) return;
        if (replayState.currentFrameIdx >= replayState.frames.length - 1) {
          stepReplayToFrame(0, false);
        }
        replayState.isPlaying = true;
        updateReplayPlayPauseUI();
        scheduleNextReplayPlaybackTick();
      }

      function pauseReplayPlayback() {
        replayState.isPlaying = false;
        if (replayState.playTimer) {
          clearTimeout(replayState.playTimer);
          replayState.playTimer = null;
        }
        updateReplayPlayPauseUI();
      }

      function toggleReplayPlayPause() {
        if (replayState.isPlaying) pauseReplayPlayback();
        else startReplayPlayback();
      }

      function stopReplayPlayback() {
        pauseReplayPlayback();
        stepReplayToFrame(0, false);
      }

      function jumpToReplayEventType(typesArr, direction) {
        pauseReplayPlayback();
        const len = replayState.frames.length;
        if (len === 0) return;
        const step = direction < 0 ? -1 : 1;
        let i = replayState.currentFrameIdx + step;
        while (i >= 0 && i < len) {
          const fr = replayState.frames[i];
          if (typesArr.includes(fr.type)) {
            stepReplayToFrame(i, false);
            return;
          }
          if (typesArr.includes('SIX') && fr.type === 'ROLL' && Array.isArray(fr.dicePool) && fr.dicePool.some(function (d) { return d.value === 6; })) {
            stepReplayToFrame(i, false);
            return;
          }
          i += step;
        }
        showToast('No more matching events in that direction.', true);
      }

      function drawReplayBoardCanvas(customTargetCanvas) {
        const rCanvas = customTargetCanvas || document.getElementById('replayCanvas');
        if (!rCanvas) return;
        const rCtx = rCanvas.getContext('2d');
        if (!customTargetCanvas) {
          const rect = rCanvas.getBoundingClientRect();
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          if (rect.width > 30 && rect.height > 30) {
            const targetW = Math.round(rect.width * dpr);
            const targetH = Math.round(rect.height * dpr);
            if (Math.abs(rCanvas.width - targetW) > 2 || Math.abs(rCanvas.height - targetH) > 2) {
              rCanvas.width = targetW;
              rCanvas.height = targetH;
            }
          }
        }

        const W = rCanvas.width;
        const H = rCanvas.height;
        const cellW = W / 15;
        const cellH = H / 15;
        const cell = Math.min(cellW, cellH);

        const fr = (replayState.frames && replayState.frames[replayState.currentFrameIdx]) || {
          turn: 0,
          dicePool: [{ id: 0, value: 6, used: false }],
          trail: null,
          players: encodePlayersStateForReplay(gameState.players)
        };
        const rSnap = replayState.rulesSnap || rulesConfig;
        const baseEncoded = (replayState.animTokenOverride && replayState.animTokenOverride.basePlayersEncoded)
          ? replayState.animTokenOverride.basePlayersEncoded
          : fr.players;
        const playersList = decodePlayersStateFromReplay(baseEncoded, rSnap.tokensPerPlayer || 4);
        if (replayState.animTokenOverride) {
          const ov = replayState.animTokenOverride;
          if (playersList[ov.ownerIdx] && playersList[ov.ownerIdx].tokens[ov.tokenId]) {
            playersList[ov.ownerIdx].tokens[ov.tokenId].animCoords = ov.rc;
          }
        }

        rCtx.save();
        rCtx.clearRect(0, 0, W, H);
        if (replayState.boardRotationDeg) {
          rCtx.translate(W / 2, H / 2);
          rCtx.rotate((replayState.boardRotationDeg * Math.PI) / 180);
          rCtx.translate(-W / 2, -H / 2);
        }

        rCtx.fillStyle = '#ffffff';
        rCtx.fillRect(0, 0, W, H);

        const homeColors = ['#ffe4e6', '#d1fae5', '#fef3c7', '#dbeafe'];
        const strongColors = ['#e11d48', '#059669', '#d97706', '#2563eb'];

        HOME_PATHS.forEach(function (path, pIdx) {
          for (let i = 0; i < 5; i++) {
            const rc = path[i];
            rCtx.fillStyle = strongColors[pIdx];
            rCtx.fillRect(rc[1] * cellW, rc[0] * cellH, cellW, cellH);
          }
        });

        START_TRACK_INDEX.forEach(function (tIdx, pIdx) {
          const rc = MAIN_TRACK[tIdx];
          rCtx.fillStyle = strongColors[pIdx];
          rCtx.fillRect(rc[1] * cellW, rc[0] * cellH, cellW, cellH);
        });

        [8, 21, 34, 47].forEach(function (tIdx) {
          const rc = MAIN_TRACK[tIdx];
          rCtx.fillStyle = '#fde68a';
          rCtx.fillRect(rc[1] * cellW, rc[0] * cellH, cellW, cellH);
        });

        rCtx.strokeStyle = '#cbd5e1';
        rCtx.lineWidth = Math.max(1.2, cell * 0.03);
        for (let r = 0; r < 15; r++) {
          for (let c = 0; c < 15; c++) {
            const inCorner = (r < 6 && c < 6) || (r < 6 && c > 8) || (r > 8 && c < 6) || (r > 8 && c > 8);
            const inCenter = (r >= 6 && r <= 8 && c >= 6 && c <= 8);
            if (!inCorner && !inCenter) {
              rCtx.strokeRect(c * cellW, r * cellH, cellW, cellH);
            }
          }
        }

        SAFE_TRACK_INDICES.forEach(function (tIdx) {
          const rc = MAIN_TRACK[tIdx];
          const x = rc[1] * cellW;
          const y = rc[0] * cellH;
          const cx = (rc[1] + 0.5) * cellW;
          const cy = (rc[0] + 0.5) * cellH;
          const isStartStop = START_TRACK_INDEX.includes(tIdx);

          rCtx.save();
          rCtx.strokeStyle = isStartStop ? '#ffffff' : '#b45309';
          rCtx.lineWidth = Math.max(2, cell * 0.055);
          rCtx.strokeRect(x + cellW * 0.07, y + cellH * 0.07, cellW * 0.86, cellH * 0.86);
          rCtx.fillStyle = isStartStop ? '#ffffff' : '#92400e';
          rCtx.font = '900 ' + Math.round(cell * 0.40) + 'px Inter, sans-serif';
          rCtx.textAlign = 'center';
          rCtx.textBaseline = 'middle';
          rCtx.fillText('★', cx, cy - cellH * 0.06);
          rCtx.font = '900 ' + Math.round(cell * 0.16) + 'px Inter, sans-serif';
          rCtx.fillText('STOP', cx, cy + cellH * 0.27);
          rCtx.restore();
        });

        const yardOrigins = [
          { r: 0, c: 0, pIdx: 0 },
          { r: 0, c: 9, pIdx: 1 },
          { r: 9, c: 9, pIdx: 2 },
          { r: 9, c: 0, pIdx: 3 }
        ];

        yardOrigins.forEach(function (yo) {
          const x = yo.c * cellW;
          const y = yo.r * cellH;
          const sizeW = 6 * cellW;
          const sizeH = 6 * cellH;
          const isTurn = (fr.turn === yo.pIdx);
          const pl = playersList[yo.pIdx];

          rCtx.fillStyle = strongColors[yo.pIdx];
          rCtx.fillRect(x, y, sizeW, sizeH);

          rCtx.save();
          rCtx.fillStyle = isTurn ? '#fffbeb' : '#ffffff';
          rCtx.beginPath();
          rCtx.roundRect(x + cellW * 0.45, y + cellH * 0.45, sizeW - cellW * 0.9, sizeH - cellH * 0.9, 14);
          rCtx.fill();
          rCtx.lineWidth = isTurn ? 4.5 : 2.5;
          rCtx.strokeStyle = isTurn ? '#f59e0b' : homeColors[yo.pIdx];
          rCtx.stroke();
          rCtx.restore();

          if (pl && pl.active) {
            const bannerW = sizeW - cellW * 1.25;
            const bannerH = cellH * 0.42;
            const bannerX = x + (sizeW - bannerW) / 2;
            const bannerY = y + cellH * 0.54;
            rCtx.fillStyle = isTurn ? '#0f172a' : '#f1f5f9';
            rCtx.beginPath();
            rCtx.roundRect(bannerX, bannerY, bannerW, bannerH, 6);
            rCtx.fill();
            rCtx.fillStyle = isTurn ? '#fde047' : '#0f172a';
            rCtx.font = '900 ' + Math.round(cell * 0.21) + 'px Inter, sans-serif';
            rCtx.textAlign = 'center';
            rCtx.textBaseline = 'middle';
            rCtx.fillText((isTurn ? '⚡ ' : '') + pl.name.slice(0, 10), x + sizeW / 2, bannerY + bannerH / 2);
          }

          for (let t = 0; t < (rSnap.tokensPerPlayer || 4); t++) {
            const slot = YARD_SLOTS[yo.pIdx][t];
            const sx = (slot[1] + 0.5) * cellW;
            const sy = (slot[0] + 0.5) * cellH;
            rCtx.beginPath();
            rCtx.arc(sx, sy, cell * 0.38, 0, Math.PI * 2);
            rCtx.fillStyle = homeColors[yo.pIdx];
            rCtx.fill();
            rCtx.lineWidth = 2;
            rCtx.strokeStyle = strongColors[yo.pIdx];
            rCtx.stroke();
          }

          if (pl && pl.active) {
            const badgeW = sizeW - cellW * 1.25;
            const badgeH = cellH * 0.40;
            const badgeX = x + (sizeW - badgeW) / 2;
            const badgeY = y + sizeH - cellH * 0.54 - badgeH;
            rCtx.fillStyle = pl.kills > 0 ? '#065f46' : '#881337';
            rCtx.beginPath();
            rCtx.roundRect(badgeX, badgeY, badgeW, badgeH, 6);
            rCtx.fill();
            rCtx.fillStyle = '#ffffff';
            rCtx.font = '900 ' + Math.round(cell * 0.19) + 'px Inter, sans-serif';
            rCtx.textAlign = 'center';
            rCtx.textBaseline = 'middle';
            rCtx.fillText((pl.kills > 0 ? '🔓 HOME OPEN (⚔️' : '🔒 NEED KILL (⚔️') + pl.kills + ')', x + sizeW / 2, badgeY + badgeH / 2);
          }

          if (isTurn && pl && pl.active && Array.isArray(fr.dicePool) && fr.dicePool.length > 0) {
            const dSize = cell * 0.50;
            if (fr.dicePool.length === 1) {
              drawIsometric3dDieOnCanvas(rCtx, x + sizeW / 2, y + sizeH / 2, dSize, fr.dicePool[0].value, false, 0, 0);
            } else {
              drawIsometric3dDieOnCanvas(rCtx, x + sizeW / 2 - dSize * 0.68, y + sizeH / 2, dSize, fr.dicePool[0].value, false, 0, 0);
              drawIsometric3dDieOnCanvas(rCtx, x + sizeW / 2 + dSize * 0.68, y + sizeH / 2, dSize, fr.dicePool[1].value, false, 0, 0);
            }
          }
        });

        // Center Home Triangles
        const cx = 7.5 * cellW;
        const cy = 7.5 * cellH;
        const x0 = 6 * cellW, y0 = 6 * cellH, x1 = 9 * cellW, y1 = 9 * cellH;
        [
          { pts: [[x0, y0], [x0, y1], [cx, cy]], color: strongColors[0] },
          { pts: [[x0, y0], [x1, y0], [cx, cy]], color: strongColors[1] },
          { pts: [[x1, y0], [x1, y1], [cx, cy]], color: strongColors[2] },
          { pts: [[x0, y1], [x1, y1], [cx, cy]], color: strongColors[3] }
        ].forEach(function (tri) {
          rCtx.beginPath();
          rCtx.moveTo(tri.pts[0][0], tri.pts[0][1]);
          rCtx.lineTo(tri.pts[1][0], tri.pts[1][1]);
          rCtx.lineTo(tri.pts[2][0], tri.pts[2][1]);
          rCtx.closePath();
          rCtx.fillStyle = tri.color;
          rCtx.fill();
          rCtx.lineWidth = 2;
          rCtx.strokeStyle = '#ffffff';
          rCtx.stroke();
        });

        rCtx.beginPath();
        rCtx.arc(cx, cy, cell * 0.45, 0, Math.PI * 2);
        rCtx.fillStyle = '#ffffff';
        rCtx.fill();
        rCtx.lineWidth = 3;
        rCtx.strokeStyle = '#d97706';
        rCtx.stroke();
        rCtx.font = 'bold ' + Math.round(cell * 0.42) + 'px Inter, sans-serif';
        rCtx.textAlign = 'center';
        rCtx.textBaseline = 'middle';
        rCtx.fillText('👑', cx, cy);

        // Trail Overlay
        if (replayState.showTrail && fr.trail && Array.isArray(fr.trail.pathCoords) && fr.trail.pathCoords.length > 0) {
          const trail = fr.trail;
          const trailMeta = PLAYER_META[trail.ownerIdx] || PLAYER_META[0];
          rCtx.save();
          const ox = (trail.startRC[1] + 0.5) * cellW;
          const oy = (trail.startRC[0] + 0.5) * cellH;
          rCtx.beginPath();
          rCtx.arc(ox, oy, cell * 0.25, 0, Math.PI * 2);
          rCtx.fillStyle = 'rgba(148, 163, 184, 0.4)';
          rCtx.fill();
          rCtx.lineWidth = 2.5;
          rCtx.setLineDash([4, 3]);
          rCtx.strokeStyle = trailMeta.hex;
          rCtx.stroke();

          rCtx.beginPath();
          rCtx.moveTo(ox, oy);
          trail.pathCoords.forEach(function (rc) {
            rCtx.lineTo((rc[1] + 0.5) * cellW, (rc[0] + 0.5) * cellH);
          });
          rCtx.strokeStyle = trailMeta.hex;
          rCtx.lineWidth = 4.5;
          rCtx.stroke();
          rCtx.setLineDash([]);

          trail.pathCoords.forEach(function (rc, pIdx) {
            const px = (rc[1] + 0.5) * cellW;
            const py = (rc[0] + 0.5) * cellH;
            rCtx.beginPath();
            rCtx.arc(px, py, pIdx === trail.pathCoords.length - 1 ? cell * 0.42 : cell * 0.14, 0, Math.PI * 2);
            rCtx.fillStyle = pIdx === trail.pathCoords.length - 1 ? 'rgba(250, 204, 21, 0.34)' : trailMeta.hex;
            rCtx.fill();
          });
          rCtx.restore();
        }

        // Group & Draw Tokens
        const cellGroups = {};
        playersList.forEach(function (pl) {
          if (!pl.active) return;
          pl.tokens.forEach(function (tk) {
            const rc = getTokenGridCoords(tk);
            const key = rc[0].toFixed(1) + ',' + rc[1].toFixed(1);
            if (!cellGroups[key]) cellGroups[key] = [];
            cellGroups[key].push(tk);
          });
        });

        Object.keys(cellGroups).forEach(function (key) {
          const group = cellGroups[key];
          const baseRC = getTokenGridCoords(group[0]);
          const baseX = (baseRC[1] + 0.5) * cellW;
          const baseY = (baseRC[0] + 0.5) * cellH;

          group.forEach(function (tk, idx) {
            let offsetX = 0;
            let offsetY = 0;
            let radius = cell * 0.34;
            if (group.length > 1) {
              radius = group.length === 2 ? cell * 0.24 : cell * 0.20;
              const spread = cell * 0.23;
              const angle = (idx / group.length) * Math.PI * 2 - Math.PI / 4;
              offsetX = Math.cos(angle) * spread;
              offsetY = Math.sin(angle) * spread;
            }
            const tx = baseX + offsetX;
            const ty = baseY + offsetY;
            const meta = PLAYER_META[tk.owner];
            const isMovedToken = Boolean(fr.trail && fr.trail.ownerIdx === tk.owner && fr.trail.tokenId === tk.id);

            if (isMovedToken) {
              rCtx.beginPath();
              rCtx.arc(tx, ty, radius + 6, 0, Math.PI * 2);
              rCtx.fillStyle = 'rgba(250, 204, 21, 0.85)';
              rCtx.fill();
              rCtx.lineWidth = 2.5;
              rCtx.strokeStyle = '#b45309';
              rCtx.stroke();
            }

            rCtx.beginPath();
            rCtx.arc(tx, ty, radius, 0, Math.PI * 2);
            rCtx.fillStyle = meta.hex;
            rCtx.fill();
            rCtx.lineWidth = 2.2;
            rCtx.strokeStyle = rSnap.teamMode ? meta.teamRing : '#ffffff';
            rCtx.stroke();

            rCtx.beginPath();
            rCtx.arc(tx, ty, radius * 0.65, 0, Math.PI * 2);
            rCtx.fillStyle = meta.darkHex;
            rCtx.fill();

            rCtx.fillStyle = '#ffffff';
            rCtx.font = 'bold ' + Math.round(radius * 0.85) + 'px Inter, sans-serif';
            rCtx.textAlign = 'center';
            rCtx.textBaseline = 'middle';
            rCtx.fillText(tk.lockedThisTurn ? '🔒' : String(tk.id + 1), tx, ty);
          });
        });

        rCtx.restore();
      }

      function downloadReplayScreenshotPng() {
        const fr = (replayState.frames && replayState.frames[replayState.currentFrameIdx]);
        if (!fr) return;
        const rSnap = replayState.rulesSnap || rulesConfig;
        const decodedPlayers = decodePlayersStateFromReplay(fr.players, rSnap.tokensPerPlayer || 4);

        const outCanvas = document.createElement('canvas');
        outCanvas.width = 1080;
        outCanvas.height = 1320;
        const g = outCanvas.getContext('2d');

        // Background
        const bgGrad = g.createLinearGradient(0, 0, 0, 1320);
        bgGrad.addColorStop(0, '#0f172a');
        bgGrad.addColorStop(0.5, '#1e293b');
        bgGrad.addColorStop(1, '#090d16');
        g.fillStyle = bgGrad;
        g.fillRect(0, 0, 1080, 1320);

        // Gold border
        g.strokeStyle = '#f59e0b';
        g.lineWidth = 6;
        g.strokeRect(16, 16, 1048, 1288);

        // Top Header
        g.fillStyle = '#fbbf24';
        g.font = '900 28px Inter, sans-serif';
        g.fillText('🎬 BANNU ROYALE LUDO — OFFICIAL MATCH REPLAY SNAPSHOT', 42, 66);

        g.fillStyle = '#e2e8f0';
        g.font = '700 20px Inter, sans-serif';
        const mLabel = (replayState.matchMeta && replayState.matchMeta.label) ? replayState.matchMeta.label : 'Match Replay';
        g.fillText(mLabel + '  •  Step ' + replayState.currentFrameIdx + ' / ' + Math.max(1, replayState.frames.length - 1) + '  •  Elapsed: ' + formatReplayClock(fr.elapsedMs || 0), 42, 102);

        // Event Banner Box
        g.fillStyle = '#020617';
        g.fillRect(42, 122, 996, 68);
        g.strokeStyle = '#f59e0b';
        g.lineWidth = 2;
        g.strokeRect(42, 122, 996, 68);
        g.fillStyle = '#fde047';
        g.font = '900 22px Inter, sans-serif';
        g.fillText('[' + (fr.type || 'STEP') + ']  ' + (fr.title || ''), 60, 152);
        g.fillStyle = '#94a3b8';
        g.font = '600 16px Inter, sans-serif';
        g.fillText(fr.subtitle || '', 60, 178);

        // 4 Player Score Boxes
        const pCols = ['#e11d48', '#059669', '#d97706', '#2563eb'];
        decodedPlayers.forEach(function (pl, i) {
          const bx = 42 + i * 252;
          const by = 204;
          g.fillStyle = fr.turn === i ? '#332407' : '#0f172a';
          g.fillRect(bx, by, 240, 62);
          g.strokeStyle = fr.turn === i ? '#fbbf24' : pCols[i];
          g.lineWidth = fr.turn === i ? 3.5 : 2;
          g.strokeRect(bx, by, 240, 62);
          g.fillStyle = '#ffffff';
          g.font = '900 18px Inter, sans-serif';
          g.fillText(pl.name.slice(0, 14), bx + 14, by + 26);
          const done = pl.tokens.filter(function (t) { return t.state === 'completed'; }).length;
          g.fillStyle = '#cbd5e1';
          g.font = '700 15px Inter, sans-serif';
          g.fillText('⚔️ Kills: ' + pl.kills + '   🏠 Home: ' + done + '/' + (rSnap.tokensPerPlayer || 4), bx + 14, by + 50);
        });

        // Render Board onto offscreen 960x960 canvas and composite
        const boardTemp = document.createElement('canvas');
        boardTemp.width = 960;
        boardTemp.height = 960;
        drawReplayBoardCanvas(boardTemp);

        g.fillStyle = '#d97706';
        g.fillRect(54, 280, 972, 972);
        g.drawImage(boardTemp, 60, 286, 960, 960);

        // Footer
        g.fillStyle = '#fbbf24';
        g.font = '700 16px Inter, sans-serif';
        g.fillText('Bannu Royale Ludo — © 2026 Yasin Ullah (Bannu Software Solutions) • Dedicated to Muhib Ullah', 42, 1284);

        const dataUrl = outCanvas.toDataURL('image/png');
        const a = document.createElement('a');
        a.href = dataUrl;
        a.download = 'bannu_ludo_replay_' + (replayState.activeMatchId || 'match') + '_step_' + replayState.currentFrameIdx + '.png';
        a.click();
        showToast('📸 Downloaded HD Replay Screenshot (.PNG)!', true);
      }

      function exportCurrentReplayAsJson() {
        if (!replayState.frames || replayState.frames.length === 0) return;
        const payload = {
          app: 'BannuRoyaleLudoReplay',
          version: '1.0',
          exportedAt: new Date().toISOString(),
          matchId: replayState.activeMatchId,
          label: replayState.matchMeta ? replayState.matchMeta.label : 'Custom Replay',
          mode: replayState.matchMeta ? replayState.matchMeta.mode : rulesConfig.presetName,
          format: replayState.matchMeta ? replayState.matchMeta.format : '2v2 Teams',
          rulesSnap: replayState.rulesSnap,
          frames: replayState.frames
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'bannu_ludo_replay_' + (replayState.activeMatchId || 'live') + '.json';
        a.click();
        URL.revokeObjectURL(url);
        showToast('💾 Downloaded Replay file (.json)!', true);
      }

      function importReplayFromJsonFile(file) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (ev) {
          try {
            const data = JSON.parse(ev.target.result);
            if (!data || !Array.isArray(data.frames) || data.frames.length === 0) {
              showToast('⚠️ Invalid replay JSON file.', true);
              return;
            }
            const customId = data.matchId || ('IMP-' + String(Date.now()).slice(-4));
            ensureCareerStatsSchema();
            const existingIdx = (careerStats.matchRecords || []).findIndex(function (r) { return r.matchId === customId; });
            if (existingIdx === -1) {
              careerStats.matchRecords.unshift({
                matchId: customId,
                date: new Date().toISOString().slice(0, 10),
                timestamp: new Date().toISOString(),
                mode: data.mode || 'Imported Replay',
                rulebookType: 'bannu',
                closeGameMode: true,
                format: data.format || '2v2 Teams',
                formatCode: '2v2',
                result: 'Imported 🎬',
                won: true,
                isCleanSweep: false,
                kills: 0,
                durationMs: (data.frames[data.frames.length - 1] && data.frames[data.frames.length - 1].elapsedMs) || 180000,
                totalTurns: data.frames.length,
                avgBeadMoveMs: 1200,
                avgTurnTimeMs: 4000,
                rulesSnapshot: data.rulesSnap || Object.assign({}, rulesConfig),
                replayFrames: data.frames
              });
              saveCareerStats();
            } else {
              careerStats.matchRecords[existingIdx].replayFrames = data.frames;
            }
            openReplayStudio(customId);
            showToast('📂 Loaded Replay ' + customId + ' (' + data.frames.length + ' steps)!', true);
          } catch (e) {
            showToast('⚠️ Could not parse replay JSON file.', true);
          }
        };
        reader.readAsText(file);
      }

      // --- 15. LOGGING & TOAST HELPERS ---
      function clearGameLog() {
        document.getElementById('gameLogContainer').innerHTML = '';
      }

      function addGameLog(text, style) {
        const container = document.getElementById('gameLogContainer');
        const item = document.createElement('div');
        let colorClass = 'text-slate-700 border-slate-200 bg-slate-50';
        if (style === 'gold') colorClass = 'text-amber-900 border-amber-300 bg-amber-50 font-semibold';
        if (style === 'kill') colorClass = 'text-rose-900 border-rose-300 bg-rose-50 font-semibold';
        if (style === 'warn') colorClass = 'text-sky-900 border-sky-300 bg-sky-50';

        item.className = 'px-3 py-1.5 rounded-xl border text-xs leading-snug ' + colorClass;
        item.textContent = text;
        container.prepend(item);
      }

      let toastTimer = null;
      function showToast(msg, forceShow) {
        if (!rulesConfig.showTooltips && !forceShow) return;
        const t = document.getElementById('toastBanner');
        const txt = document.getElementById('toastBannerText');
        if (txt) txt.textContent = msg;
        else t.textContent = msg;
        t.classList.remove('hidden');
        if (toastTimer) clearTimeout(toastTimer);
        toastTimer = setTimeout(function () {
          t.classList.add('hidden');
        }, 2400);
      }

      // --- 15B. COMPREHENSIVE BILINGUAL (ENGLISH + URDU) RULEBOOK GUIDE RENDERER ---
      const COMPREHENSIVE_GUIDE_ITEMS = [
        {
          id: 'dice_count',
          cat: 'core',
          ruleKey: 'diceCount',
          defaultBadge: 'Default: 2 Dice (Bannu) / 1 Die (Yalla)',
          titleEn: '1. Two-Dice Tactical Play vs 1-Die Classic',
          titleUr: 'دو دانوں والا روایتی کھیل بمقابلہ ایک دانہ (2 ڈائس یا 1 ڈائس)',
          enDesc: 'In Bannu Ludo, each player rolls 2 dice together. You can either split the two dice across two different beads OR combine the sum of both dice on a single bead.',
