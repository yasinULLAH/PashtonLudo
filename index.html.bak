        { tier: 16, minXp: 31500, icon: '🏆', titleEn: 'Pashtun Grandmaster', titleUr: 'پشتون گرینڈ ماسٹر', perk: 'Elite Cultural Referee' },
        { tier: 17, minXp: 38000, icon: '🔱', titleEn: 'Bannu Overlord', titleUr: 'بنوں سرکردہ', perk: 'Flawless Streak Holder' },
        { tier: 18, minXp: 46000, icon: '🌌', titleEn: 'Mythic Shikari', titleUr: 'افسانوی شکاری', perk: '100+ Career Hunts' },
        { tier: 19, minXp: 56000, icon: '👑', titleEn: 'Imperial Ludo Khan', titleUr: 'شاہی لڈو خان', perk: 'All-Mode Virtuoso' },
        { tier: 20, minXp: 70000, icon: '🧹👑', titleEn: 'Supreme Bannu Sovereign', titleUr: 'اعلیٰ بنوں سلطان', perk: 'Ultimate Royale Legend' }
      ];

      function formatDurationMs(ms) {
        const totalSec = Math.max(1, Math.round((Number(ms) || 0) / 1000));
        const mins = Math.floor(totalSec / 60);
        const secs = totalSec % 60;
        if (mins >= 60) {
          const hrs = Math.floor(mins / 60);
          const rMins = mins % 60;
          return hrs + 'h ' + rMins + 'm';
        }
        return mins + 'm ' + (secs < 10 ? '0' + secs : secs) + 's';
      }

      function computeCareerXpAndRank() {
        ensureCareerStatsSchema();
        const xp = Math.max(0,
          (careerStats.wins || 0) * 260 +
          (careerStats.cleanSweeps || 0) * 520 +
          (careerStats.kills || 0) * 48 +
          (careerStats.doubleSixes || 0) * 35 +
          (careerStats.teamWins || 0) * 160 +
          (careerStats.hardAiWins || 0) * 210 +
          (careerStats.matches || 0) * 65 +
          (careerStats.totalHomeCompleted || 0) * 28 +
          (careerStats.totalSpawns || 0) * 12 +
          (careerStats.fastMovesUnder1500ms || 0) * 10 +
          (careerStats.totalPartnerAssists || 0) * 75
        );
        const level = Math.max(1, Math.floor(Math.sqrt(xp / 95)) + 1);
        const prevLevelXp = Math.pow(level - 1, 2) * 95;
        const nextLevelXp = Math.pow(level, 2) * 95;
        const levelProgressPct = Math.min(100, Math.max(4, Math.round(((xp - prevLevelXp) / Math.max(1, nextLevelXp - prevLevelXp)) * 100)));
        const prestige = Math.floor((level - 1) / 20);

        let currentRank = OFFICIAL_RANKS_LADDER[0];
        let nextRank = OFFICIAL_RANKS_LADDER[1] || currentRank;
        for (let i = 0; i < OFFICIAL_RANKS_LADDER.length; i++) {
          if (xp >= OFFICIAL_RANKS_LADDER[i].minXp) {
            currentRank = OFFICIAL_RANKS_LADDER[i];
            nextRank = OFFICIAL_RANKS_LADDER[i + 1] || OFFICIAL_RANKS_LADDER[i];
          }
        }
        return {
          xp: xp,
          level: level,
          prestige: prestige,
          nextLevelXp: nextLevelXp,
          levelProgressPct: levelProgressPct,
          currentRank: currentRank,
          nextRank: nextRank
        };
      }

