            { seat: 1, color: 'Green', matches: 4, wins: 1, kills: 4, deaths: 7, spawns: 15, homeCompleted: 7, outerLoops: 4, closeLocks: 3, turns: 117, totalTurnMs: 503580, moves: 112, totalDecisionMs: 136400, totalAnimMs: 26200, totalGameTimeMs: 1470000, stepsMoved: 682 },
            { seat: 2, color: 'Yellow', matches: 5, wins: 2, kills: 5, deaths: 6, spawns: 19, homeCompleted: 14, outerLoops: 3, closeLocks: 5, turns: 141, totalTurnMs: 593440, moves: 145, totalDecisionMs: 164100, totalAnimMs: 31900, totalGameTimeMs: 1755000, stepsMoved: 985 },
