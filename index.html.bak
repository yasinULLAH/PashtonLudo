        stepReplayToFrame(Math.max(0, replayState.frames.length - 1), false);
      });
      document.getElementById('replayPrevStepBtn').addEventListener('click', function () {
        pauseReplayPlayback();
        stepReplayToFrame(Math.max(0, replayState.currentFrameIdx - 1), false);
      });
      document.getElementById('replayNextStepBtn').addEventListener('click', function () {
        pauseReplayPlayback();
        stepReplayToFrame(Math.min(replayState.frames.length - 1, replayState.currentFrameIdx + 1), true);
      });
      document.getElementById('replayBack5Btn').addEventListener('click', function () {
        pauseReplayPlayback();
        stepReplayToFrame(Math.max(0, replayState.currentFrameIdx - 5), false);
      });
      document.getElementById('replayFwd5Btn').addEventListener('click', function () {
        pauseReplayPlayback();
        stepReplayToFrame(Math.min(replayState.frames.length - 1, replayState.currentFrameIdx + 5), false);
      });
      document.getElementById('replayTimelineSlider').addEventListener('input', function () {
        pauseReplayPlayback();
        stepReplayToFrame(Number(this.value), false);
      });
      document.getElementById('replaySpeedSelect').addEventListener('change', function () {
        replayState.speed = Number(this.value) || 1;
        updateReplayPlayPauseUI();
        if (replayState.isPlaying) {
          scheduleNextReplayPlaybackTick();
        }
      });
      document.getElementById('replayLoopToggleBtn').addEventListener('click', function () {
        replayState.loop = !replayState.loop;
        this.textContent = replayState.loop ? '🔁 Loop: ON' : '🔁 Off';
        this.className = 'px-2 py-1.5 rounded-xl font-bold text-[10px] sm:text-xs border ' +
          (replayState.loop ? 'bg-amber-500 text-slate-950 border-amber-300' : 'bg-slate-800 hover:bg-slate-700 text-slate-300 border-slate-700');
      });
      document.getElementById('replaySoundToggleBtn').addEventListener('click', function () {
        replayState.sound = !replayState.sound;
        this.textContent = replayState.sound ? '🔊' : '🔇';
      });
      document.getElementById('replayToggleTrailBtn').addEventListener('click', function () {
        replayState.showTrail = !replayState.showTrail;
        this.textContent = '🧭 Trail: ' + (replayState.showTrail ? 'ON' : 'OFF');
        drawReplayBoardCanvas();
      });
      document.getElementById('replayRotateBoardBtn').addEventListener('click', function () {
        replayState.boardRotationDeg = (replayState.boardRotationDeg + 90) % 360;
        this.textContent = '🔄 ' + replayState.boardRotationDeg + '°';
        drawReplayBoardCanvas();
      });
      document.getElementById('replayToggleLogDrawerBtn').addEventListener('click', function () {
        const dr = document.getElementById('replayMoveListDrawer');
        dr.classList.toggle('hidden');
        if (!dr.classList.contains('hidden')) {
          renderReplayMoveListDrawer();
        }
      });
      document.getElementById('closeReplayMoveListBtn').addEventListener('click', function () {
        document.getElementById('replayMoveListDrawer').classList.add('hidden');
      });
      document.getElementById('replayPrevKillBtn').addEventListener('click', function () {
        jumpToReplayEventType(['KILL'], -1);
      });
      document.getElementById('replayNextKillBtn').addEventListener('click', function () {
        jumpToReplayEventType(['KILL'], 1);
      });
      document.getElementById('replayNextSixBtn').addEventListener('click', function () {
        jumpToReplayEventType(['SIX'], 1);
      });
      document.getElementById('replayNextHomeBtn').addEventListener('click', function () {
        jumpToReplayEventType(['HOME', 'VICTORY'], 1);
      });
      document.getElementById('replayScreenshotBtn').addEventListener('click', downloadReplayScreenshotPng);
      document.getElementById('replayExportJsonBtn').addEventListener('click', exportCurrentReplayAsJson);
      document.getElementById('replayImportJsonInput').addEventListener('change', function (e) {
        const f = e.target.files && e.target.files[0];
        if (f) importReplayFromJsonFile(f);
      });
      document.getElementById('replayFullscreenBtn').addEventListener('click', function () {
        if (!document.fullscreenElement && document.documentElement.requestFullscreen) {
          document.documentElement.requestFullscreen().catch(function () {});
        } else if (document.exitFullscreen) {
          document.exitFullscreen().catch(function () {});
        }
      });
      window.addEventListener('keydown', function (e) {
        if (!replayState.isOpen) return;
        if (['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement && document.activeElement.tagName)) return;
        if (e.code === 'Space') {
          e.preventDefault();
          toggleReplayPlayPause();
        } else if (e.code === 'ArrowRight') {
          e.preventDefault();
          pauseReplayPlayback();
          stepReplayToFrame(Math.min(replayState.frames.length - 1, replayState.currentFrameIdx + 1), true);
        } else if (e.code === 'ArrowLeft') {
          e.preventDefault();
          pauseReplayPlayback();
          stepReplayToFrame(Math.max(0, replayState.currentFrameIdx - 1), false);
        } else if (e.code === 'Home') {
          e.preventDefault();
          pauseReplayPlayback();
          stepReplayToFrame(0, false);
        } else if (e.code === 'End') {
          e.preventDefault();
          pauseReplayPlayback();
          stepReplayToFrame(Math.max(0, replayState.frames.length - 1), false);
        } else if (e.code === 'Escape') {
          e.preventDefault();
          closeReplayStudio();
        }
      });

      document.getElementById('victoryPlayAgainBtn').addEventListener('click', function () {
        initNewMatch(null, false);
      });
      document.getElementById('victoryViewStatsBtn').addEventListener('click', function () {
        document.getElementById('victoryModal').classList.add('hidden');
        switchNavigationTab('viewStats');
      });
      document.getElementById('victoryExitLobbyBtn').addEventListener('click', function () {
        document.getElementById('victoryModal').classList.add('hidden');
        clearSavedMatchSnapshot();
        switchNavigationTab('viewHome');
      });
      document.getElementById('victoryQuitMatchBtn').addEventListener('click', function () {
        document.getElementById('victoryModal').classList.add('hidden');
        clearSavedMatchSnapshot();
        netMatch.isActive = false;
        initNewMatch('Match exited to Home Lobby.', true);
        switchNavigationTab('viewHome');
        showToast('🚪 Exited match to Home Lobby.', true);
      });

      // Dashboard Sub-Tabs, Role Switcher, Chart Data Modal, Filters, Pagination & Exports
      document.querySelectorAll('.dash-subtab-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          switchDashboardSubTab(btn.dataset.dashtab || 'overview');
        });
      });

      const roleSel = document.getElementById('dashboardRoleSelect');
      if (roleSel) {
        roleSel.addEventListener('change', function () {
          applyDashboardRoleVisibility(this.value);
          showToast('👑 Switched Dashboard Role to: ' + this.options[this.selectedIndex].text, true);
        });
      }

      document.querySelectorAll('.chart-view-data-btn').forEach(function (btn) {
        btn.addEventListener('click', function () {
          openChartDataInspectorModal(btn.dataset.chartId || 'full_reports');
        });
      });

      document.getElementById('closeChartDataModalBtn').addEventListener('click', function () {
        document.getElementById('chartDataInspectorModal').classList.add('hidden');
      });
      document.getElementById('exportChartDataCsvBtn').addEventListener('click', exportCurrentInspectedChartCsv);
      document.getElementById('closeMatchDrilldownModalBtn').addEventListener('click', function () {
        document.getElementById('matchDrilldownModal').classList.add('hidden');
      });

      // PDF & Excel Export Buttons
      document.getElementById('exportReportPdfBtn').addEventListener('click', exportComprehensivePdfReport);
      document.getElementById('reportExportPdfBtn2').addEventListener('click', exportComprehensivePdfReport);
      document.getElementById('exportReportXlsxBtn').addEventListener('click', exportComprehensiveExcelWorkbook);
      document.getElementById('reportExportXlsxBtn2').addEventListener('click', exportComprehensiveExcelWorkbook);

      // Report Filters, Sorting & Pagination Listeners
      ['reportSearchInput', 'reportFilterRulebook', 'reportFilterOutcome', 'reportFilterFormat', 'reportSortBySelect', 'reportPageSizeSelect'].forEach(function (id) {
        const el = document.getElementById(id);
        if (!el) return;
        const evName = id === 'reportSearchInput' ? 'input' : 'change';
        el.addEventListener(evName, function () {
          dashState.reportSearch = document.getElementById('reportSearchInput').value;
          dashState.reportRulebook = document.getElementById('reportFilterRulebook').value;
          dashState.reportOutcome = document.getElementById('reportFilterOutcome').value;
          dashState.reportFormat = document.getElementById('reportFilterFormat').value;
          dashState.reportSort = document.getElementById('reportSortBySelect').value;
          dashState.reportPageSize = Number(document.getElementById('reportPageSizeSelect').value) || 8;
          dashState.reportPage = 1;
          renderReportsTableAndPagination();
        });
      });

      document.getElementById('reportPageFirstBtn').addEventListener('click', function () {
        dashState.reportPage = 1;
        renderReportsTableAndPagination();
      });
      document.getElementById('reportPagePrevBtn').addEventListener('click', function () {
        dashState.reportPage = Math.max(1, dashState.reportPage - 1);
        renderReportsTableAndPagination();
      });
      document.getElementById('reportPageNextBtn').addEventListener('click', function () {
        const total = getFilteredSortedReportRecords().length;
        const maxP = Math.max(1, Math.ceil(total / (dashState.reportPageSize || 8)));
        dashState.reportPage = Math.min(maxP, dashState.reportPage + 1);
        renderReportsTableAndPagination();
      });
      document.getElementById('reportPageLastBtn').addEventListener('click', function () {
        const total = getFilteredSortedReportRecords().length;
        dashState.reportPage = Math.max(1, Math.ceil(total / (dashState.reportPageSize || 8)));
        renderReportsTableAndPagination();
      });

      // Achievements Explorer Filters
      ['achFilterCategory', 'achFilterStatus', 'achSearchInput'].forEach(function (id) {
        const el = document.getElementById(id);
        if (!el) return;
        const evName = id === 'achSearchInput' ? 'input' : 'change';
        el.addEventListener(evName, function () {
          dashState.achCategory = document.getElementById('achFilterCategory').value;
          dashState.achStatus = document.getElementById('achFilterStatus').value;
          dashState.achSearch = document.getElementById('achSearchInput').value;
          renderProgressionTab();
        });
      });

      // Quick Action Buttons in Overview, Vault & Super Admin
      function simulateAndRecordSampleMatch() {
        ensureCareerStatsSchema();
        const now = Date.now();
        const isSweep = Math.random() > 0.35;
        const kills = Math.floor(Math.random() * 4) + 2;
        const durMs = (Math.floor(Math.random() * 180) + 210) * 1000;
        const avgMv = Math.floor(Math.random() * 450) + 920;
        const avgTrn = Math.floor(Math.random() * 1200) + 3600;
        const turns = Math.floor(Math.random() * 12) + 22;
        const matchId = 'M-' + String(now).slice(-6);

        careerStats.matches += 1;
        careerStats.wins += 1;
        careerStats.kills += kills;
        careerStats.doubleSixes += 1;
        careerStats.sixesRolled += 8;
        careerStats.teamWins += 1;
        careerStats.bannu2DiceWins += 1;
        careerStats.closeGameWins += 1;
        if (isSweep) careerStats.cleanSweeps += 1;
        careerStats.hardAiWins += 1;
        careerStats.streak += 1;
        if (careerStats.streak > (careerStats.bestStreak || 0)) careerStats.bestStreak = careerStats.streak;
        careerStats.totalPlayTimeMs += durMs;
        careerStats.totalTurnTimeMs += turns * avgTrn;
        careerStats.totalTurnsCount += turns;
        careerStats.totalBeadMovesCount += 32;
        careerStats.totalMoveDecisionMs += 32 * (avgMv - 210);
        careerStats.totalMoveAnimMs += 32 * 210;
        careerStats.totalStepsMoved += 232;
        careerStats.totalSpawns += 4;
        careerStats.totalHomeCompleted += 4;
        careerStats.totalCloseLocks += 2;
        careerStats.fastMovesUnder1500ms += 18;
        careerStats.diceFaceCounts[6] = (careerStats.diceFaceCounts[6] || 0) + 8;
        careerStats.diceFaceCounts[5] = (careerStats.diceFaceCounts[5] || 0) + 6;
        careerStats.diceFaceCounts[4] = (careerStats.diceFaceCounts[4] || 0) + 5;

        const rec = {
          matchId: matchId,
          date: new Date(now).toISOString().slice(0, 10),
          timestamp: new Date(now).toISOString(),
          mode: 'بنوں روایتی رولز (Bannu Rules) (2D)',
          rulebookType: 'bannu',
          closeGameMode: true,
          format: '2v2 Teams',
          formatCode: '2v2',
          aiDifficulty: 'hard',
          result: isSweep ? 'Clean Sweep 🧹👑' : 'Won 🏆',
          won: true,
          isCleanSweep: isSweep,
          kills: kills,
          deaths: isSweep ? 0 : 1,
          closeLocks: 2,
          outerLoops: 1,
          spawns: 4,
          stepsMoved: 232,
          durationMs: durMs,
          totalTurns: turns,
          avgBeadMoveMs: avgMv,
          avgTurnTimeMs: avgTrn,
          playersSummary: [
            { seat: 0, name: careerStats.playerName, color: 'Red', active: true, kills: kills, deaths: isSweep ? 0 : 1, homeCompleted: 4, moves: 32, avgMoveMs: avgMv, turns: turns, avgTurnMs: avgTrn, totalTurnTimeMs: turns * avgTrn, stepsMoved: 232 },
            { seat: 1, name: 'Sher Khan AI', color: 'Green', active: true, kills: isSweep ? 0 : 1, deaths: 2, homeCompleted: isSweep ? 0 : 2, moves: 24, avgMoveMs: 1450, turns: turns - 1, avgTurnMs: 4300, totalTurnTimeMs: (turns - 1) * 4300, stepsMoved: 140 },
            { seat: 2, name: 'Wazir Partner', color: 'Yellow', active: true, kills: 1, deaths: 0, homeCompleted: 4, moves: 29, avgMoveMs: 1280, turns: turns, avgTurnMs: 3980, totalTurnTimeMs: turns * 3980, stepsMoved: 224 },
            { seat: 3, name: 'Marwat AI', color: 'Blue', active: true, kills: 0, deaths: 2, homeCompleted: isSweep ? 0 : 1, moves: 22, avgMoveMs: 1490, turns: turns - 1, avgTurnMs: 4410, totalTurnTimeMs: (turns - 1) * 4410, stepsMoved: 120 }
          ],
          moveLogs: [
            { matchId: matchId, moveNo: 32, actorIdx: 0, playerName: careerStats.playerName, colorName: 'Red', tokenId: 4, delta: 6, decisionMs: avgMv - 210, animMs: 210, totalMoveMs: avgMv, outcome: '🏠 Home Completed (+6)', ts: new Date(now).toLocaleTimeString() }
          ]
        };
        careerStats.matchRecords.unshift(rec);
        careerStats.history.unshift({
          matchId: rec.matchId,
          date: rec.date,
          mode: rec.mode,
          format: rec.format,
          result: rec.result,
          isCleanSweep: rec.isCleanSweep,
          kills: rec.kills,
          durationMs: rec.durationMs,
          avgBeadMoveMs: rec.avgBeadMoveMs,
          avgTurnTimeMs: rec.avgTurnTimeMs
        });
        careerStats.beadMoveLogs.unshift(rec.moveLogs[0]);
        pushActivityEvent(isSweep ? '🧹' : '🏆', 'Recorded Telemetry Match ' + matchId, rec.result + ' • ' + kills + ' Kills • Avg Move ' + (avgMv / 1000).toFixed(2) + 's', 'victory');
        saveCareerStats();
        showToast('⚡ Logged telemetry match ' + matchId + ' (' + rec.result + ')!', true);
      }

      document.getElementById('quickLogDemoMatchBtn').addEventListener('click', simulateAndRecordSampleMatch);
      document.getElementById('adminSeedSampleMatchBtn').addEventListener('click', simulateAndRecordSampleMatch);
      document.getElementById('quickJumpReportsBtn').addEventListener('click', function () {
        switchDashboardSubTab('reports');
      });
      document.getElementById('vaultViewAllBadgesBtn').addEventListener('click', function () {
        switchDashboardSubTab('progression');
      });
      document.getElementById('adminOpenRulesBtn').addEventListener('click', function () {
        syncRulesStudioControls();
        switchNavigationTab('viewRules');
      });
      document.getElementById('adminExportFullDbBtn').addEventListener('click', function () {
        document.getElementById('exportStatsBackupBtn').click();
      });
      document.getElementById('adminVerifyIntegrityBtn').addEventListener('click', function () {
        ensureCareerStatsSchema();
        renderStatsView();
        showToast('✅ System & Telemetry DB Integrity Audit Passed: 0 anomalies!', true);
      });

      window.addEventListener('load', function () {
        loadCareerStats();
        loadRulesPreferences();
        syncRulesStudioControls();
        initNewMatch('Ready on Home Lobby.', true);
        initLanRadarAndWebRtc();
        checkSavedMatchBanner();
        switchNavigationTab('viewHome');
      });
    })();
  </script>
<script src="./pwa-register.js" type="module"></script></body>
</html>