          { id: 'vt_3', cat: 'veteran', tier: 'Diamond', xp: 2000, icon: '🔥', title: 'Immortal 10-Win Streak', titleUr: 'لگاتار 10 فتوحات', desc: 'Reach a 10-match winning streak', cur: Math.max(s.streak || 0, s.bestStreak || 0), target: 10 },
          { id: 'vt_4', cat: 'veteran', tier: 'Silver', xp: 500, icon: '🏅', title: 'Seasoned Competitor (10 Matches)', titleUr: 'دس میچ مکمل', desc: 'Complete 10 full Ludo matches', cur: s.matches, target: 10 },
          { id: 'vt_5', cat: 'veteran', tier: 'Gold', xp: 1200, icon: '🏆', title: 'High Win-Rate Elite (60%+)', titleUr: 'شاندار جیت کی شرح', desc: 'Maintain 60%+ win rate across 5+ matches', cur: (s.matches >= 5 && winRate >= 60) ? 5 : Math.min(4, s.matches), target: 5 },
          { id: 'vt_6', cat: 'veteran', tier: 'Mythic', xp: 3500, icon: '👑', title: 'Rank 10+ Royale Noble', titleUr: 'رینک 10 چیمپئن', desc: 'Reach Official Pashtun Rank Tier 10 or higher', cur: xpInfo.currentRank.tier, target: 10 }
        ];

        return defs.map(function (d) {
          const curVal = Math.max(0, Number(d.cur) || 0);
          const unlocked = curVal >= d.target;
          const pct = Math.min(100, Math.round((curVal / Math.max(1, d.target)) * 100));
          return Object.assign({}, d, {
            cur: curVal,
            unlocked: unlocked,
            pct: pct
          });
        });
      }

      function computeModeMasteries() {
        ensureCareerStatsSchema();
        const s = careerStats;
        const rawModes = [
          { id: 'bannu', icon: '🏔️', name: 'Bannu 2-Dice Cultural Mastery', ur: 'بنوں دو گوٹی مہارت', pts: (s.bannu2DiceWins || 0) * 120 + (s.totalCloseLocks || 0) * 35 + (s.totalOuterLoops || 0) * 25 + (s.kills || 0) * 20, color: 'bg-amber-500' },
          { id: 'cleansweep', icon: '🧹', name: 'Clean Sweep Flawless Mastery', ur: 'کلین سویپ مہارت', pts: (s.cleanSweeps || 0) * 300 + (s.wins || 0) * 60, color: 'bg-indigo-600' },
          { id: 'team2v2', icon: '🤝', name: '2v2 Partnership & Assist Mastery', ur: '2v2 ٹیم پارٹنرشپ', pts: (s.teamWins || 0) * 140 + (s.totalPartnerAssists || 0) * 55, color: 'bg-emerald-600' },
          { id: 'combat', icon: '⚔️', name: 'Blood Gate Shikari Mastery', ur: 'شکاری جنگجو مہارت', pts: (s.kills || 0) * 50 + (s.hardAiWins || 0) * 110, color: 'bg-rose-600' },
          { id: 'yalla', icon: '🌐', name: 'Yalla Classic & 1v1/FFA Mastery', ur: 'کلاسک اور سولو مہارت', pts: (s.yallaClassicWins || 0) * 130 + (s.solo1v1Wins || 0) * 130 + (s.ffaWins || 0) * 130 + (s.openGameWins || 0) * 80, color: 'bg-sky-600' },
          { id: 'speed', icon: '⚡', name: 'Blitz Reflex & Timing Mastery', ur: 'تیز رفتار ٹائمنگ مہارت', pts: (s.fastMovesUnder1500ms || 0) * 25 + (s.totalBeadMovesCount || 0) * 8, color: 'bg-purple-600' }
        ];
        return rawModes.map(function (m) {
          const lvl = Math.min(50, Math.floor(m.pts / 250) + 1);
          const curFloor = (lvl - 1) * 250;
          const nextCeil = lvl * 250;
          const pct = Math.min(100, Math.max(6, Math.round(((m.pts - curFloor) / Math.max(1, nextCeil - curFloor)) * 100)));
          return Object.assign({}, m, { level: lvl, pct: pct, nextPts: nextCeil });
        });
      }

