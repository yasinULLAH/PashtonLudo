      function readRulesFormIntoConfig() {
        rulesConfig.bonusRollOnKill = document.getElementById('chkBonusOnKill').checked;
        const chkKeepLock = document.getElementById('chkKeepCaptureLockOnBonus');
        if (chkKeepLock) rulesConfig.keepCaptureLockOnBonusRoll = chkKeepLock.checked;
        rulesConfig.mandatoryYardSpawn = document.getElementById('chkMandatorySpawn').checked;
        rulesConfig.killRequiredForHome = document.getElementById('chkKillForHome').checked;
        const chkWipeout = document.getElementById('chkWipeoutResetsHomeEligibility');
        if (chkWipeout) rulesConfig.wipeoutResetsHomeEligibility = chkWipeout.checked;
        rulesConfig.allowOptionalLoopAfterKill = document.getElementById('chkOptionalLoopAfterKill').checked;
        rulesConfig.waitAllGroundAtGateBeforeLoop = document.getElementById('chkWaitAllGroundAtGate').checked;
        rulesConfig.bonusRollOnHome = document.getElementById('chkBonusOnHome').checked;
        rulesConfig.doubleSixBonusRoll = document.getElementById('chkDoubleSixBonus').checked;
        rulesConfig.safeStopImmunity = document.getElementById('chkSafeStopImmunity').checked;
        rulesConfig.teamMode = document.getElementById('chkTeamMode').checked;
        rulesConfig.strictHomeRemainder = document.getElementById('chkStrictRemainder').checked;
        rulesConfig.teamAssistRequiresSix = document.getElementById('chkTeamAssistSix').checked;
        rulesConfig.threeConsecutiveSixesPenalty = document.getElementById('chkThreeConsecutiveSixes').checked;
        rulesConfig.singleSixBonusInTwoDice = document.getElementById('chkSingleSixBonusTwoDice').checked;
        rulesConfig.stackRollBeforeMoving = document.getElementById('chkStackRollBeforeMoving').checked;
        rulesConfig.spawnOnOneAndSix = document.getElementById('chkSpawnOnOneAndSix').checked;
        rulesConfig.doubleSixSpawnsTwoBeads = document.getElementById('chkDoubleSixSpawnsTwo').checked;
        rulesConfig.firstBeadStartsOnBoard = document.getElementById('chkFirstBeadOnBoard').checked;
        rulesConfig.initialBeadsOnBoardCount = Math.max(1, Math.min(4, Number(document.getElementById('initialBeadsOnBoardSelect').value) || 1));
        rulesConfig.pairBlockadeRule = document.getElementById('chkPairBlockadeRule').checked;
        rulesConfig.killAllStackedEnemies = document.getElementById('chkKillAllStackedEnemies').checked;
        rulesConfig.twoKillsForHome = document.getElementById('chkTwoKillsForHome').checked;
        rulesConfig.oneDieWhenOneBeadLeft = document.getElementById('chkOneDieWhenOneBeadLeft').checked;
        rulesConfig.mandatoryCapture = document.getElementById('chkMandatoryCapture').checked;
        rulesConfig.threeTimeoutsBotTakeover = document.getElementById('chkThreeTimeoutsBotTakeover').checked;
        rulesConfig.multiMouseLock = document.getElementById('chkMultiMouseLock').checked;
        setAutoRollPreference(document.getElementById('chkAutoRollTurn').checked);
        setShowTooltipsPreference(document.getElementById('chkShowTooltips').checked);
        rulesConfig.aiDifficulty = document.getElementById('aiDifficultySelect').value;
        const speedSel = document.getElementById('aiSpeedSelect');
        if (speedSel) rulesConfig.aiSpeed = speedSel.value;
        const customSpeedInp = document.getElementById('rulesCustomAiSpeedInput');
        if (rulesConfig.aiSpeed === 'custom' && customSpeedInp) {
          rulesConfig.aiCustomSpeedSec = Math.max(0.2, Math.min(10, parseFloat(customSpeedInp.value) || 1.5));
        }
        const rulesTimerVal = document.getElementById('turnTimerSelect').value;
        rulesConfig.turnTimeSeconds = rulesTimerVal === 'custom'
          ? Math.max(5, parseInt(document.getElementById('rulesCustomTimerInput').value, 10) || 45)
          : Number(rulesTimerVal);

        for (let i = 0; i < 4; i++) {
          const nameVal = document.getElementById('setupName' + i).value.trim() || ('Player ' + (i + 1));
          const typeVal = document.getElementById('setupType' + i).value;
          seatConfig[i].name = nameVal;
          seatConfig[i].type = typeVal === 'none' ? 'ai' : typeVal;
          seatConfig[i].active = typeVal !== 'none';
          seatConfig[i].isBotTakeover = false;
        }
        saveRulesPreferences(true);
      }

      document.getElementById('resetDefaultRulesBtn').addEventListener('click', function () {
        const keepAuto = rulesConfig.autoRollOnTurn;
        const keepTips = rulesConfig.showTooltips;
        const keepSpeed = rulesConfig.aiSpeed;
        const keepCustom = rulesConfig.aiCustomSpeedSec;
        rulesConfig = Object.assign({}, DEFAULT_RULES_CONFIG, {
          autoRollOnTurn: keepAuto,
          showTooltips: keepTips,
          aiSpeed: keepSpeed,
          aiCustomSpeedSec: keepCustom
        });
        saveRulesPreferences(true);
        syncRulesStudioControls();
        showToast('🔄 Restored Default Bannu Rules & saved preferences!', true);
      });

      document.getElementById('syncRulesToPeersBtn').addEventListener('click', function () {
